// ---- dual theme ------------------------------------------------------------
// Every palette binding is a plain `let` and every widget mints inside fns
// that repaint() re-runs, so identifiers resolve at RE-MINT time. Switching
// the theme is just reassigning the bindings and repainting the three
// persistent roots (ground, chrome, body).
let themeLight = false       // boot in deep-space dark

fn apply_theme(l){
    themeLight = l
    space     = pick(l, #xf3f1e6, #x161c1a)
    panel     = pick(l, #xfaf8ef, #x1d2622)
    panel2    = pick(l, #xefede0, #x222c27)
    glass     = pick(l, #xf7f5ec, #x1a211e)
    line      = pick(l, #xdeddd2, #x292e2c)
    line2     = pick(l, #xc0c1b8, #x454945)
    ink       = pick(l, #x1f2926, #xebe9de)
    ink66     = pick(l, #x747973, #x92938c)
    ink55     = pick(l, #x898d86, #x7a7c76)
    ink45     = pick(l, #x9a9d95, #x6b6e68)
    ink38     = pick(l, #xa3a59d, #x636661)
    ink32     = pick(l, #xb3b5ac, #x565955)
    violet    = pick(l, #x2f5d43, #x8fcb9b)
    accB      = pick(l, #x3e7355, #x6fb585)
    violetT   = pick(l, #x2f5d43, #xa8dbb2)
    violetBg  = pick(l, #xdfe2d6, #x25312a)
    violetBgHv = pick(l, #xd4d9cc, #x2e3f34)
    violetBd  = pick(l, #xb0bfaf, #x445f4b)
    violetHi  = pick(l, #x2f5d43, #xa8dbb2)
    cyan      = pick(l, #x0f5a52, #x5ec4b6)
    cyanT     = pick(l, #x0c4f4a, #x8adccf)
    cyanBg    = pick(l, #xdce2d7, #x1f302d)
    cyanBd    = pick(l, #xaac1b7, #x305952)
    mint      = pick(l, #x2f7d4f, #x7fcf96)
    mintT     = pick(l, #x276a43, #x9adcaa)
    mintBg    = pick(l, #xdbe3d4, #x233129)
    mintBd    = pick(l, #xb0cab3, #x3c5c47)
    amber     = pick(l, #xb06f1f, #xe0a458)
    amberT    = pick(l, #x96601b, #xeab873)
    amberBg   = pick(l, #xece4d2, #x2e2c22)
    amberBd   = pick(l, #xdcc5a2, #x635032)
    red       = pick(l, #xbe4b38, #xe0785f)
    redT      = pick(l, #xa03d2c, #xea927b)
    redBg     = pick(l, #xeee0d5, #x2e2722)
    redBd     = pick(l, #xe0b5a7, #x674136)
    white7    = pick(l, #xe6e3d4, #x28332e)
    inkHi     = pick(l, #x1f2926, #xebe9de)
    inkBody   = pick(l, #x49514c, #xc0c0b7)
    violet2   = pick(l, #x9a9d95, #x6b6e68)
    badgeInk  = pick(l, #xf3f1e6, #x14201a)
    inputBg   = pick(l, #xefede0, #x222c27)
    railPill   = pick(l, #xdfe2d6, #x25312a)
    railPillBd = pick(l, #xb0bfaf, #x445f4b)
    railTile   = pick(l, #xe6e3d4, #x28332e)
    railDiv    = pick(l, #xdeddd2, #x292e2c)
    sepC      = pick(l, #xdeddd2, #x292e2c)
    glowA     = pick(l, #xdbdfd2, #x212c26)
    glowB     = pick(l, #xece4d2, #x22241e)
    glowC     = pick(l, #xdce2d7, #x1b2825)
    accInk    = pick(l, #xf3f1e6, #x14201a)
}
fn toggle_theme(){
    apply_theme(!themeLight)
    repaint()
}
// Repaint every persistent root: ground (page bg + glow), chrome (rail +
// separator) and body (screens). Re-driving chrome is what moves the rail's
// active pill — minting rail() once at load left it frozen on the boot tab.
fn repaint(){
    ui.railc.render()
    ui.barc.render()
    ui.body.render()
}

// ---- helpers --------------------------------------------------------------
fn pick(c, a, b){ if c { return a } return b }
fn first_line(s){ let ls = s.split("\n") return ls[0] }
fn domain_of(a){
    let parts = a.split("@")
    if parts.len() > 1 { return parts[1] }
    return a
}
// tone -> chip colors (label chips everywhere read these)
fn chip_fg(tone){
    if tone == "violet" { return violetT }
    if tone == "cyan" { return cyanT }
    if tone == "amber" { return amberT }
    if tone == "red" { return redT }
    return mintT
}
fn chip_bg(tone){
    if tone == "violet" { return violetBg }
    if tone == "cyan" { return cyanBg }
    if tone == "amber" { return amberBg }
    if tone == "red" { return redBg }
    return mintBg
}
// priority -> score color (>=85 red, >=65 amber, >=45 cyan, else violet-2)
fn pri_color(p){
    if p >= 85 { return red }
    if p >= 65 { return amber }
    if p >= 45 { return cyan }
    return violet2
}
fn pri_w(p){
    if p >= 95 { return 34 }
    if p >= 85 { return 31 }
    if p >= 65 { return 24 }
    if p >= 45 { return 17 }
    if p >= 25 { return 10 }
    return 5
}
fn has_label(m, t){
    for l in m.labels { if l.text == t { return true } }
    return false
}
fn pass_filter(i){
    if filter == "urgent" { return mails[i].priority >= 85 }
    if filter == "reply" { return has_label(mails[i], "需回复") }
    if filter == "later" {
        if mails[i].priority >= 85 { return false }
        if has_label(mails[i], "需回复") { return false }
        return true
    }
    return true
}
fn cnt(kind){
    let n = 0
    for i in mails.len() {
        if kind == "all" { n = n + 1 }
        if kind == "urgent" { if mails[i].priority >= 85 { n = n + 1 } }
        if kind == "reply" { if has_label(mails[i], "需回复") { n = n + 1 } }
        if kind == "later" {
            if mails[i].priority < 85 {
                if !has_label(mails[i], "需回复") { n = n + 1 }
            }
        }
    }
    return n
}

// ---- mail data layer (official host service) -----------------------------
// MARKER:ADAPTER — the dev overlay (scripts/dev_bundle.py) replaces the block
// between the two MARKER lines with dev/adapter-bridge.splash; both expose
// the same function set. Three honest states: no service answers (card-host,
// practice data), no account yet (the host's own sheet adds one), or live
// mail through the platform's mail service — where real IMAP/SMTP happens;
// the app itself never holds credentials.
let mail_src = "practice"      // practice | live  — where the list came from
let mail_link = "checking"     // checking | no_service | no_account | error | live
let link_error = ""
let account_id = ""
let account_addr = ""
let live_total = 0

fn mail_check(){
    if !host.has("mail") {
        mail_link = "no_service"
        link_error = "此环境未提供邮件服务(card-host)"
        repaint()
        return
    }
    host.request("mail.accounts", {}, fn(r){
        if !r.is_ok {
            mail_link = "no_service"
            link_error = r.error
            repaint()
            return
        }
        if r.data.len() == 0 {
            mail_link = "no_account"
            repaint()
            return
        }
        account_id = r.data[0].id
        account_addr = r.data[0].address
        mail_link = "live"
        mail_load()
    })
}
fn mail_add_account(){
    // the service raises its own sign-in sheet; passwords never reach the app
    host.request("mail.add_account", {}, fn(r){
        if r.is_ok { mail_check() return }
        link_error = r.error
        repaint()
    })
}
fn live_mail(m){
    return {src: "live" id: m.id init: "✉" sender: m.sender address: m.address
            subject: m.subject snippet: m.preview body: m.body
            time: m.time unread: m.unread priority: 50 cluster: "工作"
            av1: #x3e7355 av2: #x1f3a2a
            labels: [{text: domain_of(m.address) tone: "cyan"}]
            summary: [] actions: []
            sent_label: "" sent_tone: "mint" sent_note: ""
            replies: [] meeting_title: "" meeting_time: "" meeting_loc: ""
            generating: false
            reply: "" reply_text: "" send_error: ""
            summary_src: "practice" ai_points: [] ai_action: ""}
}
fn mail_load(){
    host.request("mail.list", {account: account_id limit: 20}, fn(r){
        if !r.is_ok {
            mail_link = "error"
            link_error = r.error
            repaint()
            return
        }
        let out = []
        for i in r.data.messages.len() {
            out.push(live_mail(r.data.messages[i]))
        }
        mails = out
        mail_src = "live"
        live_total = r.data.total
        current = 0
        repaint()
    })
}
fn mail_open_message(i){
    // the list carries previews; the full body comes with the message itself
    host.request("mail.message", {account: account_id message: mails[i].id}, fn(r){
        if r.is_ok {
            mails[i].body = r.data.body
            repaint()
        }
    })
}
fn mail_mark_read(i){
    host.request("mail.mark_read", {account: account_id message: mails[i].id}, fn(r){ })
}
fn mail_send_live(i){
    let m = mails[i]
    host.request("mail.send", {account: account_id to: m.address
                               subject: "回复:" + m.subject body: m.reply_text}, fn(r){
        if r.is_ok && r.data.accepted == true {
            mails[i].reply = "sent"
        } else {
            mails[i].reply = "failed"
            if !r.is_ok { mails[i].send_error = r.error } else { mails[i].send_error = "服务未接受" }
        }
        repaint()
    })
}
// MARKER:ADAPTER-END

// ---- navigation -----------------------------------------------------------
// ui is injected only after the body evaluates, so the first frame draws an
// empty body; a boot timeout re-renders it once ui exists (README pattern).
fn boot(){ repaint(); mail_check() }
start_timeout(0.05, || boot())

fn go(s){ screen = s; repaint() }
fn open_mail(i){
    // desktop master-detail: selecting a mail fills the reader pane in place
    current = i
    selected = true
    repaint()
    if mails[i].src == "live" {
        mail_open_message(i)
        mail_mark_read(i)
    }
}
fn set_filter(f){ filter = f; repaint() }

// ---- reply lifecycle: draft -> confirm -> sending -> sent / failed --------
// ---- AI generation via the host's one-shot model service ------------------
// One-shot, schema-checked model.complete (OctoSense#95, merged 2026-09-28):
// the host picks the model from the person's own AI providers; the app never
// sees providers or keys. In card-host nothing answers "model" — the UI says
// so and keeps the local practice content.
fn summary_pill_text(src){
    if src == "asking" { return "生成中…" }
    if src == "ai" { return "模型生成" }
    if src == "unavailable" { return "服务不可用" }
    return "练习数据"
}
fn gen_summary(i){
    let m = mails[i]
    mails[i].summary_src = "asking"
    summary_error = ""
    repaint()
    host.request("model.complete", {
        task: "阅读这封中文邮件,给出最多3条要点,简洁客观,不编造原文没有的事实。"
        input: {subject: m.subject sender: m.sender body: m.body}
        schema: {type: "object" required: ["points"] additionalProperties: false
                 properties: {points: {type: "array" maxItems: 3 items: {type: "string" maxLength: 60}}}}
        class: "fast"
    }, fn(r){
        if !r.is_ok {
            mails[i].summary_src = "unavailable"
            summary_error = r.error
            repaint()
            return
        }
        mails[i].ai_points = r.data.output.points
        mails[i].summary_src = "ai"
        repaint()
    })
}

fn open_reply(){ compose_mode = "reply"; go("write") }
fn open_forward(){ compose_mode = "forward"; go("write") }
fn edit_draft(i){ draft_text = mails[i].reply_text; go("write") }
fn ask_send(i){ mails[i].reply = "confirm"; repaint() }
fn cancel_send(i){ mails[i].reply = "pending"; repaint() }
fn do_send(i){
    mails[i].reply = "sending"
    repaint()
    if mails[i].src == "live" { mail_send_live(i) return }
    let idx = i
    start_timeout(0.9, || finish_send(idx))
}
fn finish_send(i){
    if simulate_outage { mails[i].reply = "failed" } else { mails[i].reply = "sent" }
    repaint()
}
fn retry_send(i){ do_send(i) }
fn keep_draft(i){ mails[i].reply = "pending"; repaint() }
fn toggle_outage(){ simulate_outage = !simulate_outage; repaint() }
fn compose_target(){
    let m = mails[current]
    if compose_mode == "forward" { return "转发给: " + m.sender }
    return "回复给: " + m.sender
}
// The practice subjects already carry "Re: " — never stack a second prefix
// (no string slicing in this language, so a reply quotes the subject as-is
// and only a forward gets a prefix).
fn compose_subject(){
    let m = mails[current]
    if compose_mode == "forward" { return "转发: " + m.subject }
    return m.subject
}
// A smart-reply chip attaches a one-tap draft to the mail; it still goes
// through the same pending -> confirm -> send lifecycle, never sending itself.
fn quick_reply(i, q){
    let m = mails[i]
    draft_text = "你好:\n\n关于「" + m.subject + "」:" + q + "。\n\n(智能回复草稿,可编辑后发送)"
    mails[i].reply_text = draft_text
    mails[i].reply = "pending"
    repaint()
}

// ---- shared bits (forest-ink × warm-paper redesign) ------------------------
// Reference: UI设计/app (Sidebar/Chrome/InboxList/ReadingPane/ComposeView/
// AgentsView/bits). Native widgets only — runtime SVG rasterises blank here,
// so lucide icons become single CJK glyphs / proven dingbats (✦ ✓ ✕ ★ ↻ →).
// Palette var names are historical (violet:=accent forest green, cyan:=teal,
// mint:=ok green) — the values are rebind per theme in apply_theme.

fn chip_ln(tone){
    if tone == "violet" { return violetBd }
    if tone == "cyan" { return cyanBd }
    if tone == "amber" { return amberBd }
    if tone == "red" { return redBd }
    return mintBd
}
fn chip(text, tone){
    RoundedView{width: Fit height: Fit padding: Inset{top: 2 bottom: 2 left: 6 right: 6}
        draw_bg +: {color: chip_bg(tone) border_radius: 6.0 border_size: 1.0 border_color: chip_ln(tone)}
        Label{text: text draw_text.color: chip_fg(tone) draw_text.text_style.font_size: 10}}
}
fn label_row(m){
    View{width: Fill height: Fit flow: Right spacing: 5
        for l in m.labels { chip(l.text, l.tone) }
    }
}
// AI priority meter: fixed 62px footprint — the row's right edge anchor
fn priority_meter(m){
    View{width: 62 height: Fit flow: Right spacing: 5 align: Align{y: 0.5}
        RoundedView{width: 36 height: 3 draw_bg +: {color: white7 border_radius: 2.0} flow: Overlay
            RoundedView{width: pri_w(m.priority) height: 3 draw_bg +: {color: pri_color(m.priority) border_radius: 2.0}}
        }
        Label{text: "" + m.priority draw_text.color: pri_color(m.priority) draw_text.text_style.font_size: 9}
    }
}
fn avatar_color(i){
    if i == 0 { return #x3e7355 }
    if i == 1 { return #x0f5a52 }
    if i == 2 { return #xbe4b38 }
    if i == 3 { return #x488b5f }
    if i == 4 { return #x7a6c3f }
    if i == 5 { return #xb06f1f }
    if i == 6 { return #xb06f1f }
    if i == 7 { return #x488b5f }
    return #x3e7355
}
fn avatar(i, size, unread){
    RoundedView{width: size height: size draw_bg +: {color: avatar_color(i) border_radius: size / 2.0} flow: Overlay align: Align{x: 0.5 y: 0.5}
        Label{text: mails[i].init draw_text.color: #xf3f1e6 draw_text.text_style: theme.font_bold{font_size: size * 0.4}}
        if unread {
            View{width: Fill height: Fill align: Align{x: 1.0 y: 0.0}
                RoundedView{width: 9 height: 9 draw_bg +: {color: violet border_radius: 5.0}}
            }
        }
    }
}
// Reply state outranks the static labels: once a draft exists every surface
// shows the live pill instead of the stale triage tags.
fn state_pill(m){
    if m.reply == "sent" {
        RoundedView{width: Fit height: Fit padding: Inset{top: 2 bottom: 2 left: 6 right: 6}
            draw_bg +: {color: mintBg border_radius: 6.0 border_size: 1.0 border_color: mintBd}
            Label{text: "已回复" draw_text.color: mintT draw_text.text_style.font_size: 9}}
    } else {
        if m.reply == "pending" {
            RoundedView{width: Fit height: Fit padding: Inset{top: 2 bottom: 2 left: 6 right: 6}
                draw_bg +: {color: violetBg border_radius: 6.0 border_size: 1.0 border_color: violetBd}
                Label{text: "待发送" draw_text.color: violetT draw_text.text_style.font_size: 9}}
        } else {
            if m.reply == "failed" {
                RoundedView{width: Fit height: Fit padding: Inset{top: 2 bottom: 2 left: 6 right: 6}
                    draw_bg +: {color: redBg border_radius: 6.0 border_size: 1.0 border_color: redBd}
                    Label{text: "发送失败" draw_text.color: redT draw_text.text_style.font_size: 9}}
            } else {
                RoundedView{width: 0 height: 0}
            }
        }
    }
}
// VibeMark: acc->teal rounded square, V + the amber dot
fn vibe_mark(size){
    View{width: size height: size flow: Overlay
        RoundedView{width: size height: size draw_bg +: {color: violet border_radius: size * 0.32} align: Align{x: 0.5 y: 0.5}
            Label{text: "V" draw_text.color: accInk draw_text.text_style: theme.font_bold{font_size: size * 0.52}}}
        View{width: size height: size align: Align{x: 1.0 y: 0.0}
            View{width: 12 height: 12 align: Align{x: 0.5 y: 0.5}
                RoundedView{width: 6 height: 6 draw_bg +: {color: amber border_radius: 3.0}}}
        }
    }
}
fn live_dot(){
    RoundedView{width: 6 height: 6 draw_bg +: {color: mint border_radius: 3.0}}
}
fn agent_pill(){
    RoundedView{width: Fit height: Fit padding: Inset{top: 5 bottom: 5 left: 11 right: 11}
        draw_bg +: {color: mintBg border_radius: 14.0 border_size: 1.0 border_color: mintBd}
        View{width: Fit height: Fit flow: Right spacing: 7 align: Align{y: 0.5}
            live_dot()
            Label{text: "VIBE AGENT · 运行中" draw_text.color: mint draw_text.text_style.font_size: 10}
        }
    }
}
// Sliding pill: light -> knob left (sun 日), dark -> knob right (moon 月)
fn theme_toggle(){
    GestureView{width: 58 height: 30 on_tap: |x, y| toggle_theme()
        RoundedView{width: 58 height: 30 draw_bg +: {color: white7 border_radius: 15.0 border_size: 1.0 border_color: line2} flow: Overlay
            View{width: 58 height: 30 align: pick(themeLight, Align{x: 0.0 y: 0.5}, Align{x: 1.0 y: 0.5})
                View{width: 27 height: 30 align: Align{x: 0.5 y: 0.5}
                    RoundedView{width: 24 height: 24 draw_bg +: {color: violet border_radius: 12.0} align: Align{x: 0.5 y: 0.5}
                        Label{text: pick(themeLight, "日", "月") draw_text.color: accInk draw_text.text_style.font_size: 11}}
                }
            }
        }
    }
}
fn section_label(text){
    View{width: Fill height: Fit flow: Right padding: Inset{left: 4 bottom: 2}
        Label{text: text draw_text.color: ink45 draw_text.text_style.font_size: 9}}
}
// gradient action button (acc -> acc-b) — inlined at call sites for closures
fn kbd_box(text){
    RoundedView{width: Fit height: Fit padding: Inset{top: 2 bottom: 2 left: 6 right: 6}
        draw_bg +: {color: white7 border_radius: 5.0}
        Label{text: text draw_text.color: ink45 draw_text.text_style.font_size: 9}}
}

// ---- sidebar ----------------------------------------------------------------
fn nav_row(label, glyph, target, badge){
    let act = screen == target
    GestureView{width: Fill height: 38 on_tap: |x, y| go(target)
        RoundedView{width: Fill height: 38
            draw_bg +: {color: pick(act, violetBg, #x00000000) border_radius: 9.0 border_size: 1.0 border_color: pick(act, violetBd, #x00000000)}
            View{width: Fill height: Fill flow: Right spacing: 10 align: Align{y: 0.5} padding: Inset{left: 10 right: 10}
                Label{text: glyph draw_text.color: pick(act, violet, ink45) draw_text.text_style.font_size: 13}
                Label{width: Fill text: label draw_text.color: pick(act, ink, ink66) draw_text.text_style.font_size: 12}
                if badge != "" {
                    RoundedView{width: Fit height: Fit padding: Inset{top: 1 bottom: 1 left: 7 right: 7}
                        draw_bg +: {color: pick(act, violet, violetBg) border_radius: 9.0}
                        Label{text: badge draw_text.color: pick(act, accInk, violetT) draw_text.text_style.font_size: 9}}
                }
            }
        }
    }
}
fn folder_row(glyph, label, count){
    View{width: Fill height: 32 flow: Right spacing: 10 align: Align{y: 0.5} padding: Inset{left: 10 right: 10}
        Label{text: glyph draw_text.color: ink45 draw_text.text_style.font_size: 12}
        Label{width: Fill text: label draw_text.color: ink66 draw_text.text_style.font_size: 12}
        if count != "" {
            Label{text: count draw_text.color: ink45 draw_text.text_style.font_size: 9}
        }
    }
}
fn cluster_color(k){
    if k == "teal" { return cyan }
    if k == "ok" { return mint }
    if k == "amber" { return amber }
    return violet
}
fn cluster_row(label, count, key){
    View{width: Fill height: 32 flow: Right spacing: 10 align: Align{y: 0.5} padding: Inset{left: 10 right: 10}
        RoundedView{width: 7 height: 7 draw_bg +: {color: cluster_color(key) border_radius: 4.0}}
        Label{width: Fill text: label draw_text.color: ink66 draw_text.text_style.font_size: 12}
        Label{text: count draw_text.color: ink45 draw_text.text_style.font_size: 9}
    }
}
fn sidebar(){
    RoundedView{width: 264 height: Fill flow: Down draw_bg +: {color: panel border_radius: 0.0}
        View{width: Fill height: 58 flow: Right spacing: 10 align: Align{y: 0.5} padding: Inset{left: 16 right: 16}
            vibe_mark(30)
            View{width: Fill height: Fit flow: Down spacing: 2
                Label{text: "VibeMail" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 14}}
                Label{text: "AGENTIC MAIL" draw_text.color: ink45 draw_text.text_style.font_size: 8}
            }
        }
        RoundedView{width: Fill height: 1 draw_bg +: {color: line border_radius: 0.0}}
        View{width: Fill height: Fill flow: Down padding: Inset{top: 12 bottom: 10 left: 12 right: 12}
            // 写信 · AI 起草 — the gradient compose button
            GestureView{width: Fill height: 40 on_tap: |x, y| go("write")
                RoundedView{width: Fill height: 40 draw_bg +: {color: violet border_radius: 10.0}
                    View{width: Fill height: Fill flow: Right spacing: 9 align: Align{y: 0.5} padding: Inset{left: 12 right: 10}
                        Label{text: "✦" draw_text.color: accInk draw_text.text_style.font_size: 13}
                        Label{width: Fill text: "写信 · AI 起草" draw_text.color: accInk draw_text.text_style: theme.font_bold{font_size: 12}}
                        RoundedView{width: Fit height: Fit padding: Inset{top: 2 bottom: 2 left: 6 right: 6}
                            draw_bg +: {color: accB border_radius: 5.0}
                            Label{text: "N" draw_text.color: accInk draw_text.text_style.font_size: 9}}
                    }
                }
            }
            View{width: 1 height: 10}
            nav_row("收件箱", "✉", "inbox", "" + cnt("all"))
            nav_row("Agent 小队", "✦", "agents", "" + agents.len())
            View{width: 1 height: 14}
            section_label("邮箱")
            folder_row("★", "已加星标", "3")
            folder_row("◑", "稍后处理", "5")
            folder_row("→", "已发送", "")
            folder_row("✎", "草稿", "2")
            folder_row("▤", "归档", "")
            folder_row("✕", "垃圾箱", "")
            View{width: 1 height: 14}
            section_label("AI 智能分类")
            cluster_row("工作", "8", "acc")
            cluster_row("财务", "3", "teal")
            cluster_row("订阅", "14", "ok")
            cluster_row("社交", "5", "amber")
        }
        // agent mini card
        View{width: Fill height: Fit flow: Down padding: Inset{left: 12 right: 12 bottom: 10}
            RoundedView{width: Fill height: Fit padding: Inset{top: 12 bottom: 12 left: 13 right: 13}
                draw_bg +: {color: panel2 border_radius: 12.0 border_size: 1.0 border_color: line} flow: Down spacing: 8
                View{width: Fill height: Fit flow: Right spacing: 7 align: Align{y: 0.5}
                    live_dot()
                    Label{text: "AGENT ACTIVE" draw_text.color: mint draw_text.text_style.font_size: 9}
                }
                Label{width: Fill text: "今日已自动处理 23 封邮件,节省 1.4h" draw_text.color: ink66 draw_text.text_style.font_size: 11}
                RoundedView{width: Fill height: 3 draw_bg +: {color: line border_radius: 2.0} flow: Overlay
                    RoundedView{width: 145 height: 3 draw_bg +: {color: violet border_radius: 2.0}}
                }
            }
        }
        RoundedView{width: Fill height: 1 draw_bg +: {color: line border_radius: 0.0}}
        View{width: Fill height: 50 flow: Right spacing: 4 align: Align{y: 0.5} padding: Inset{left: 16 right: 16}
            RoundedView{width: 30 height: 30 draw_bg +: {color: #x00000000 border_radius: 8.0} align: Align{x: 0.5 y: 0.5}
                Label{text: "历" draw_text.color: ink45 draw_text.text_style.font_size: 13}}
            RoundedView{width: 30 height: 30 draw_bg +: {color: #x00000000 border_radius: 8.0} align: Align{x: 0.5 y: 0.5}
                Label{text: "设" draw_text.color: ink45 draw_text.text_style.font_size: 13}}
            View{width: Fill height: 1}
            RoundedView{width: 28 height: 28 draw_bg +: {color: #xb06f1f border_radius: 14.0} align: Align{x: 0.5 y: 0.5}
                Label{text: "我" draw_text.color: #xf3f1e6 draw_text.text_style: theme.font_bold{font_size: 11}}}
        }
    }
}

// ---- top bar ----------------------------------------------------------------
fn title_zh(){
    if screen == "write" { return "AI 写信" }
    if screen == "agents" { return "Agent 小队" }
    return "智能收件箱"
}
fn title_en(){
    if screen == "write" { return "AI COMPOSE" }
    if screen == "agents" { return "AGENT SQUAD" }
    return "SMART INBOX"
}
fn top_bar(){
    RoundedView{width: Fill height: 58 flow: Right spacing: 12 align: Align{y: 0.5} padding: Inset{left: 20 right: 16} draw_bg +: {color: glass border_radius: 0.0}
        Label{text: title_zh() draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
        Label{text: title_en() draw_text.color: ink45 draw_text.text_style.font_size: 9}
        View{width: Fill height: 1}
        RoundedView{width: 380 height: 36 draw_bg +: {color: panel border_radius: 10.0 border_size: 1.0 border_color: line}
            View{width: Fill height: Fill flow: Right spacing: 8 align: Align{y: 0.5} padding: Inset{left: 12 right: 8}
                Label{text: "✦" draw_text.color: ink45 draw_text.text_style.font_size: 11}
                Label{width: Fill text: "问 Vibe Agent:「上周报价相关邮件」" draw_text.color: ink55 draw_text.text_style.font_size: 11}
                kbd_box("Ctrl K")
            }
        }
        View{width: Fill height: 1}
        agent_pill()
        theme_toggle()
    }
}

// ---- inbox: list | reader | AI copilot --------------------------------------
fn banner_line(){
    if mail_link == "checking" { return "正在连接邮件服务…" }
    if mail_link == "live" { return "已连接 " + account_addr + " · " + live_total + " 封真实邮件" }
    if mail_link == "no_account" { return "未添加邮箱账号 · 点右侧按钮,由宿主登录面板添加" }
    if mail_link == "error" { return "邮箱连接失败:" + link_error }
    return "邮件服务不可用 · 当前为练习数据"
}
fn filter_chip(key, label, count){
    ButtonFlat{height: 30 padding: Inset{left: 10 right: 10} text: label + " " + count on_click: || set_filter(key)
        draw_bg +: {color: pick(filter == key, violetBg, #x00000000) color_hover: white7 color_down: white7
                    border_radius: 8.0 border_size: 1.0 border_color: pick(filter == key, violetBd, line2)}
        draw_text +: {color: pick(filter == key, violetT, ink66)}}
}
fn mail_row(i){
    let m = mails[i]
    let sel = selected && i == current
    GestureView{width: Fill height: Fit on_tap: |x, y| open_mail(i)
        View{width: Fill height: Fit flow: Overlay
            RoundedView{width: Fill height: Fit flow: Down padding: Inset{top: 12 bottom: 12 left: 18 right: 18} spacing: 4
                draw_bg +: {color: pick(sel, violetBg, #x00000000) border_radius: 0.0}
                View{width: Fill height: Fit flow: Right spacing: 11
                    avatar(i, 38, m.unread)
                    View{width: Fill height: Fit flow: Down spacing: 4
                        View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                            Label{width: Fill text: m.sender
                                  draw_text.color: pick(m.unread, ink, ink66)
                                  draw_text.text_style: theme.font_bold{font_size: 12}}
                            Label{width: 40 text: m.time draw_text.color: ink45 draw_text.text_style.font_size: 9}
                        }
                        Label{width: Fill text: m.subject draw_text.color: pick(m.unread, inkHi, ink66) draw_text.text_style.font_size: 12}
                        Label{width: Fill text: m.snippet draw_text.color: ink45 draw_text.text_style.font_size: 10}
                        View{width: Fill height: Fit flow: Right spacing: 5 align: Align{y: 0.5}
                    if m.generating {
                        RoundedView{width: Fit height: Fit padding: Inset{top: 2 bottom: 2 left: 6 right: 6}
                            draw_bg +: {color: violetBg border_radius: 6.0 border_size: 1.0 border_color: violetBd}
                            Label{text: "✦ AI 摘要生成中…" draw_text.color: violetT draw_text.text_style.font_size: 9}}
                    } else {
                        if m.labels.len() > 0 { chip(m.labels[0].text, m.labels[0].tone) }
                        if m.labels.len() > 1 { chip(m.labels[1].text, m.labels[1].tone) }
                    }
                        state_pill(m)
                        View{width: Fill height: 1}
                        priority_meter(m)
                    }
                }
            }
        }
            if sel {
                View{width: Fill height: Fill align: Align{x: 0.0 y: 0.0}
                    View{width: 2 height: Fill align: Align{x: 0.0 y: 0.5}
                        RoundedView{width: 2 height: Fill draw_bg +: {color: violet border_radius: 1.0}}}
                }
            }
        }
    }
}
fn preview_pane(){
    View{width: Fill height: Fit flow: Down padding: Inset{top: 48 bottom: 20 left: 24 right: 24}
        RoundedView{width: Fill height: Fit padding: Inset{top: 52 bottom: 52 left: 34 right: 34}
            draw_bg +: {color: panel border_radius: 16.0 border_size: 1.0 border_color: line}
            flow: Down spacing: 13 align: Align{x: 0.5}
            RoundedView{width: 56 height: 56 draw_bg +: {color: violet border_radius: 18.0} align: Align{x: 0.5 y: 0.5}
                Label{text: "✦" draw_text.color: accInk draw_text.text_style.font_size: 22}}
            Label{text: "选择一封邮件开始阅读" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 14}}
            Label{width: Fill text: "Vibe Agent 已为 " + cnt("all") + " 封邮件生成摘要、优先级与建议动作。点击左侧任意邮件,AI 摘要、待办提取与智能回复会出现在右侧 Copilot 栏。" draw_text.color: ink45 draw_text.text_style.font_size: 11 align: Align{x: 0.5}}
        }
    }
}
fn inbox_screen(){
    // Three independently-scrolling panes on a fixed viewport. Column
    // backgrounds are Overlay underlays so no black shows below shorter
    // content when a pane scrolls.
    View{width: Fill height: Fill flow: Right
        View{width: 360 height: Fill flow: Overlay
            RoundedView{width: Fill height: Fill draw_bg +: {color: panel border_radius: 0.0}}
            ScrollYView{width: Fill height: Fill flow: Down
            View{width: Fill height: Fit flow: Down spacing: 10 padding: Inset{top: 14 bottom: 10 left: 18 right: 18}
                View{width: Fill height: Fit flow: Right spacing: 9
                    RoundedView{width: 24 height: 24 draw_bg +: {color: violetBg border_radius: 8.0} align: Align{x: 0.5 y: 0.5}
                        Label{text: "✦" draw_text.color: violetT draw_text.text_style.font_size: 12}}
                    View{width: Fill height: Fit flow: Down spacing: 2
                        Label{width: Fill text: "Vibe Agent 已整理今日 " + cnt("all") + " 封邮件:" + cnt("urgent") + " 封紧急 · " + cnt("reply") + " 封需回复 · " + cnt("later") + " 封可稍后"
                              draw_text.color: ink66 draw_text.text_style.font_size: 11}
                        Label{width: Fill text: banner_line() draw_text.color: ink45 draw_text.text_style.font_size: 9.5}
                    }
                    if mail_link == "no_account" {
                        ButtonFlat{text: "添加账号" on_click: || mail_add_account()
                            draw_bg +: {color: violet color_hover: violet color_down: accB border_radius: 9.0 border_size: 0.0}
                            draw_text +: {color: accInk text_style.font_size: 11}}
                    }
                }
                View{width: Fill height: Fit flow: Right spacing: 6
                    filter_chip("all", "全部", cnt("all"))
                    filter_chip("urgent", "紧急", cnt("urgent"))
                    filter_chip("reply", "需回复", cnt("reply"))
                    filter_chip("later", "可稍后", cnt("later"))
                }
            }
                RoundedView{width: Fill height: 1 draw_bg +: {color: line border_radius: 0.0}}
            RoundedView{width: Fill height: 1 draw_bg +: {color: line border_radius: 0.0}}
            View{width: Fill height: Fit flow: Down
                for i in mails.len() {
                    if pass_filter(i) { mail_row(i) }
                    RoundedView{width: Fill height: 1 draw_bg +: {color: line border_radius: 0.0}}
                }
                View{width: Fill height: 24}
            }
            }
        }
        RoundedView{width: 1 height: Fill draw_bg +: {color: line border_radius: 0.0}}
        ScrollYView{width: Fill height: Fill flow: Down
            if selected { reading_pane(current) } else { preview_pane() }
        }
        RoundedView{width: 1 height: Fill draw_bg +: {color: line border_radius: 0.0}}
        View{width: 310 height: Fill flow: Overlay
            RoundedView{width: Fill height: Fill draw_bg +: {color: panel border_radius: 0.0}}
            ScrollYView{width: Fill height: Fill flow: Down
                if selected { copilot_panel(current) } else { copilot_hint() }
            }
        }
    }
}

// Placeholder rail: no mail selected yet — never pre-render mail 0's data.
fn copilot_hint(){
    View{width: Fill height: Fit flow: Down padding: Inset{top: 14 bottom: 20 left: 13 right: 13}
        RoundedView{width: Fill height: Fit padding: Inset{top: 16 bottom: 16 left: 14 right: 14}
            draw_bg +: {color: panel2 border_radius: 14.0 border_size: 1.0 border_color: line} flow: Down spacing: 9
            Label{width: Fill text: "✦ AI Copilot 就绪" draw_text.color: violetT draw_text.text_style: theme.font_bold{font_size: 12}}
            Label{width: Fill text: "选择一封邮件,摘要、待办提取、语气洞察与智能回复会出现在这里。" draw_text.color: ink55 draw_text.text_style.font_size: 11}
        }
    }
}

// ---- reading pane ------------------------------------------------------------
fn ghost_btn(text, cb_color){
    RoundedView{width: 30 height: 30 draw_bg +: {color: #x00000000 border_radius: 8.0} align: Align{x: 0.5 y: 0.5}
        Label{text: text draw_text.color: cb_color draw_text.text_style.font_size: 13}}
}
fn reading_pane(i){
    let m = mails[i]
    View{width: Fill height: Fit flow: Down
        View{width: Fill height: 50 flow: Right spacing: 6 align: Align{y: 0.5} padding: Inset{left: 24 right: 14}
            Label{text: "邮件详情 · THREAD" draw_text.color: ink45 draw_text.text_style.font_size: 9}
            View{width: Fill height: 1}
            ghost_btn("★", ink45)
            ghost_btn("✦", ink45)
            ghost_btn("✕", ink45)
        }
        RoundedView{width: Fill height: 1 draw_bg +: {color: line border_radius: 0.0}}
        View{width: Fill height: Fit flow: Down padding: Inset{top: 20 bottom: 26 left: 26 right: 22}
            Label{width: Fill text: m.subject draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}}
            View{width: Fill height: 10}
            label_row(m)
            View{width: Fill height: 16}
            View{width: Fill height: Fit flow: Right spacing: 12
                avatar(i, 40, false)
                View{width: Fill height: Fit flow: Down spacing: 2
                    Label{text: m.sender draw_text.color: ink draw_text.text_style.font_size: 12}
                    Label{text: m.address + " → 发给我" draw_text.color: ink45 draw_text.text_style.font_size: 10}
                }
                Label{width: 64 text: m.time draw_text.color: ink45 draw_text.text_style.font_size: 10 align: Align{x: 1.0}}
            }
            View{width: Fill height: 16}
            View{width: Fill height: Fit flow: Down spacing: 12
                for p in m.body.split("\n\n") {
                    if p != "" {
                        Label{width: Fill text: p draw_text.color: inkHi draw_text.text_style.font_size: 12.5}
                    }
                }
            }
            if m.meeting_title != "" {
                View{width: Fill height: 18}
                RoundedView{width: Fill height: Fit padding: Inset{top: 14 bottom: 14 left: 16 right: 16}
                    draw_bg +: {color: panel border_radius: 14.0 border_size: 1.0 border_color: line} flow: Down spacing: 8
                    View{width: Fill height: Fit flow: Right spacing: 7 align: Align{y: 0.5}
                        Label{text: "✦" draw_text.color: cyan draw_text.text_style.font_size: 11}
                        Label{text: "AI 识别到会议意向" draw_text.color: cyanT draw_text.text_style.font_size: 9.5}
                    }
                    Label{text: m.meeting_title draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 13}}
                    View{width: Fill height: Fit flow: Right spacing: 14
                        Label{text: m.meeting_time draw_text.color: ink66 draw_text.text_style.font_size: 10.5}
                        Label{text: "◉ " + m.meeting_loc draw_text.color: ink66 draw_text.text_style.font_size: 10.5}
                    }
                    View{width: Fill height: 4}
                    View{width: Fill height: Fit flow: Right spacing: 8
                        ButtonFlat{height: 30 text: "加入日历" on_click: || go("agents")
                            draw_bg +: {color: violet color_hover: violet color_down: accB border_radius: 8.0 border_size: 0.0}
                            draw_text +: {color: accInk text_style.font_size: 11}}
                        ButtonFlat{height: 30 text: "协商改期" on_click: || open_reply()
                            draw_bg +: {color: #x00000000 color_hover: white7 color_down: white7 border_radius: 8.0 border_size: 1.0 border_color: line2}
                            draw_text +: {color: ink55 text_style.font_size: 11}}
                    }
                }
            }
            View{width: Fill height: 16}
            reply_strip(i)
            View{width: Fill height: 14}
            View{width: Fill height: Fit flow: Right spacing: 8
                ButtonFlat{width: Fill height: 34 text: "回复" on_click: || open_reply()
                    draw_bg +: {color: violet color_hover: violet color_down: accB border_radius: 9.0 border_size: 0.0}
                    draw_text +: {color: accInk text_style.font_size: 12}}
                ButtonFlat{width: Fill height: 34 text: "✦ AI 帮我回" on_click: || open_reply()
                    draw_bg +: {color: #x00000000 color_hover: white7 color_down: white7 border_radius: 9.0 border_size: 1.0 border_color: violetBd}
                    draw_text +: {color: violetT text_style.font_size: 12}}
                ButtonFlat{width: 96 height: 34 text: "转发" on_click: || open_forward()
                    draw_bg +: {color: #x00000000 color_hover: white7 color_down: white7 border_radius: 9.0 border_size: 1.0 border_color: line2}
                    draw_text +: {color: ink55 text_style.font_size: 12}}
            }
        }
    }
}

// ---- reply lifecycle strip (five states, one per surface) --------------------
fn reply_strip(i){
    let m = mails[i]
    if m.reply == "pending" {
        RoundedView{width: Fill height: Fit padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
            draw_bg +: {color: violetBg border_radius: 14.0 border_size: 1.0 border_color: violetBd} flow: Down spacing: 7
            View{width: Fill height: Fit flow: Right spacing: 7 align: Align{y: 0.5}
                live_dot()
                Label{text: "回复草稿 · 待发送" draw_text.color: violetT draw_text.text_style: theme.font_bold{font_size: 12}}
            }
            Label{width: Fill text: first_line(m.reply_text) draw_text.color: inkHi draw_text.text_style.font_size: 11}
            View{width: Fill height: Fit flow: Right spacing: 8
                ButtonFlat{width: Fill height: 32 text: "发送" on_click: || ask_send(i)
                    draw_bg +: {color: violet color_hover: violet color_down: accB border_radius: 9.0 border_size: 0.0}
                    draw_text +: {color: accInk text_style.font_size: 12}}
                ButtonFlat{width: Fill height: 32 text: "继续编辑" on_click: || edit_draft(i)
                    draw_bg +: {color: #x00000000 color_hover: white7 color_down: white7 border_radius: 9.0 border_size: 1.0 border_color: line2}
                    draw_text +: {color: ink55 text_style.font_size: 12}}
            }
        }
    } else {
        if m.reply == "confirm" {
            RoundedView{width: Fill height: Fit padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                draw_bg +: {color: amberBg border_radius: 14.0 border_size: 1.0 border_color: amber} flow: Down spacing: 7
                Label{width: Fill text: "确认发送给 " + m.sender + "?" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 12}}
                Label{width: Fill text: "发送后写入会话,不可自动撤回(练习数据)。" draw_text.color: ink55 draw_text.text_style.font_size: 10}
                View{width: Fill height: Fit flow: Right spacing: 8
                    ButtonFlat{width: Fill height: 32 text: "确认发送" on_click: || do_send(i)
                        draw_bg +: {color: violet color_hover: violet color_down: accB border_radius: 9.0 border_size: 0.0}
                        draw_text +: {color: accInk text_style.font_size: 12}}
                    ButtonFlat{width: Fill height: 32 text: "取消" on_click: || cancel_send(i)
                        draw_bg +: {color: #x00000000 color_hover: white7 color_down: white7 border_radius: 9.0 border_size: 1.0 border_color: line2}
                        draw_text +: {color: ink55 text_style.font_size: 12}}
                }
            }
        } else {
            if m.reply == "sending" {
                RoundedView{width: Fill height: Fit padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                    draw_bg +: {color: panel border_radius: 14.0 border_size: 1.0 border_color: line}
                    Label{width: Fill text: "发送中…" draw_text.color: ink55 draw_text.text_style.font_size: 12}
                }
            } else {
                if m.reply == "sent" {
                    RoundedView{width: Fill height: Fit padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                        draw_bg +: {color: mintBg border_radius: 14.0 border_size: 1.0 border_color: mintBd} flow: Down spacing: 5
                        Label{width: Fill text: "已回复 · 刚刚发送,已写入会话" draw_text.color: mintT draw_text.text_style: theme.font_bold{font_size: 12}}
                        Label{width: Fill text: first_line(m.reply_text) draw_text.color: inkHi draw_text.text_style.font_size: 11}
                    }
                } else {
                    if m.reply == "failed" {
                        RoundedView{width: Fill height: Fit padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                            draw_bg +: {color: redBg border_radius: 14.0 border_size: 1.0 border_color: red} flow: Down spacing: 7
                            Label{width: Fill text: "发送失败 · 邮件服务无响应" draw_text.color: redT draw_text.text_style: theme.font_bold{font_size: 12}}
                            Label{width: Fill text: pick(m.src == "live", "发送失败:" + m.send_error + "。草稿已保留,可重试。", "练习场景:模拟服务中断。草稿已保留,可重试或暂存。") draw_text.color: ink55 draw_text.text_style.font_size: 10}
                            View{width: Fill height: Fit flow: Right spacing: 8
                                ButtonFlat{width: Fill height: 32 text: "重试发送" on_click: || retry_send(i)
                                    draw_bg +: {color: violet color_hover: violet color_down: accB border_radius: 9.0 border_size: 0.0}
                                    draw_text +: {color: accInk text_style.font_size: 12}}
                                ButtonFlat{width: Fill height: 32 text: "保留草稿" on_click: || keep_draft(i)
                                    draw_bg +: {color: #x00000000 color_hover: white7 color_down: white7 border_radius: 9.0 border_size: 1.0 border_color: line2}
                                    draw_text +: {color: ink55 text_style.font_size: 12}}
                            }
                        }
                    }
                }
            }
        }
    }
}

// ---- AI copilot panel ---------------------------------------------------------
fn copilot_panel(i){
    let m = mails[i]
    View{width: Fill height: Fit flow: Down
        View{width: Fill height: 50 flow: Right spacing: 8 align: Align{y: 0.5} padding: Inset{left: 16 right: 14}
            Label{text: "✦" draw_text.color: violetT draw_text.text_style.font_size: 12}
            Label{text: "AI COPILOT" draw_text.color: violetT draw_text.text_style.font_size: 10}
            View{width: Fill height: 1}
            RoundedView{width: 7 height: 7 draw_bg +: {color: cyan border_radius: 4.0}}
        }
        RoundedView{width: Fill height: 1 draw_bg +: {color: line border_radius: 0.0}}
        View{width: Fill height: Fit flow: Down spacing: 13 padding: Inset{top: 14 bottom: 20 left: 13 right: 13}
            // 摘要
            RoundedView{width: Fill height: Fit padding: Inset{top: 13 bottom: 13 left: 14 right: 14}
                draw_bg +: {color: panel2 border_radius: 14.0 border_size: 1.0 border_color: line} flow: Down spacing: 10
                View{width: Fill height: Fit flow: Right spacing: 7 align: Align{y: 0.5}
                    Label{text: "✦" draw_text.color: violetT draw_text.text_style.font_size: 11}
                    Label{text: "摘要" draw_text.color: ink45 draw_text.text_style.font_size: 9.5}
                    View{width: Fill height: 1}
                    ButtonFlat{height: 24 padding: Inset{left: 8 right: 8} text: "AI 生成" on_click: || gen_summary(i)
                        draw_bg +: {color: violet color_hover: violet color_down: accB border_radius: 7.0 border_size: 0.0}
                        draw_text +: {color: accInk text_style.font_size: 9.5}}
                }
                if m.summary_src == "asking" {
                    Label{width: Fill text: "AI 摘要生成中…" draw_text.color: violetT draw_text.text_style.font_size: 11}
                } else {
                    if m.summary_src == "unavailable" {
                        Label{width: Fill text: "模型服务不可用:" + summary_error draw_text.color: redT draw_text.text_style.font_size: 9.5}
                    }
                    let pts = m.summary
                    if m.summary_src == "ai" { pts = m.ai_points }
                    for p in pts {
                        View{width: Fill height: Fit flow: Right spacing: 8
                            View{width: Fill height: Fit flow: Right spacing: 8
                                RoundedView{width: 5 height: 5 draw_bg +: {color: violet border_radius: 3.0}}
                                Label{width: Fill text: p draw_text.color: inkHi draw_text.text_style.font_size: 11}
                            }
                        }
                    }
                }
                Label{text: "由 Vibe Agent 生成 · 0.8s" draw_text.color: ink45 draw_text.text_style.font_size: 9}
            }
            // 待办提取
            if m.actions.len() > 0 {
                RoundedView{width: Fill height: Fit padding: Inset{top: 13 bottom: 13 left: 14 right: 14}
                    draw_bg +: {color: panel2 border_radius: 14.0 border_size: 1.0 border_color: line} flow: Down spacing: 9
                    View{width: Fill height: Fit flow: Right spacing: 7
                        Label{text: "✓" draw_text.color: amber draw_text.text_style.font_size: 11}
                        Label{text: "待办提取" draw_text.color: ink45 draw_text.text_style.font_size: 9.5}
                    }
                    for a in m.actions {
                        RoundedView{width: Fill height: Fit padding: Inset{top: 8 bottom: 8 left: 10 right: 10}
                            draw_bg +: {color: panel border_radius: 10.0 border_size: 1.0 border_color: line}
                            View{width: Fill height: Fit flow: Right spacing: 9
                                RoundedView{width: 15 height: 15 draw_bg +: {color: pick(a.done, mint, #x00000000) border_radius: 5.0 border_size: 1.0 border_color: pick(a.done, mint, line2)} align: Align{x: 0.5 y: 0.5}
                                    if a.done {
                                        Label{text: "✓" draw_text.color: accInk draw_text.text_style.font_size: 9}
                                    }
                                }
                                View{width: Fill height: Fit flow: Down spacing: 2
                                    Label{width: Fill text: a.text draw_text.color: pick(a.done, ink38, inkHi) draw_text.text_style.font_size: 11}
                                    if a.due != "" {
                                        Label{text: "· " + a.due draw_text.color: amberT draw_text.text_style.font_size: 9}
                                    }
                                }
                            }
                        }
                    }
                }
            }
            // 语气洞察
            if m.sent_label != "" {
                RoundedView{width: Fill height: Fit padding: Inset{top: 13 bottom: 13 left: 14 right: 14}
                    draw_bg +: {color: panel2 border_radius: 14.0 border_size: 1.0 border_color: line} flow: Down spacing: 9
                    View{width: Fill height: Fit flow: Right spacing: 7
                        Label{text: "✦" draw_text.color: mint draw_text.text_style.font_size: 11}
                        Label{text: "语气洞察" draw_text.color: ink45 draw_text.text_style.font_size: 9.5}
                    }
                    chip(m.sent_label, m.sent_tone)
                    Label{width: Fill text: m.sent_note draw_text.color: ink66 draw_text.text_style.font_size: 11}
                }
            }
            // 智能回复
            if m.replies.len() > 0 {
                View{width: Fill height: Fit flow: Down spacing: 7
                    section_label("智能回复")
                    for r in m.replies {
                        reply_row(i, r)
                    }
                }
            }
        }
    }
}
// minted through a fn so `r` binds at CALL time (late-binding trap)
fn reply_row(i, r){
    GestureView{width: Fill height: 36 on_tap: |x, y| quick_reply(i, r)
        RoundedView{width: Fill height: 36
            draw_bg +: {color: panel2 border_radius: 10.0 border_size: 1.0 border_color: line}
            View{width: Fill height: Fill flow: Right spacing: 8 align: Align{y: 0.5} padding: Inset{left: 12 right: 10}
                Label{text: "✦" draw_text.color: violetT draw_text.text_style.font_size: 11}
                Label{width: Fill text: r draw_text.color: ink66 draw_text.text_style.font_size: 11}
                Label{text: "→" draw_text.color: violetT draw_text.text_style.font_size: 12}
            }
        }
    }
}

// ---- AI 写信 -------------------------------------------------------------------
fn set_tone(t){ tone = t; repaint() }
// The local template keeps the app fully usable when no model answers.
fn local_draft(){
    let ask = draft_input
    if ask == "" { ask = "一封通用商务邮件" }
    draft_text = "(草稿 · " + tone + ")\n\n你好:\n\n关于「" + ask + "」,说明如下:本次沟通意在同步进展并确认下一步安排。如有疑问,欢迎随时回复讨论。\n\n顺祝商祺。"
}
fn regen(){
    let ask = draft_input
    if ask == "" { ask = "一封通用商务邮件" }
    draft_status = "asking"
    draft_error = ""
    repaint()
    host.request("model.complete", {
        task: "按给定语气为一封中文邮件起草简短回复,只输出邮件正文,不编造事实。"
        input: {subject: mails[current].subject sender: mails[current].sender ask: ask tone: tone}
        schema: {type: "object" required: ["body"] additionalProperties: false
                 properties: {body: {type: "string" maxLength: 400}}}
        class: "fast"
    }, fn(r){
        if !r.is_ok {
            draft_status = "unavailable"
            draft_error = r.error
            local_draft()
            repaint()
            return
        }
        draft_text = r.data.output.body
        draft_status = "ai"
        repaint()
    })
}
fn insert_draft(){
    if draft_text == "" { regen() return }
    mails[current].reply_text = draft_text
    mails[current].reply = "pending"
    selected = true
    go("inbox")
}
fn draft_pill_text(){
    if draft_status == "asking" { return "生成中…" }
    if draft_status == "ai" { return "模型生成" }
    if draft_status == "unavailable" { return "本地模板·服务不可用" }
    return "本地模板"
}
fn tone_chip(t){
    ButtonFlat{height: 26 padding: Inset{left: 9 right: 9} text: t on_click: || set_tone(t)
        draw_bg +: {color: pick(t == tone, violetBgHv, #x00000000) color_hover: violetBg color_down: violetBg border_radius: 7.0 border_size: 1.0 border_color: pick(t == tone, violetBd, #x00000000)}
        draw_text +: {color: pick(t == tone, violetT, ink66) text_style.font_size: 10.5}}
}
fn prompt_chip(t){
    ButtonFlat{height: 30 padding: Inset{left: 10 right: 10} text: t on_click: || { draft_input = t; repaint() }
        draw_bg +: {color: #x00000000 color_hover: violetBg color_down: violetBg border_radius: 8.0 border_size: 1.0 border_color: line2}
        draw_text +: {color: ink66 text_style.font_size: 11}}
}
fn ctx_row(text, on){
    View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5} padding: Inset{top: 4 bottom: 4}
        Label{width: Fill text: text draw_text.color: ink66 draw_text.text_style.font_size: 11.5}
        RoundedView{width: 30 height: 17 draw_bg +: {color: pick(on, violet, line2) border_radius: 9.0} flow: Overlay
            View{width: 30 height: 17 align: pick(on, Align{x: 1.0 y: 0.5}, Align{x: 0.0 y: 0.5})
                View{width: 17 height: 17 align: Align{x: 0.5 y: 0.5}
                    RoundedView{width: 13 height: 13 draw_bg +: {color: panel border_radius: 7.0}}}
            }
        }
    }
}
fn write_screen(){
    View{width: Fill height: Fill flow: Right
        ScrollYView{width: Fill height: Fill flow: Down
        View{width: Fill height: Fit flow: Down padding: Inset{top: 20 bottom: 28 left: 30 right: 20}
            View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                Label{text: "✦" draw_text.color: violetT draw_text.text_style.font_size: 13}
                Label{text: "新邮件" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 14}}
                Label{text: "AI-ASSISTED DRAFT" draw_text.color: ink45 draw_text.text_style.font_size: 9}
            }
            View{width: 1 height: 14}
            RoundedView{width: Fill height: Fit draw_bg +: {color: panel border_radius: 16.0 border_size: 1.0 border_color: line}
                View{width: Fill height: Fit flow: Down
                    View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5} padding: Inset{top: 11 bottom: 11 left: 16 right: 16}
                        Label{width: 44 text: "收件人" draw_text.color: ink45 draw_text.text_style.font_size: 10.5}
                        RoundedView{width: Fit height: Fit padding: Inset{top: 3 bottom: 3 left: 4 right: 10}
