// VibeMail 0.7.2 — 有情绪的邮件 (emails carry vibes)
// Complete rebuild after the OctoSense design prototype reference: a phone
// column (412 logical px, centred) carrying five vibe moods — coral 专注 /
// neon 愉悦 / mint 平静 / pink 灵感 / blue 连接 — on a warm-paper light theme
// (#eaeae3 ground) and a charcoal dark theme (#151413). Screens: 收件箱
// (greeting + AI digest line + vibe filter chips + aura-tinted mail cards),
// 星轨 (mails as floating bubbles: size = importance, colour = vibe, slow
// sin drift), 邮件详情 (AI 三行摘要 card + body + 星标/归档/回复), 写信
// (tone slider 真诚 ↔ 正式 rewriting the preview via the host model service,
// honest canned fallbacks), 我的 (theme, capability declaration, account,
// practice switches). Every glyph is DRAWN from native parts (runtime SVG
// rasterises blank and font dingbats depend on CJK fallbacks — probed in
// 0.6.17); every colour is a literal (no runtime hex math). Real mail goes
// through the platform mail host service (credentials stay host-side); live
// mails get a keyword vibe classification plus model summaries where the
// model service answers; card-host degrades honestly to the labelled
// practice dataset below.

// ---- state ---------------------------------------------------------------
let screen = "inbox"       // inbox | orbit | write | set
let open_idx = -1          // opened mail index, -1 = none (detail overlays)
let filter = "all"         // all | focus | joy | calm | spark | link
let anim_t = 0.0           // orbit drift clock (advanced by the anim interval)
let greeting_word = "早上好"  // time-adaptive: 早上好/中午好/下午好/晚上好

// ---- greeting ----------------------------------------------------------------
// Time-adaptive greeting. std.local_time() reports UTC on card-host (the host
// leaves the UTC offset at zero), so the hour is shifted +8 for the app's
// Chinese audience; buckets: 0-5 / 18-24 晚上好, 5-12 早上好, 12-14 中午好,
// 14-18 下午好. The poller refreshes it so a screen left open rolls over.
fn greeting_for_now(){
    let h = mod.std.local_time().hour + 8
    if h >= 24 { h = h - 24 }
    if h < 5 { return "晚上好" }
    if h < 12 { return "早上好" }
    if h < 14 { return "中午好" }
    if h < 18 { return "下午好" }
    return "晚上好"
}

// ---- vibe system ----------------------------------------------------------
// Five moods, one aura palette each (reference jn map). Chip grounds are the
// vibe colour at ~25% (light) / ~18% (dark) alpha — pre-blended literals in
// apply_theme; neon yellow swaps to #c9b300 for dots/bullets on light ground
// (the reference does the same for contrast).
let coralC = #xff6a3d      // 专注 focus
let neonC  = #xf6ff91      // 愉悦 joy
let mintC  = #x7de888      // 平静 calm
let pinkC  = #xff90ff      // 灵感 spark
let blueC  = #x2a7dfa      // 连接 link
let skyC   = #x2ea0f2
let amberC = #xffb03d      // star fill, both themes
let onC    = #x2a2a2a      // text on neon / mint / pink fills and bubbles

fn vibe_label(v){
    if v == "focus" { return "专注" }
    if v == "joy"   { return "愉悦" }
    if v == "calm"  { return "平静" }
    if v == "spark" { return "灵感" }
    return "连接"
}
fn vibe_color(v){
    if v == "focus" { return coralC }
    if v == "joy"   { return neonC }
    if v == "calm"  { return mintC }
    if v == "spark" { return pinkC }
    return blueC
}
// keyword classifier for live platform mails (labelled 规则标注; focus beats
// joy beats spark beats link, calm is the FYI default)
fn classify_vibe(subject, address){
    let s = subject + " " + address
    if s.search("账单") >= 0 { return "focus" }
    if s.search("发票") >= 0 { return "focus" }
    if s.search("扣款") >= 0 { return "focus" }
    if s.search("截止") >= 0 { return "focus" }
    if s.search("需回复") >= 0 { return "focus" }
    if s.search("billing") >= 0 { return "focus" }
    if s.search("invoice") >= 0 { return "focus" }
    if s.search("payment") >= 0 { return "focus" }
    if s.search("deadline") >= 0 { return "focus" }
    if s.search("外婆") >= 0 { return "joy" }
    if s.search("妈妈") >= 0 { return "joy" }
    if s.search("家人") >= 0 { return "joy" }
    if s.search("恭喜") >= 0 { return "joy" }
    if s.search("祝贺") >= 0 { return "joy" }
    if s.search("周末") >= 0 { return "joy" }
    if s.search("生日") >= 0 { return "joy" }
    if s.search("周报") >= 0 { return "spark" }
    if s.search("双周报") >= 0 { return "spark" }
    if s.search("newsletter") >= 0 { return "spark" }
    if s.search("digest") >= 0 { return "spark" }
    if s.search("小组") >= 0 { return "link" }
    if s.search("社区") >= 0 { return "link" }
    if s.search("投票") >= 0 { return "link" }
    if s.search("邀请") >= 0 { return "link" }
    if s.search("club") >= 0 { return "link" }
    if s.search("community") >= 0 { return "link" }
    return "calm"
}
fn vibe_imp(v){
    if v == "focus" { return 80 }
    if v == "joy"   { return 70 }
    if v == "spark" { return 55 }
    if v == "link"  { return 45 }
    return 30
}

