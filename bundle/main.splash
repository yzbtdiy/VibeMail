// agentic-mail — five-screen concept app rebuilt from the four UI reference
// images (智能收件箱 / 邮件阅读AI摘要 / AI写信起草 / 跟进提醒待办).
// Warm cream ground, white cards, gradient AI banner, purple AI summary,
// segmented todos. Reply lifecycle lives on the mail itself (draft -> confirm
// -> sending -> sent / failed -> retry) so the inbox pill, the read strip and
// the draft editor all read one state. AI summary and drafting call the
// host's one-shot model service (model.complete, OctoSense#95) with a
// schema-checked answer; where nothing answers "model" (card-host) the app
// says so and falls back to labelled practice content. Mail data and sends
// are practice data; no real mail service.

// ---- state ---------------------------------------------------------------
let screen = "inbox"          // inbox | read | write | todo | me
let current = 0

let mails = [
    {who: "张伟" role: "产品负责人" av: "av-zhang.svg" tag: "紧急" time: "08:30" unread: true group: "urgent" muted: false
     subject: "【紧急】产品发布会流程确认"
     preview: "小林,发布会流程已更新,请尽快确认…"
     body: "小林:\n\n我们整理了产品发布会的完整流程(见附件),请你尽快确认整体安排与时间节点。\n\n如有需要调整的地方,请直接在文档中批注,或回复邮件说明,我们会尽快跟进修改。\n\n谢谢!"
     attach: "发布会流程V3.pdf · PDF · 1.2 MB"
     points: ["确认产品发布会的整体流程安排与时间节点。","重点讨论嘉宾致辞、产品演示和媒体问答三个环节。","请尽快确认,如需调整请提出具体修改建议。"]
     action: "建议行动:今天内确认流程,或提出具体修改意见。"
     quick: ["确认流程", "需要修改"]
     reply: "" reply_text: "" send_error: ""
     summary_src: "practice" ai_points: [] ai_action: "" src: "practice" id: "" address: ""}
    {who: "李娜" role: "市场部" av: "av-li.svg" tag: "今日" time: "昨天 17:45" unread: true group: "urgent" muted: false
     subject: "Q2 市场推广方案终稿"
     preview: "附件为最终版本,请在今天下班前…"
     body: "小林:\n\nQ2 市场推广方案终稿见附件,核心渠道与预算已在上一轮对齐。\n\n请在今天下班前确认终稿,逾期将按当前版本提交,谢谢!"
     attach: "Q2推广方案终稿.pdf · PDF · 2.4 MB"
     points: ["Q2 推广方案已定稿,核心渠道与预算已对齐。","需在今天下班前确认终稿,逾期按当前版本提交。","如无异议可直接回复确认。"]
     action: "建议行动:今天下班前回复确认终稿。"
     quick: ["确认终稿", "再讨论"]
     reply: "" reply_text: "" send_error: ""
     summary_src: "practice" ai_points: [] ai_action: "" src: "practice" id: "" address: ""}
    {who: "王强" role: "合作伙伴" av: "av-wang.svg" tag: "稍后" time: "昨天 11:20" unread: false group: "later" muted: true
     subject: "合作意向沟通纪要"
     preview: "感谢今天的沟通,以下是会议纪要…"
     body: "小林:\n\n感谢今天的沟通,以下是合作意向的会议纪要,请查收。\n\n下一步我们会在本周五前给出合作框架初稿,届时再约时间详谈。"
     attach: ""
     points: ["合作方将在本周五前给出合作框架初稿。","纪要仅供内部确认,暂不需对外回复。"]
     action: "建议行动:本周五前查看纪要并留意框架初稿。"
     quick: ["收到", "先看看"]
     reply: "" reply_text: "" send_error: ""
     summary_src: "practice" ai_points: [] ai_action: "" src: "practice" id: "" address: ""}
    {who: "陈晨" role: "设计部" av: "av-sun.svg" tag: "稍后" time: "周一" unread: false group: "later" muted: true
     subject: "官网改版设计稿确认"
     preview: "已根据你的反馈更新,请查看…"
     body: "小林:\n\n官网改版设计稿已根据你的反馈更新完成,主要调整了首页信息层级与配色。\n\n已收到你的确认,感谢支持!"
