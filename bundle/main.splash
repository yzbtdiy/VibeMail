// ---- vibe glyphs -------------------------------------------------------------
// (chip glyphs retired in 0.7.2 — emotion chips went text-only in their vibe
// colour; leaf_icon survives for the empty state)
// leaf (calm): pointed oval from stacked cells + stem
fn leaf_icon(color, size){
    let u = size / 16.0
    View{width: size height: size flow: Overlay
        ipart(size, size * 0.5, size * 0.5, size * 0.40, size * 0.66, color, size * 0.2)
        ipart(size, size * 0.5, size * 0.30, size * 0.22, size * 0.30, color, size * 0.11)
        ipart(size, size * 0.5, size * 0.855, 2.0 * u, size * 0.16, color, 1.0 * u)
    }
}

// ---- aura family (the vibe material signature) ------------------------------
// The reference aura is ONE Gaussian-blurred blob per vibe. The runtime has
// no blur, and any multi-disc fallback shows its ring edges at card scale
// (0.7.2 finding), so auras survive only as small ambient washes — the
// greeting brand mark, the empty state and the settings avatar. Mail cards
// carry their vibe on the unread dot and the chip instead.
fn aura_calm(size){
    View{width: size height: size flow: Overlay
        icell(size, size * 0.5, size * 0.45, size * 0.46, #x7de88824)
        icell(size, size * 0.5, size * 0.45, size * 0.56, #x7de8881c)
        icell(size, size * 0.5, size * 0.45, size * 0.66, #x7de88814)
        icell(size, size * 0.5, size * 0.45, size * 0.76, #x7de8880c)
        icell(size, size * 0.5, size * 0.45, size * 0.86, #x7de88805)
    }
}
fn aura_joy(size){
    View{width: size height: size flow: Overlay
        icell(size, size * 0.5, size * 0.45, size * 0.46, #xf6ff9124)
        icell(size, size * 0.5, size * 0.45, size * 0.56, #xf6ff911c)
        icell(size, size * 0.5, size * 0.45, size * 0.66, #xf6ff9114)
        icell(size, size * 0.5, size * 0.45, size * 0.76, #xf6ff910c)
        icell(size, size * 0.5, size * 0.45, size * 0.86, #xf6ff9105)
    }
}
fn aura_brand(size){
    View{width: size height: size flow: Overlay
        icell(size, size * 0.40, size * 0.42, size * 0.74, #xf6ff9130)
        icell(size, size * 0.58, size * 0.52, size * 0.58, #x7de88834)
        icell(size, size * 0.44, size * 0.64, size * 0.36, #x2a7dfa30)
        icell(size, size * 0.62, size * 0.30, size * 0.24, #xff90ff30)
    }
}
// (orbit bubble glow halos and per-vibe mail-card auras removed in 0.7.2:
// with a discrete-disc fallback for the reference's feathered boxShadow,
// four of five vibes were invisible while the link blue's halo read as
// stray circles — the user prefers none. The bubbles keep their inner
// highlight for the radial-gradient feel; cards carry the vibe on the
// unread dot and the chip.)

// ---- shared bits -------------------------------------------------------------
// vibe chip: text-only capsule in the vibe's tint (glyph dropped, 0.7.2)
fn vibe_chip(v){
    RoundedView{width: Fit height: Fit padding: Inset{top: 3 bottom: 3 left: 9 right: 9}
        draw_bg +: {color: chip_bg(v) border_radius: 10.0}
        Label{text: vibe_label(v) draw_text.color: chip_fg(v) draw_text.text_style.font_size: 10}
    }
}
fn reply_state_chip(m){
    if m.reply == "sent" {
        RoundedView{width: Fit height: Fit padding: Inset{top: 1 bottom: 1 left: 7 right: 7}
            draw_bg +: {color: #x7de88840 border_radius: 8.0}
            Label{text: "已回复" draw_text.color: chipFgCalm draw_text.text_style.font_size: 9}}
    } else {
        if m.reply == "failed" {
            RoundedView{width: Fit height: Fit padding: Inset{top: 1 bottom: 1 left: 7 right: 7}
                draw_bg +: {color: failBg border_radius: 8.0}
                Label{text: "发送失败" draw_text.color: failT draw_text.text_style.font_size: 9}}
        } else {
            View{width: 0 height: 0}
        }
    }
}
// (no status bar: the host window has its own chrome — the phone column
// starts directly with the screen content)
fn screen_title(t){
    Label{text: t draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 22}}
}
fn soft_note(t, size){
    Label{width: Fill text: t draw_text.color: inkSoft draw_text.text_style.font_size: size}
}

// ---- inbox -----------------------------------------------------------------
// vibe filter chips: TEXT ONLY in the vibe's own colour (0.7.2 user call —
// the drawn glyphs read poorly at chip size, so emotion is carried by the
// word + a tinted ground; 全部 stays neutral, the active chip inverts to ink)
fn filter_chip(key, label){
    let act = filter == key
    GestureView{width: Fit height: Fit on_tap: |x, y| set_filter(key)
        RoundedView{width: Fit height: Fit padding: Inset{top: 6 bottom: 6 left: 12 right: 12}
            draw_bg +: {color: pick(act, ink, pick(key == "all", paper3, chip_bg(key)))
                       border_radius: 15.0
                       border_size: pick(act, 0.0, pick(key == "all", 1.0, 0.0))
                       border_color: line}
            Label{text: label draw_text.color: pick(act, paper, pick(key == "all", inkSoft, chip_fg(key)))
                   draw_text.text_style.font_size: 11}
        }
    }
}
fn mail_card(i){
    let m = mails[i]
    GestureView{width: Fill height: Fit on_tap: |x, y| open_mail(i)
        RoundedView{width: Fill height: Fit padding: Inset{top: 13 bottom: 13 left: 14 right: 14}
            draw_bg +: {color: paper3 border_radius: 20.0 border_size: 1.0 border_color: line}
            // (card aura removed in 0.7.2: at card scale the disc-fade read as
            // circles on every vibe but most of all on link blue; the vibe
            // colour stays on the unread dot and the chip)
            View{width: Fill height: Fit flow: Down spacing: 5
                    View{width: Fill height: Fit flow: Right spacing: 7 align: Align{y: 0.5}
                        if m.unread {
                            RoundedView{width: 6 height: 6 draw_bg +: {color: dot_color(m.vibe) border_radius: 3.0}}
                        } else {
                            View{width: 6 height: 6}
                        }
                        Label{width: Fill text: m.sender draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 13}}
                        if m.starred {
                            View{width: 12 height: 12 align: Align{x: 0.5 y: 0.5}
                                star_icon(amberC, 11)}
                        }
                        Label{text: m.time draw_text.color: inkSoft draw_text.text_style.font_size: 10}
                    }
                    Label{width: Fill text: m.subject draw_text.color: ink draw_text.text_style.font_size: 12.5}
                    Label{width: Fill text: m.snippet draw_text.color: inkSoft draw_text.text_style.font_size: 11.5}
                View{width: Fill height: Fit flow: Right spacing: 6 align: Align{y: 0.5} padding: Inset{top: 3}
                    vibe_chip(m.vibe)
                    if m.summary_src == "asking" {
                        RoundedView{width: Fit height: Fit padding: Inset{top: 1 bottom: 1 left: 7 right: 7}
                            draw_bg +: {color: paper2 border_radius: 8.0}
                            Label{text: "AI 摘要生成中…" draw_text.color: inkSoft draw_text.text_style.font_size: 9}}
                    }
                    reply_state_chip(m)
                    View{width: Fill height: 1}
                    Label{text: "重要度 " + m.imp draw_text.color: inkDim draw_text.text_style.font_size: 9}
                }
            }
        }
    }
}
fn inbox_empty(){
    View{width: Fill height: Fit flow: Down spacing: 12 padding: Inset{top: 56 bottom: 40} align: Align{x: 0.5}
        View{width: 90 height: 104 align: Align{x: 0.5 y: 0.5}
            View{width: 90 height: 90 align: Align{x: 0.5 y: 0.5}
                aura_calm(90)}}
        View{width: Fit height: Fit flow: Right spacing: 5 align: Align{y: 0.5}
            Label{text: "收件箱一片平静" draw_text.color: inkSoft draw_text.text_style.font_size: 12}
            View{width: 13 height: 13 align: Align{x: 0.5 y: 0.5}
                leaf_icon(mintC, 12)}
        }
    }
}
fn inbox_screen(){
    ScrollYView{width: Fill height: Fill flow: Down
        View{width: Fill height: Fit flow: Down spacing: 12 padding: Inset{top: 14 bottom: 36 left: 16 right: 16}
            // greeting + brand aura (the aura sways on the drift clock)
            View{width: Fill height: Fit flow: Right align: Align{y: 0.0}
                View{width: Fill height: Fit flow: Down
                    Label{text: greeting_word + "," draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 22}}
                    Label{text: "你有 " + unread_cnt() + " 封未读邮件" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 22}}
                }
                View{width: 76 height: 84 align: Align{x: 1.0 y: 0.5}
                    View{width: 64 height: 64 align: Align{x: 0.5 y: 0.5}
                        aura_brand(64)}}
            }
            // AI digest line
            RoundedView{width: Fill height: Fit padding: Inset{top: 10 bottom: 10 left: 12 right: 12}
                draw_bg +: {color: paper3 border_radius: 16.0 border_size: 1.0 border_color: line} flow: Down spacing: 4
                View{width: Fill height: Fit flow: Right spacing: 6 align: Align{y: 0.5}
                    View{width: 12 height: 12 align: Align{x: 0.5 y: 0.5}
                        spark_icon(inkSoft, 11)}
                    Label{width: Fill text: digest_line() draw_text.color: inkSoft draw_text.text_style.font_size: 11}
                }
                Label{width: Fill text: banner_line() draw_text.color: inkDim draw_text.text_style.font_size: 9}
                if filter != "all" {
                    Label{width: Fill text: filter_note() draw_text.color: inkSoft draw_text.text_style.font_size: 9.5}
                }
            }
            // vibe filter chips — tight enough that all six stay on screen
            ScrollXView{width: Fill height: Fit flow: Right spacing: 4 padding: Inset{top: 2 bottom: 2}
                filter_chip("all", "全部")
                filter_chip("focus", "专注")
                filter_chip("joy", "愉悦")
                filter_chip("calm", "平静")
                filter_chip("spark", "灵感")
                filter_chip("link", "连接")
            }
            // the list itself
            View{width: Fill height: Fit flow: Down spacing: 10
                for i in mails.len() {
                    if mails[i].boxed == "" {
                        if filter == "all" {
                            mail_card(i)
                        } else {
                            if mails[i].vibe == filter { mail_card(i) }
                        }
                    }
                }
                if visible_count() == 0 { inbox_empty() }
            }
        }
    }
}

// ---- detail -----------------------------------------------------------------
fn summary_row(text, v){
    View{width: Fill height: Fit flow: Right spacing: 8 padding: Inset{top: 2 bottom: 2}
        View{width: 12 height: 12 align: Align{x: 0.5 y: 0.1}
            ipart(12, 6, 6, 5, 5, dot_color(v), 1.5)}
        Label{width: Fill text: text draw_text.color: ink draw_text.text_style.font_size: 12}
    }
}
// capsule action button (detail footer): icon + label, centred
fn action_capsule(icon_key, label, bg, fg, border, cut){
    RoundedView{width: Fill height: 42 draw_bg +: {color: bg border_radius: 21.0 border_size: 1.0 border_color: border} align: Align{x: 0.5 y: 0.5}
        View{width: Fit height: Fit flow: Right spacing: 6 align: Align{y: 0.5}
            View{width: 13 height: 13 align: Align{x: 0.5 y: 0.5}
                if icon_key == "star" { star_icon(fg, 13) } else {
                if icon_key == "archive" { archive_icon(fg, 13, cut) } else {
                pen_icon(fg, 13, cut) }}}
            Label{text: label draw_text.color: fg draw_text.text_style.font_size: 11.5}
        }
    }
}
fn detail_screen(){
    let m = mails[open_idx]
    ScrollYView{width: Fill height: Fill flow: Down
        View{width: Fill height: Fit flow: Down spacing: 12 padding: Inset{top: 12 bottom: 36 left: 16 right: 16}
            GestureView{width: Fit height: Fit on_tap: |x, y| close_detail()
                View{width: Fit height: Fit flow: Right spacing: 5 align: Align{y: 0.5} padding: Inset{top: 4 bottom: 4}
                    View{width: 15 height: 15 align: Align{x: 0.5 y: 0.5}
                        back_icon(inkSoft, 15)}
                    Label{text: "收件箱" draw_text.color: inkSoft draw_text.text_style.font_size: 13}
                }
            }
            RoundedView{width: Fill height: Fit padding: Inset{top: 18 bottom: 18 left: 18 right: 18}
                draw_bg +: {color: paper3 border_radius: 22.0 border_size: 1.0 border_color: line}
                View{width: Fill height: Fit flow: Down spacing: 8
                    vibe_chip(m.vibe)
                    Label{width: Fill text: m.subject draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}}
                    Label{width: Fill text: m.sender + " · " + m.handle + " · " + m.time draw_text.color: inkSoft draw_text.text_style.font_size: 12}
                    // AI 三行摘要
                    RoundedView{width: Fill height: Fit padding: Inset{top: 12 bottom: 12 left: 12 right: 12}
                        draw_bg +: {color: paper2 border_radius: 16.0} flow: Down spacing: 5
                        View{width: Fill height: Fit flow: Right spacing: 6 align: Align{y: 0.5}
                            View{width: 12 height: 12 align: Align{x: 0.5 y: 0.5}
                                spark_icon(inkSoft, 11)}
                            Label{width: Fill text: "AI 三行摘要" draw_text.color: inkSoft draw_text.text_style.font_size: 11}
                            Label{text: summary_state_word(m) draw_text.color: inkDim draw_text.text_style.font_size: 9}
                        }
                        if m.summary_src == "asking" {
                            Label{width: Fill text: "正在向模型服务请求要点…" draw_text.color: inkSoft draw_text.text_style.font_size: 11}
                        } else {
                            if summary_lines(m).len() == 0 {
                                Label{width: Fill text: "暂无摘要 · 模型服务不可用" draw_text.color: inkSoft draw_text.text_style.font_size: 11}
                            } else {
                                for pi in summary_lines(m).len() {
                                    summary_row(summary_lines(m)[pi], m.vibe)
                                }
                            }
                        }
                    }
                    Label{width: Fill text: m.body draw_text.color: ink draw_text.text_style.font_size: 13}
                    if m.reply == "failed" {
                        Label{width: Fill text: "上次发送失败:" + m.send_error + " · 可在「写信」里重试" draw_text.color: failT draw_text.text_style.font_size: 10}
                    }
                }
            }
            // actions: 星标 / 归档 / 回复
            View{width: Fill height: Fit flow: Right spacing: 9
                GestureView{width: Fill height: 42 on_tap: |x, y| toggle_star(open_idx)
                    action_capsule("star", pick(m.starred, "已星标", "星标"), paper2, ink, line, paper2)}
                GestureView{width: Fill height: 42 on_tap: |x, y| archive_mail(open_idx)
                    action_capsule("archive", "归档", paper2, ink, line, paper2)}
                GestureView{width: Fill height: 42 on_tap: |x, y| open_compose(open_idx)
                    action_capsule("pen", "回复", neonC, onC, neonC, neonC)}
            }
        }
    }
}

// ---- orbit (star map) -------------------------------------------------------
// Preset anchor points (percent of the 380x560 field), size = 52 + imp*0.62,
// gentle sin/cos drift per bubble; the field repaints on the anim interval.
fn orbit_x(i){
    if i == 0 { return 16 + 8 * 38 / 10 }
    if i == 1 { return 16 + 52 * 38 / 10 }
    if i == 2 { return 16 + 18 * 38 / 10 }
    if i == 3 { return 16 + 60 * 38 / 10 }
    if i == 4 { return 16 + 6 * 38 / 10 }
    if i == 5 { return 16 + 48 * 38 / 10 }
    if i == 6 { return 16 + 24 * 38 / 10 }
    return 16 + 64 * 38 / 10
}
fn orbit_y(i){
    if i == 0 { return 26 + 6 * 52 / 10 }
    if i == 1 { return 26 + 2 * 52 / 10 }
    if i == 2 { return 26 + 32 * 52 / 10 }
    if i == 3 { return 26 + 30 * 52 / 10 }
    if i == 4 { return 26 + 60 * 52 / 10 }
    if i == 5 { return 26 + 58 * 52 / 10 }
    if i == 6 { return 26 + 80 * 52 / 10 }
    return 26 + 78 * 52 / 10
}
fn bubble(i){
    let m = mails[i]
    let size = 52 + m.imp * 62 / 100
    let dx = cos(anim_t * (0.6 + i * 0.07)) * 4.0
    let dy = sin(anim_t * (0.8 + i * 0.09)) * 5.0
    let x = orbit_x(i) + dx
    let y = orbit_y(i) + dy
    let c = vibe_color(m.vibe)
    // the wrapper canvas is 1.66x the bubble (leftover glow headroom, the
    // halos themselves were removed in 0.7.2 — the link blue's halo read as
    // stray circles while the other vibes' were invisible; anchor fractions
    // are re-derived so the BUBBLE CENTRE stays on the preset field point)
    let g = size * 1.66
    let fxg = ((x / 380.0) * (380.0 - size) + size * 0.5 - g * 0.5) / (380.0 - g)
    let fyg = ((y / 560.0) * (560.0 - size) + size * 0.5 - g * 0.5) / (560.0 - g)
    View{width: 380 height: 560 align: Align{x: fxg y: fyg}
        View{width: g height: g flow: Overlay
            GestureView{width: size height: size align: Align{x: 0.5 y: 0.5} on_tap: |x, y| open_mail(i)
                RoundedView{width: size height: size draw_bg +: {color: c border_radius: size / 2.0} flow: Overlay align: Align{x: 0.5 y: 0.5}
                    // radial-gradient feel: broad soft lift + tight core at 34% 30%
                    View{width: size height: size align: Align{x: 0.34 y: 0.30}
                        View{width: size * 0.64 height: size * 0.64 align: Align{x: 0.5 y: 0.5}
                            RoundedView{width: size * 0.64 height: size * 0.64 draw_bg +: {color: #xffffff1c border_radius: size * 0.32}}}}
                    View{width: size height: size align: Align{x: 0.34 y: 0.30}
                        View{width: size * 0.28 height: size * 0.28 align: Align{x: 0.5 y: 0.5}
                            RoundedView{width: size * 0.28 height: size * 0.28 draw_bg +: {color: #xffffff59 border_radius: size * 0.14}}}}
                    View{width: size height: size flow: Down spacing: 2 align: Align{x: 0.5 y: 0.5}
                        Label{text: m.bname draw_text.color: onC draw_text.text_style: theme.font_bold{font_size: 9} align: Align{x: 0.5}}
                        if m.unread {
                            View{width: 4 height: 4 align: Align{x: 0.5}
                                RoundedView{width: 4 height: 4 draw_bg +: {color: onC border_radius: 2.0}}}
                        }
                    }
                }
            }
        }
    }
}
fn orbit_screen(){
    ScrollYView{width: Fill height: Fill flow: Down
        View{width: Fill height: Fit flow: Down spacing: 10 padding: Inset{top: 14 bottom: 36 left: 16 right: 16}
            screen_title("星轨")
            soft_note("气泡大小 = 重要度 · 颜色 = vibe · 点按打开", 11)
            View{width: 380 height: 560 flow: Overlay
                for i in mails.len() {
                    if mails[i].boxed == "" { bubble(i) }
                }
            }
        }
    }
}

// ---- write (tone slider) ------------------------------------------------------
// the drawn slider: visuals first, three tap segments minted LAST so they
// sit above the track for hit testing (late children win in an Overlay)
fn tone_slider(){
    View{width: Fill height: Fit flow: Down spacing: 7
        View{width: Fill height: 28 flow: Overlay
            // base track
            View{width: Fill height: 28 align: Align{x: 0.5 y: 0.5}
                RoundedView{width: 348 height: 6 draw_bg +: {color: paper2 border_radius: 3.0 border_size: 1.0 border_color: line}}}
            // stop dots
            View{width: Fill height: 28 flow: Right
                View{width: 116 height: 28 align: Align{x: 0.5 y: 0.5}
                    RoundedView{width: 8 height: 8 draw_bg +: {color: pick(tone == 0, pinkC, line2) border_radius: 4.0}}}
                View{width: 116 height: 28 align: Align{x: 0.5 y: 0.5}
                    RoundedView{width: 8 height: 8 draw_bg +: {color: pick(tone == 1, pinkC, line2) border_radius: 4.0}}}
                View{width: 116 height: 28 align: Align{x: 0.5 y: 0.5}
                    RoundedView{width: 8 height: 8 draw_bg +: {color: pick(tone == 2, pinkC, line2) border_radius: 4.0}}}
            }
            // knob at the active stop
            View{width: Fill height: 28 flow: Right
                if tone == 0 {
                    View{width: 58 height: 28 align: Align{x: 0.5 y: 0.5}
                        RoundedView{width: 20 height: 20 draw_bg +: {color: ink border_radius: 10.0 border_size: 3.0 border_color: paper3}}}
                } else {
                    View{width: 58 height: 28}
                }
                if tone == 1 {
                    View{width: 116 height: 28 align: Align{x: 0.5 y: 0.5}
                        RoundedView{width: 20 height: 20 draw_bg +: {color: ink border_radius: 10.0 border_size: 3.0 border_color: paper3}}}
                } else {
                    View{width: 116 height: 28}
                }
                if tone == 2 {
                    View{width: 58 height: 28 align: Align{x: 1.0 y: 0.5}
                        RoundedView{width: 20 height: 20 draw_bg +: {color: ink border_radius: 10.0 border_size: 3.0 border_color: paper3}}}
                } else {
                    View{width: 58 height: 28}
                }
                View{width: Fill height: 28}
            }
            // tap zones (minted last = on top)
            View{width: 348 height: 28 flow: Right
                GestureView{width: 116 height: 28 on_tap: |x, y| set_tone(0)
                    View{width: 116 height: 28}}
                GestureView{width: 116 height: 28 on_tap: |x, y| set_tone(1)
                    View{width: 116 height: 28}}
                GestureView{width: 116 height: 28 on_tap: |x, y| set_tone(2)
                    View{width: 116 height: 28}}
            }
        }
        // labels (tappable too — same three stops)
        View{width: 348 height: Fit flow: Right
            GestureView{width: 116 height: 20 on_tap: |x, y| set_tone(0)
                View{width: 116 height: 20 align: Align{x: 0.5 y: 0.5}
                    Label{text: "真诚" draw_text.color: pick(tone == 0, ink, inkSoft) draw_text.text_style.font_size: 9.5}}}
            GestureView{width: 116 height: 20 on_tap: |x, y| set_tone(1)
                View{width: 116 height: 20 align: Align{x: 0.5 y: 0.5}
                    Label{text: "友好" draw_text.color: pick(tone == 1, ink, inkSoft) draw_text.text_style.font_size: 9.5}}}
            GestureView{width: 116 height: 20 on_tap: |x, y| set_tone(2)
                View{width: 116 height: 20 align: Align{x: 0.5 y: 0.5}
                    Label{text: "正式" draw_text.color: pick(tone == 2, ink, inkSoft) draw_text.text_style.font_size: 9.5}}}
        }
    }
}
fn send_button(){
    // idle: neon 发送 / sending: paper / sent: mint 已随波寄出 / failed: retry
    if send_state == "sent" {
        RoundedView{width: Fill height: 46 draw_bg +: {color: mintC border_radius: 23.0} align: Align{x: 0.5 y: 0.5}
            View{width: Fit height: Fit flow: Right spacing: 7 align: Align{y: 0.5}
                View{width: 14 height: 14 align: Align{x: 0.5 y: 0.5}
                    check_icon(onC, 14)}
                Label{text: "已随波寄出" draw_text.color: onC draw_text.text_style: theme.font_bold{font_size: 13}}
            }
        }
    } else {
        if send_state == "failed" {
            GestureView{width: Fill height: 46 on_tap: |x, y| retry_send()
                RoundedView{width: Fill height: 46 draw_bg +: {color: failBg border_radius: 23.0 border_size: 1.0 border_color: failT} align: Align{x: 0.5 y: 0.5}
                    View{width: Fit height: Fit flow: Right spacing: 7 align: Align{y: 0.5}
                        View{width: 14 height: 14 align: Align{x: 0.5 y: 0.5}
                            refresh_icon(failT, 14, failBg)}
                        Label{text: "发送失败 · 点按重试" draw_text.color: failT draw_text.text_style: theme.font_bold{font_size: 12.5}}
                    }
                }
            }
        } else {
            if send_state == "sending" {
                RoundedView{width: Fill height: 46 draw_bg +: {color: paper3 border_radius: 23.0 border_size: 1.0 border_color: line2} align: Align{x: 0.5 y: 0.5}
                    Label{text: "发送中…" draw_text.color: sendIdleT draw_text.text_style.font_size: 12.5}
                }
            } else {
                GestureView{width: Fill height: 46 on_tap: |x, y| do_send()
                    RoundedView{width: Fill height: 46 draw_bg +: {color: neonC border_radius: 23.0} align: Align{x: 0.5 y: 0.5}
                        View{width: Fit height: Fit flow: Right spacing: 7 align: Align{y: 0.5}
                            View{width: 14 height: 14 align: Align{x: 0.5 y: 0.5}
                                send_icon(onC, 14)}
                            Label{text: "发送" draw_text.color: onC draw_text.text_style: theme.font_bold{font_size: 13}}
                        }
                    }
                }
            }
        }
    }
}
fn write_screen(){
    ScrollYView{width: Fill height: Fill flow: Down
        View{width: Fill height: Fit flow: Down spacing: 12 padding: Inset{top: 14 bottom: 36 left: 16 right: 16}
            screen_title("写信")
            RoundedView{width: Fill height: Fit padding: Inset{top: 16 bottom: 16 left: 16 right: 16}
                draw_bg +: {color: paper3 border_radius: 20.0 border_size: 1.0 border_color: line} flow: Down spacing: 13
                // 收件人 / 主题 — transparent fields on the card (reference style)
                View{width: Fill height: Fit flow: Right spacing: 10 align: Align{y: 0.5}
                    Label{width: 48 text: "收件人" draw_text.color: inkSoft draw_text.text_style.font_size: 11}
                    TextInput{width: Fill height: 30 text: to_input empty_text: "someone@mail.io" on_change: |t| to_input = t
                        draw_bg +: {color: #x00000000 color_hover: #x00000000 color_focus: #x00000000 color_down: #x00000000 color_empty: #x00000000 color_disabled: #x00000000 border_size: 0.0}
                        draw_text +: {color: ink text_style.font_size: 12.5}}
                }
                RoundedView{width: Fill height: 1 draw_bg +: {color: line border_radius: 0.0}}
                View{width: Fill height: Fit flow: Right spacing: 10 align: Align{y: 0.5}
                    Label{width: 48 text: "主题" draw_text.color: inkSoft draw_text.text_style.font_size: 11}
                    TextInput{width: Fill height: 30 text: subject_input empty_text: "主题" on_change: |t| subject_input = t
                        draw_bg +: {color: #x00000000 color_hover: #x00000000 color_focus: #x00000000 color_down: #x00000000 color_empty: #x00000000 color_disabled: #x00000000 border_size: 0.0}
                        draw_text +: {color: ink text_style.font_size: 12.5}}
                }
                RoundedView{width: Fill height: 1 draw_bg +: {color: line border_radius: 0.0}}
                // tone slider
                View{width: Fill height: Fit flow: Down spacing: 8
                    View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                        Label{width: Fill text: "语气滑杆 · AI 实时改写" draw_text.color: inkSoft draw_text.text_style.font_size: 11}
                        RoundedView{width: Fit height: Fit padding: Inset{top: 3 bottom: 3 left: 10 right: 10}
                            draw_bg +: {color: pinkC border_radius: 11.0}
                            Label{text: tone_label() draw_text.color: onC draw_text.text_style.font_size: 10}}
                    }
                    tone_slider()
                }
                // preview
                RoundedView{width: Fill height: Fit padding: Inset{top: 14 bottom: 14 left: 14 right: 14}
                    draw_bg +: {color: paper2 border_radius: 16.0} flow: Down spacing: 7
                    View{width: Fill height: Fit flow: Right spacing: 6 align: Align{y: 0.5}
                        View{width: 12 height: 12 align: Align{x: 0.5 y: 0.5}
                            spark_icon(inkSoft, 11)}
                        if tone_src == "ai" {
                            Label{width: Fill text: pick(ai_model == "", "模型改写", ai_model) draw_text.color: inkSoft draw_text.text_style.font_size: 9.5}
                        } else {
                            if tone_src == "asking" {
                                Label{width: Fill text: "模型改写中…" draw_text.color: inkSoft draw_text.text_style.font_size: 9.5}
                            } else {
                                Label{width: Fill text: "回信预览" draw_text.color: inkSoft draw_text.text_style.font_size: 9.5}
                            }
                        }
                    }
                    Label{width: Fill text: preview_text() draw_text.color: pick(tone_src == "asking", inkDim, ink) draw_text.text_style.font_size: 12.5}
                    if tone_src == "unavailable" {
                        Label{width: Fill text: tone_note draw_text.color: failT draw_text.text_style.font_size: 9.5}
                    } else {
                        if tone_note != "" {
                            Label{width: Fill text: tone_note draw_text.color: inkDim draw_text.text_style.font_size: 9.5}
                        }
                    }
                }
                send_button()
                if send_state == "failed" {
                    Label{width: Fill text: send_error_msg draw_text.color: failT draw_text.text_style.font_size: 9.5}
                }
            }
        }
    }
}

// ---- set (我的) ----------------------------------------------------------------
fn theme_mode_chip(mode, label){
    let act = themeMode == mode
    ButtonFlat{height: 28 padding: Inset{left: 11 right: 11} text: label on_click: || apply_theme_mode(mode)
        draw_bg +: {color: pick(act, paper2, #x00000000) color_hover: paper2 color_down: paper2 border_radius: 14.0 border_size: 1.0 border_color: pick(act, line2, line)}
        draw_text +: {color: pick(act, ink, inkSoft) text_style.font_size: 10.5}}
}
fn capability_row(cap, why){
    View{width: Fill height: Fit flow: Right spacing: 10 align: Align{y: 0.5} padding: Inset{top: 5 bottom: 5}
        RoundedView{width: Fit height: Fit padding: Inset{top: 3 bottom: 3 left: 8 right: 8}
            draw_bg +: {color: mintC border_radius: 7.0}
            Label{text: cap draw_text.color: onC draw_text.text_style.font_size: 10}}
        Label{width: Fill text: why draw_text.color: inkSoft draw_text.text_style.font_size: 11}
    }
}
fn set_screen(){
    ScrollYView{width: Fill height: Fill flow: Down
        View{width: Fill height: Fit flow: Down spacing: 12 padding: Inset{top: 14 bottom: 36 left: 16 right: 16}
            screen_title("设置")
            // 外观主题
            RoundedView{width: Fill height: Fit padding: Inset{top: 15 bottom: 15 left: 16 right: 16}
                draw_bg +: {color: paper3 border_radius: 20.0 border_size: 1.0 border_color: line} flow: Down spacing: 10
                View{width: Fill height: Fit flow: Right spacing: 10 align: Align{y: 0.5}
                    View{width: Fill height: Fit flow: Down spacing: 2
                        Label{text: "外观主题" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 12.5}}
                        Label{text: "暖纸亮色 / 炭黑暗色" draw_text.color: inkSoft draw_text.text_style.font_size: 10.5}
                    }
                    // light/dark quick toggle pill
                    GestureView{width: 68 height: 36 on_tap: |x, y| toggle_theme()
                        RoundedView{width: 68 height: 36 draw_bg +: {color: ink border_radius: 18.0} flow: Overlay
                            View{width: 68 height: 36 align: pick(themeLight, Align{x: 0.0 y: 0.5}, Align{x: 1.0 y: 0.5})
                                View{width: 36 height: 36 align: Align{x: 0.5 y: 0.5}
                                    RoundedView{width: 28 height: 28 draw_bg +: {color: paper border_radius: 14.0} align: Align{x: 0.5 y: 0.5}
                                        if themeLight {
                                            sun_icon(ink, 13)
                                        } else {
                                            moon_icon(ink, 13, paper)
                                        }}}
                            }
                        }
                    }
                }
                View{width: Fill height: Fit flow: Right spacing: 6
                    theme_mode_chip("system", "跟随系统")
                    theme_mode_chip("light", "亮色")
                    theme_mode_chip("dark", "暗色")
                    View{width: Fill height: 1}
                    Label{text: theme_now_note() draw_text.color: inkSoft draw_text.text_style.font_size: 9.5}
                }
            }
            // OctoSense 能力声明
            RoundedView{width: Fill height: Fit padding: Inset{top: 15 bottom: 13 left: 16 right: 16}
                draw_bg +: {color: paper3 border_radius: 20.0 border_size: 1.0 border_color: line} flow: Down spacing: 5
                View{width: Fill height: Fit flow: Down spacing: 2
                    Label{text: "OctoSense 能力声明" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 12.5}}
                    Label{text: "最小权限 · 密码由平台保管" draw_text.color: inkSoft draw_text.text_style.font_size: 10.5}
                }
                capability_row("mail", "读取与发送邮件(host service)")
                capability_row("storage", "保存 vibe 标注与偏好(4 MiB)")
                capability_row("model", "AI 摘要与语气改写")
                Label{width: Fill text: "刻意不声明:net / web / camera / location —— 不需要" draw_text.color: inkDim draw_text.text_style.font_size: 9.5}
            }
            // 邮箱账号 (real host-service state)
            RoundedView{width: Fill height: Fit padding: Inset{top: 15 bottom: 13 left: 16 right: 16}
                draw_bg +: {color: paper3 border_radius: 20.0 border_size: 1.0 border_color: line} flow: Down spacing: 8
                View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                    View{width: 15 height: 15 align: Align{x: 0.5 y: 0.5}
                        mail_icon(inkSoft, 15, paper3)}
                    Label{width: Fill text: "邮箱账号" draw_text.color: ink draw_text.text_style.font_size: 12.5}
                    if mail_link == "live" {
                        Label{text: "已连接" draw_text.color: chipFgCalm draw_text.text_style.font_size: 10.5}
                    } else {
                        if mail_link == "no_account" {
                            Label{text: "未添加" draw_text.color: inkSoft draw_text.text_style.font_size: 10.5}
                        } else {
                            Label{text: "不可用" draw_text.color: inkDim draw_text.text_style.font_size: 10.5}
                        }
                    }
                }
                if mail_link == "live" {
                    Label{width: Fill text: account_addr + " · 已通过 OctoSense 邮件服务登录" draw_text.color: inkSoft draw_text.text_style.font_size: 10.5}
                    Label{width: Fill text: banner_line() draw_text.color: inkDim draw_text.text_style.font_size: 9.5}
                } else {
                    Label{width: Fill text: banner_line() draw_text.color: inkSoft draw_text.text_style.font_size: 10.5}
                }
                View{width: Fill height: Fit flow: Right spacing: 8
                    if mail_link == "no_account" {
                        ButtonFlat{height: 30 padding: Inset{left: 12 right: 12} text: "添加账号" on_click: || mail_add_account()
                            draw_bg +: {color: ink color_hover: ink color_down: inkSoft border_radius: 15.0 border_size: 0.0}
                            draw_text +: {color: paper text_style.font_size: 11}}
                    } else {
                        if mail_link == "live" {
                            ButtonFlat{height: 30 padding: Inset{left: 12 right: 12} text: "刷新" on_click: || mail_refresh()
                                draw_bg +: {color: #x00000000 color_hover: paper2 color_down: paper2 border_radius: 15.0 border_size: 1.0 border_color: line2}
                                draw_text +: {color: ink text_style.font_size: 11}}
                            ButtonFlat{height: 30 padding: Inset{left: 12 right: 12} text: pick(mail_arm, "确认断开?", "断开") on_click: || mail_disconnect()
                                draw_bg +: {color: pick(mail_arm, failBg, #x00000000) color_hover: failBg color_down: failBg border_radius: 15.0 border_size: 1.0 border_color: pick(mail_arm, failT, line2)}
                                draw_text +: {color: pick(mail_arm, failT, ink) text_style.font_size: 11}}
                        } else {
                            ButtonFlat{height: 30 padding: Inset{left: 12 right: 12} text: "重试连接" on_click: || mail_refresh()
                                draw_bg +: {color: #x00000000 color_hover: paper2 color_down: paper2 border_radius: 15.0 border_size: 1.0 border_color: line2}
                                draw_text +: {color: ink text_style.font_size: 11}}
                        }
                    }
                    View{width: Fill height: 1}
                    if archived_cnt() > 0 {
                        ButtonFlat{height: 30 padding: Inset{left: 12 right: 12} text: "恢复归档 " + archived_cnt() + " 封" on_click: || restore_archived()
                            draw_bg +: {color: #x00000000 color_hover: paper2 color_down: paper2 border_radius: 15.0 border_size: 1.0 border_color: line2}
                            draw_text +: {color: ink text_style.font_size: 11}}
                    }
                }
                RoundedView{width: Fill height: 1 draw_bg +: {color: line border_radius: 0.0}}
                if restored_note != "" {
                    Label{width: Fill text: restored_note draw_text.color: chipFgCalm draw_text.text_style.font_size: 9.5}
                }
                View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                    Label{width: Fill text: "练习:模拟发送失败" draw_text.color: ink draw_text.text_style.font_size: 11.5}
                    ButtonFlat{height: 26 padding: Inset{left: 10 right: 10} text: pick(simulate_outage, "已开启", "已关闭") on_click: || toggle_outage()
                        draw_bg +: {color: pick(simulate_outage, failBg, paper2) color_hover: paper2 color_down: paper2 border_radius: 13.0 border_size: 1.0 border_color: pick(simulate_outage, failT, line2)}
                        draw_text +: {color: pick(simulate_outage, failT, inkSoft) text_style.font_size: 10}}
                }
            }
            // 账号 identity card
            RoundedView{width: Fill height: Fit padding: Inset{top: 14 bottom: 14 left: 16 right: 16}
                draw_bg +: {color: paper3 border_radius: 20.0 border_size: 1.0 border_color: line} flow: Down spacing: 4
                Label{text: "账号" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 12.5}}
                View{width: Fill height: Fit flow: Right spacing: 11 align: Align{y: 0.5}
                    View{width: 34 height: 34 align: Align{x: 0.5 y: 0.5}
                        aura_joy(34)}
                    View{width: Fill height: Fit flow: Down spacing: 2
                        if mail_link == "live" {
                            Label{text: account_addr draw_text.color: ink draw_text.text_style.font_size: 11.5}
                            Label{text: "已通过 OctoSense 邮件服务登录" draw_text.color: inkSoft draw_text.text_style.font_size: 9.5}
                        } else {
                            Label{text: "me@octomail.io" draw_text.color: ink draw_text.text_style.font_size: 11.5}
                            Label{text: "演示模式 · 未连接邮件服务" draw_text.color: inkSoft draw_text.text_style.font_size: 9.5}
                        }
                    }
                }
                Label{width: Fill text: "VibeMail 0.7.2 · vibemail · 有情绪的邮件" draw_text.color: inkDim draw_text.text_style.font_size: 9}
            }
        }
    }
}

// ---- bottom nav -----------------------------------------------------------
fn nav_item(label, target){
    let act = screen == target && open_idx < 0
    GestureView{width: Fit height: Fit on_tap: |x, y| go(target)
        RoundedView{width: Fit height: Fit padding: Inset{top: 6 bottom: 6 left: 16 right: 16}
            draw_bg +: {color: pick(act, ink, #x00000000) border_radius: 19.0}
            View{width: Fit height: Fit flow: Down spacing: 2 align: Align{x: 0.5}
                View{width: 16 height: 16 align: Align{x: 0.5 y: 0.5}
                    if target == "inbox" { tray_icon(pick(act, paper, inkSoft), 16) } else {
                    if target == "orbit" { orbit_icon(pick(act, paper, inkSoft), 16) } else {
                    if target == "write" { pen_icon(pick(act, paper, inkSoft), 16, pick(act, ink, glass)) } else {
                    sliders_icon(pick(act, paper, inkSoft), 16) }}}}
                Label{text: label draw_text.color: pick(act, paper, inkSoft) draw_text.text_style.font_size: 9}
            }
        }
    }
}
fn bottom_nav(){
    // glass pill docked at the bottom of the phone column — in FLOW, not an
    // overlay: taps in this runtime reach EVERY overlapping GestureView, so
    // a floating pill over the list would also open the card beneath it
    View{width: Fill height: Fit align: Align{x: 0.5} padding: Inset{top: 8 bottom: 16}
        RoundedView{width: Fit height: Fit padding: Inset{top: 5 bottom: 5 left: 7 right: 7}
            draw_bg +: {color: glass border_radius: 27.0 border_size: 1.0 border_color: line}
            View{width: Fit height: Fit flow: Right spacing: 2 align: Align{y: 0.5}
                nav_item("收件箱", "inbox")
                nav_item("星轨", "orbit")
                nav_item("写信", "write")
                nav_item("我的", "set")
            }
        }
    }
}

// ---- root -----------------------------------------------------------------
// ONE on_render root mints the whole window (probed: separate on_render
// underlays composite above later UI, so layers must share a single mint
// with the ground first and the nav last): full-window paper ground, four
// dim side auras framing the phone on wide desktop windows, then the 412px
// phone column — status bar, screen bodies, and the floating nav pill on
// top. The static SolidView ground only shows if the app fails to boot.
SolidView{width: Fill height: Fill flow: Overlay draw_bg.color: #xeaeae3
    appc := View{width: Fill height: Fill flow: Overlay on_render: || {
        // full-window theme ground
        RoundedView{width: Fill height: Fill draw_bg +: {color: paper border_radius: 0.0}}
        // phone column, centred — OPAQUE ground: the design keeps its glow
        // per mail card (and behind the phone on the marketing page), never
        // as circles bleeding through the content, so the column blocks the
        // window ground completely
        View{width: Fill height: Fill align: Align{x: 0.5 y: 0.5}
            View{width: 412 height: Fill flow: Overlay
                RoundedView{width: Fill height: Fill draw_bg +: {color: paper border_radius: 0.0}}
                View{width: Fill height: Fill flow: Down
                    // active screen (scrolls itself)
                    View{width: Fill height: Fill flow: Overlay
                        if open_idx >= 0 {
                            detail_screen()
                        } else {
                            if screen == "inbox" { inbox_screen() }
                            if screen == "orbit" { orbit_screen() }
                            if screen == "write" { write_screen() }
                            if screen == "set" { set_screen() }
                        }
                    }
                    // nav pill docked below the screen area (in flow)
                    bottom_nav()
                }
            }
        }
    }}
}
