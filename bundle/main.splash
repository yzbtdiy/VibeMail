                    View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5} padding: Inset{top: 11 bottom: 11 left: 16 right: 16}
                        Label{width: 44 text: "主题" draw_text.color: ink45 draw_text.text_style.font_size: 10.5}
