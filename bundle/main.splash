// agentic-mail — four-screen script app, warm light theme per blackboard #8.
// Palette (exact hex from the reference): warm beige ground #FAF3EC, white
// cards, orange AI banner #F0562D -> #F58A3C, four bottom tabs. All mock.

// ---- state -------------------------------------------------------------
let screen = "inbox"          // inbox | read | write | todo | me
let current = 0

let mails = [
    {who: "张明" role: "财务周报" mono: "张" hue: 0 tag: "紧急" time: "09:12" unread: true group: "urgent"
     subject: "三季度营收复核——附件含汇报材料"
     preview: "财务确认第三季度达成计划的 104%,两项风险需周五前签署意见…"
     body: "各位好:\n\n附上三季度营收复核材料。本季度营收达成计划的 104%,主要由企业级续约与两个新行业客户贡献。\n\n材料中标出了两项风险:其一,大客户集中度进一步上升;其二,回款周期较上季度延长 5 天。\n\n两项风险均需管理层在周五董事会前给出处置意见,详见材料第 4 页。"
     points: ["营收达成计划的 104%,企业续约为主要贡献", "大客户集中度上升,为第一风险项", "回款周期延长 5 天,需财务跟进", "两项风险需周五董事会前签署意见"]
     action: "建议行动:周五前审阅第 4 页风险处置页并签署意见。"}
    {who: "陈晨" role: "IT 支持" mono: "陈" hue: 0 tag: "紧急" time: "10:05" unread: true group: "urgent"
     subject: "VPN 证书今晚轮换"
     preview: "旧证书 23:00 失效,请及时更新客户端,出差同事建议提前…"
     body: "全体:\n\nVPN 根证书今晚 23:00 起轮换,旧证书将失效。请在此之前打开客户端完成自动更新;出差同事建议提前一小时操作。\n\n如遇握手失败,重新导入附件中的根证书即可。"
     points: ["VPN 根证书 23:00 轮换", "旧证书届时失效,客户端需更新", "出差同事建议提前一小时"]
     action: "建议行动:今晚 22:00 前更新客户端。"}
    {who: "李强" role: "平台团队" mono: "李" hue: 1 tag: "今日" time: "08:47" unread: false group: "later"
     subject: "发布窗口调整至 22:00"
     preview: "今晚的发布因数据库维护推迟两小时,值班安排不变…"
     body: "团队:\n\n今晚的发布窗口因数据库主从切换维护,由 20:00 调整至 22:00。变更单已审批,值班表不变。\n\n除非你在值班,否则无需任何操作;次日早晨的冒烟测试照常进行。"
     points: ["发布窗口 20:00 → 22:00,推迟两小时", "原因是数据库主从切换维护", "值班安排不变,无需额外操作"]
     action: "建议行动:值班同学确认 22:00 在线即可。"}
    {who: "赵敏" role: "客服中心" mono: "赵" hue: 1 tag: "今日" time: "08:12" unread: false group: "later"
     subject: "会员权益续期提醒"
     preview: "企业会员权益将于月底到期,续期享 9 折并可保留优先通道…"
     body: "您好:\n\n贵司企业会员权益将于本月 30 日到期。本周期内续期可享 9 折优惠,并保留历史工单优先通道。\n\n如需发票抬头变更,请在续期时一并备注。"
     points: ["会员权益本月 30 日到期", "续期享 9 折并保留优先通道", "发票变更需随续期备注"]
     action: "建议行动:本周内决定是否续期。"}
    {who: "王蕾" role: "设计公会" mono: "王" hue: 2 tag: "稍后" time: "昨天" unread: false group: "later"
     subject: "每周界面研究摘要"
     preview: "三篇锁屏排版文章与两个摘要式布局案例,下周例会评审…"
     body: "本周精选:\n\n1. 锁屏排版字体的可读性研究(3 篇);\n2. 摘要式信息流布局的两个案例研究;\n3. 下周讨论主题:重要度色彩编码的语义一致性。"
     points: ["锁屏排版字体研究 3 篇", "摘要式信息流布局案例 2 个", "下周主题:重要度色彩语义"]
     action: "建议行动:有兴趣可标记下周讨论。"}
    {who: "孙浩" role: "市场部" mono: "孙" hue: 2 tag: "稍后" time: "周一" unread: false group: "later"
     subject: "品牌升级方案初稿"
     preview: "三套视觉方向初稿,附对比说明,下周例会逐套评审…"
     body: "团队:\n\n品牌升级初稿已完成三套视觉方向:稳健延续、锐意对比、柔和过渡。每套含主色、字阶与图标样式的对比说明。\n\n下周例会逐套评审,欢迎提前批注。"
     points: ["三套视觉方向初稿已完成", "每套含主色/字阶/图标对比", "下周例会逐套评审"]
     action: "建议行动:会前完成初步倾向标注。"}
]

let draft_input = ""
let draft_text = ""
let tone = "正式"

let todos = [
    {done: true  when: "今天" text: "签署三季度风险处置意见" from: "三季度营收复核" due: "周五 18:00"}
    {done: false when: "今天" text: "确认 22:00 发布窗口值班" from: "发布窗口调整" due: "今天 21:00"}
    {done: false when: "今天" text: "回复设计公会下周议题" from: "每周界面研究摘要" due: "今天 17:00"}
    {done: false when: "明天" text: "审阅摘要式布局案例" from: "每周界面研究摘要" due: "明天 10:00"}
]

// ---- palette (warm light, #8 exact hex) ----------------------------------
let ground = #xFAF3EC      // warm beige page
let card   = #xFFFFFFFF    // white cards
let search = #xF2EDE6      // search capsule
let orange = #xF0562D      // brand orange / selected tab / done
let orange2 = #xF58A3C     // gradient end
let ink    = #x1A1A1A      // primary text
let sub    = #x9A9A94      // secondary text
let grey   = #x8A8A85      // later-tag text
let aiink  = #xFDE8DD      // light orange summary card
let aipurple = #x6C5CE7
let teal   = #x3FBFAE

// The script runtime has no hsv(); the reference avatar colours are fixed.
fn mono_color(m){
    if m.hue == 0 { return #xE8543F }
    if m.hue == 1 { return #xF5B830 }
    return #x8B7BE8
}
// The widget DSL has no ternary in property position; pickers are plain fns.
fn pick(c, a, b){ if c { return a } return b }

// ---- navigation ---------------------------------------------------------
fn go(s){ screen = s; ui.body.render() }
fn open_mail(i){ current = i; screen = "read"; ui.body.render() }

// ---- screen 1: inbox ----------------------------------------------------
fn greeting(){
    View{width: Fill height: Fit flow: Right spacing: 10 align: Align{y: 0.5}
        View{width: Fill height: Fit flow: Down spacing: 2
            Label{width: Fill text: "早上好,小林" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 24}}
            Label{width: Fill text: "今天是 9 月 28 日 · 有 2 封重要邮件待处理" draw_text.color: sub draw_text.text_style.font_size: 12}
        }
        RoundedView{width: 60 height: 60 draw_bg +: {color: card border_radius: 30.0} align: Align{x: 0.5 y: 0.5}
            RoundedView{width: 54 height: 54 draw_bg +: {color: teal border_radius: 27.0} align: Align{x: 0.5 y: 0.5}
                Label{text: "林" draw_text.color: #xffffffff draw_text.text_style: theme.font_bold{font_size: 20}}
            }
        }
    }
}

fn search_bar(){
    RoundedView{width: Fill height: Fit padding: Inset{top: 10 bottom: 10 left: 14 right: 14} draw_bg +: {color: search border_radius: 22.0}
        View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
            Image{width: 16 height: 16 src: http_resource("{{assets}}/assets/search-grey.svg") fit: ImageFit.CropToFill}
            Label{width: Fill text: "搜索邮件" draw_text.color: sub draw_text.text_style.font_size: 13}
        }
    }
}

fn banner(){
    RoundedView{width: Fill height: Fit padding: Inset{top: 18 bottom: 18 left: 20 right: 20} draw_bg +: {g1: orange g2: orange2 border_radius: 28.0} flow: Down spacing: 8
        View{width: Fill height: Fit flow: Right spacing: 12 align: Align{y: 0.5}
            Image{width: 40 height: 40 src: http_resource("{{assets}}/assets/ai-star.svg") fit: ImageFit.CropToFill}
            View{width: Fill height: Fit flow: Down spacing: 3
                Label{width: Fill text: "AI 分诊" draw_text.color: #xffffffff draw_text.text_style: theme.font_bold{font_size: 20}}
                Label{width: Fill text: "3 封重要邮件,建议今天回复" draw_text.color: #xffffffff draw_text.text_style.font_size: 12}
            }
        }
    }
}

fn tag_pill(t){
    if t == "紧急" {
        RoundedView{width: Fit height: Fit padding: Inset{top: 3 bottom: 3 left: 9 right: 9} draw_bg +: {color: #xF04B4B border_radius: 10.0}
            Label{text: t draw_text.color: #xffffffff draw_text.text_style.font_size: 10}}
    } else {
        if t == "今日" {
            RoundedView{width: Fit height: Fit padding: Inset{top: 3 bottom: 3 left: 9 right: 9} draw_bg +: {color: #xF7D77E border_radius: 10.0}
                Label{text: t draw_text.color: #x8A6A10 draw_text.text_style.font_size: 10}}
        } else {
            RoundedView{width: Fit height: Fit padding: Inset{top: 3 bottom: 3 left: 9 right: 9} draw_bg +: {color: #xEAE8E3 border_radius: 10.0}
                Label{text: t draw_text.color: grey draw_text.text_style.font_size: 10}}
        }
    }
}

fn section_header(icon, title){
    View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5} padding: Inset{top: 6 bottom: 2}
        Image{width: 15 height: 15 src: http_resource("{{assets}}/assets/" + icon) fit: ImageFit.CropToFill}
        Label{width: Fill text: title draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
        Label{text: "全部 >" draw_text.color: sub draw_text.text_style.font_size: 12}
    }
}

fn mail_card(i){
    let m = mails[i]
    RoundedView{width: Fill height: Fit padding: Inset{top: 14 bottom: 14 left: 16 right: 16} draw_bg +: {color: card border_radius: 20.0}
        GestureView{width: Fill height: Fit on_tap: |x, y| open_mail(i)
            View{width: Fill height: Fit flow: Right spacing: 14 align: Align{y: 0.5}
                RoundedView{width: 56 height: 56 draw_bg +: {color: mono_color(m) border_radius: 28.0} align: Align{x: 0.5 y: 0.5}
                    Label{text: m.mono draw_text.color: #xffffffff draw_text.text_style: theme.font_bold{font_size: 20}}
                }
                View{width: Fill height: Fit flow: Down spacing: 4
                    View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                        Label{width: Fill text: m.who + " · " + m.role draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 13}}
                        Label{text: m.time draw_text.color: sub draw_text.text_style.font_size: 11}
                    }
                    View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                        if m.unread { RoundedView{width: 7 height: 7 draw_bg +: {color: orange border_radius: 4.0} } }
                        Label{width: Fill text: m.subject draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 14}}
                        tag_pill(m.tag)
                    }
                    Label{width: Fill text: m.preview draw_text.color: sub draw_text.text_style.font_size: 12}
                }
            }
        }
    }
}

fn inbox_screen(){
    View{width: Fill height: Fit flow: Down spacing: 12
        greeting()
        search_bar()
        banner()
        section_header("flag-red.svg", "重要邮件")
        for i in mails.len() {
            if mails[i].group == "urgent" { mail_card(i) }
        }
        section_header("clock-purple.svg", "稍后处理")
        for i in mails.len() {
            if mails[i].group == "later" { mail_card(i) }
        }
    }
}

// ---- screen 2: reading --------------------------------------------------
fn ai_summary(m){
    RoundedView{width: Fill height: Fit padding: Inset{top: 14 bottom: 14 left: 16 right: 16} draw_bg +: {color: aiink border_radius: 20.0} flow: Down spacing: 8
        View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
            Image{width: 18 height: 18 src: http_resource("{{assets}}/assets/ai-star-orange.svg") fit: ImageFit.CropToFill}
            Label{width: Fill text: "AI 摘要 · 要点提炼" draw_text.color: orange draw_text.text_style: theme.font_bold{font_size: 13}}
        }
        for p in m.points {
            View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                Label{text: "·" draw_text.color: orange draw_text.text_style.font_size: 12}
                Label{width: Fill text: p draw_text.color: ink draw_text.text_style.font_size: 13}
            }
        }
        Label{width: Fill text: m.action draw_text.color: ink draw_text.text_style.font_size: 12}
    }
}

fn read_screen(m){
    View{width: Fill height: Fit flow: Down spacing: 12
        View{width: Fill height: Fit flow: Right spacing: 10 align: Align{y: 0.5}
            ButtonFlat{text: "‹ 返回" on_click: || go("inbox")
                draw_bg +: {color: card color_hover: search color_down: search border_radius: 18.0 border_size: 0.0}
                draw_text +: {color: ink color_hover: ink color_down: ink}}
            Label{width: Fill text: "邮件阅读" draw_text.color: sub draw_text.text_style.font_size: 12}
        }
        RoundedView{width: Fill height: Fit padding: Inset{top: 16 bottom: 16 left: 18 right: 18} draw_bg +: {color: card border_radius: 22.0} flow: Down spacing: 12
            View{width: Fill height: Fit flow: Right spacing: 12 align: Align{y: 0.5}
                RoundedView{width: 54 height: 54 draw_bg +: {color: mono_color(m) border_radius: 27.0} align: Align{x: 0.5 y: 0.5}
                    Label{text: m.mono draw_text.color: #xffffffff draw_text.text_style: theme.font_bold{font_size: 20}}
                }
                View{width: Fill height: Fit flow: Down spacing: 2
                    Label{width: Fill text: m.who + " · " + m.role draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                    Label{width: Fill text: m.time draw_text.color: sub draw_text.text_style.font_size: 11}
                }
            }
            Label{width: Fill text: m.subject draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}}
            Label{width: Fill text: m.body draw_text.color: ink draw_text.text_style.font_size: 14}
        }
        ai_summary(m)
        View{width: Fill height: Fit flow: Right spacing: 8 padding: Inset{top: 4}
            ButtonFlat{width: Fill text: "回复" on_click: || go("write")
                draw_bg +: {color: orange color_hover: orange color_down: orange border_radius: 18.0 border_size: 0.0}
                draw_text +: {color: #xffffffff}}
            ButtonFlat{width: Fill text: "转发" on_click: || go("write")
                draw_bg +: {color: card color_hover: search color_down: search border_radius: 18.0 border_size: 0.0}
                draw_text +: {color: ink}}
            ButtonFlat{width: Fill text: "归档" on_click: || go("inbox")
                draw_bg +: {color: card color_hover: search color_down: search border_radius: 18.0 border_size: 0.0}
                draw_text +: {color: ink}}
        }
    }
}

// ---- screen 3: AI drafting ----------------------------------------------
fn set_tone(t){ tone = t; ui.body.render() }
fn regen(){
    let ask = draft_input
    if ask == "" { ask = "一封通用商务邮件" }
    draft_text = "(草稿 · " + tone + ")\n\n你好:\n\n关于「" + ask + "」,说明如下:本次沟通意在同步进展并确认下一步安排。如有疑问,欢迎随时回复讨论。\n\n顺祝商祺。"
    ui.body.render()
}
fn insert_draft(){
    if draft_text == "" { regen() }
    go("read")
}

fn write_screen(){
    View{width: Fill height: Fit flow: Down spacing: 12
        Label{width: Fill text: "AI 起草" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 22}}
        RoundedView{width: Fill height: Fit padding: Inset{top: 4 bottom: 4 left: 4 right: 4} draw_bg +: {color: card border_radius: 20.0}
            TextInput{width: Fill height: 84 empty_text: "告诉 AI 你想写什么…" on_change: |t| draft_input = t
                draw_bg +: {color: card color_hover: card color_focus: search color_empty: card border_radius: 20.0}
                draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: sub color_empty_hover: sub}}
        }
        if draft_text != "" {
            RoundedView{width: Fill height: Fit padding: Inset{top: 12 bottom: 12 left: 16 right: 16} draw_bg +: {color: card border_radius: 20.0} flow: Down spacing: 6
                Label{width: Fill text: "已生成草稿(可编辑)" draw_text.color: orange draw_text.text_style.font_size: 12}
                TextInput{width: Fill height: Fit text: draft_text on_change: |t| draft_text = t
                    draw_bg +: {color: #x00000000 color_hover: #x00000000 color_focus: #x00000000 border_radius: 8.0}
                    draw_text +: {color: ink color_hover: ink color_focus: ink}}
            }
        }
        Label{width: Fill text: "语气" draw_text.color: sub draw_text.text_style.font_size: 12}
        View{width: Fill height: Fit flow: Right spacing: 8
            for t in ["正式", "友好", "简洁"] {
                ButtonFlat{text: t on_click: || set_tone(t)
                    draw_bg +: {color: pick(t == tone, orange, card) color_hover: search color_down: card border_radius: 18.0 border_size: 0.0}
                    draw_text +: {color: pick(t == tone, #xffffffff, ink)}}
            }
        }
        View{width: Fill height: Fit flow: Right spacing: 8
            ButtonFlat{width: Fill text: "重新生成" on_click: || regen()
                draw_bg +: {color: card color_hover: search color_down: card border_radius: 18.0 border_size: 0.0}
                draw_text +: {color: ink}}
            ButtonFlat{width: Fill text: "插入草稿" on_click: || insert_draft()
                draw_bg +: {color: orange color_hover: orange color_down: orange border_radius: 18.0 border_size: 0.0}
                draw_text +: {color: #xffffffff}}
        }
    }
}

// ---- screen 4: todos ----------------------------------------------------
fn toggle(i){ todos[i].done = !todos[i].done; ui.body.render() }

fn todo_row(i){
    let t = todos[i]
    RoundedView{width: Fill height: Fit padding: Inset{top: 12 bottom: 12 left: 16 right: 16} draw_bg +: {color: card border_radius: 18.0}
        GestureView{width: Fill height: Fit on_tap: |x, y| toggle(i)
            View{width: Fill height: Fit flow: Right spacing: 12 align: Align{y: 0.5}
                RoundedView{width: 24 height: 24 draw_bg +: {color: pick(t.done, orange, #xEAE8E3) border_radius: 12.0} align: Align{x: 0.5 y: 0.5}
                    if t.done { Label{text: "✓" draw_text.color: #xffffffff draw_text.text_style.font_size: 12} }
                }
                View{width: Fill height: Fit flow: Down spacing: 3
                    Label{width: Fill text: t.text draw_text.color: pick(t.done, sub, ink) draw_text.text_style.font_size: 13}
                    Label{width: Fill text: "来自:" + t.from draw_text.color: sub draw_text.text_style.font_size: 11}
                }
                Label{text: t.due draw_text.color: sub draw_text.text_style.font_size: 11}
            }
        }
    }
}

fn todo_screen(){
    View{width: Fill height: Fit flow: Down spacing: 10
        Label{width: Fill text: "跟进待办" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 22}}
        RoundedView{width: Fit height: Fit padding: Inset{top: 5 bottom: 5 left: 12 right: 12} draw_bg +: {color: card border_radius: 14.0}
            Label{text: "今日 3 项 · 已完成 1" draw_text.color: orange draw_text.text_style.font_size: 12}
        }
        for g in ["今天", "明天"] {
            Label{width: Fill text: g draw_text.color: sub draw_text.text_style.font_size: 12}
            View{width: Fill height: Fit flow: Down spacing: 8
                for i in todos.len() {
                    if todos[i].when == g { todo_row(i) }
                }
            }
        }
    }
}

// ---- screen 5: me -------------------------------------------------------
fn me_screen(){
    View{width: Fill height: Fit flow: Down spacing: 12
        RoundedView{width: Fill height: Fit padding: Inset{top: 18 bottom: 18 left: 18 right: 18} draw_bg +: {color: card border_radius: 22.0} flow: Down spacing: 6 align: Align{x: 0.5}
            RoundedView{width: 64 height: 64 draw_bg +: {color: teal border_radius: 32.0} align: Align{x: 0.5 y: 0.5}
                Label{text: "林" draw_text.color: #xffffffff draw_text.text_style: theme.font_bold{font_size: 24}}
            }
            Label{text: "小林" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}}
            Label{text: "xiaolin@mail.com" draw_text.color: sub draw_text.text_style.font_size: 12}
        }
        RoundedView{width: Fill height: Fit padding: Inset{top: 14 bottom: 14 left: 18 right: 18} draw_bg +: {color: card border_radius: 18.0}
            View{width: Fill height: Fit flow: Down spacing: 10
                Label{width: Fill text: "通知与提醒" draw_text.color: ink draw_text.text_style.font_size: 14}
                Label{width: Fill text: "深色模式跟随系统" draw_text.color: ink draw_text.text_style.font_size: 14}
                Label{width: Fill text: "帮助与反馈" draw_text.color: ink draw_text.text_style.font_size: 14}
            }
        }
    }
}

// ---- bottom navigation: FOUR tabs per the reference ----------------------
fn nav_tab(label, icon, target){
    GestureView{width: Fill height: Fit padding: Inset{top: 7 bottom: 7} on_tap: |x, y| go(target)
        View{width: Fill height: Fit flow: Down spacing: 3 align: Align{x: 0.5}
            Image{width: 22 height: 22 src: http_resource("{{assets}}/assets/" + icon) fit: ImageFit.CropToFill}
            Label{text: label draw_text.color: pick(screen == target, orange, #x3A3A3A) draw_text.text_style.font_size: 12}
        }
    }
}

// ---- root ---------------------------------------------------------------
SolidView{width: Fill height: Fill flow: Down draw_bg.color: ground
    body := ScrollYView{width: Fill height: Fill flow: Down padding: Inset{top: 18 bottom: 10 left: 16 right: 16} spacing: 12 on_render: || {
        if screen == "inbox" { inbox_screen() }
        if screen == "read" { read_screen(mails[current]) }
        if screen == "write" { write_screen() }
        if screen == "todo" { todo_screen() }
        if screen == "me" { me_screen() }
    }}
    RoundedView{width: Fill height: Fit padding: Inset{top: 4 bottom: 4 left: 10 right: 10} draw_bg +: {color: card border_radius: 22.0}
        View{width: Fill height: Fit flow: Right spacing: 4
            nav_tab("收件箱", "nav-inbox.svg", "inbox")
            nav_tab("待办", "nav-todo.svg", "todo")
            nav_tab("AI助手", "nav-ai.svg", "write")
            nav_tab("我的", "nav-me.svg", "me")
        }
    }
}
