// send: lucide send — paper plane, tip top-right (dense chains: the cell
// pitch must stay under the stroke width or the edges read dashed)
fn send_icon(color, size){
    let u = size / 16.0
    View{width: size height: size flow: Overlay
        icell(size, size * 0.917, size * 0.083, 1.8 * u, color)
        icell(size, size * 0.880, size * 0.187, 1.8 * u, color)
        icell(size, size * 0.844, size * 0.292, 1.8 * u, color)
