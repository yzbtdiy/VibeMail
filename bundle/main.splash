// agentic-mail — a four-screen script app (blackboard entry #5).
// Screens: 1 inbox digest, 2 mail reading with AI summary, 3 AI drafting,
// 4 follow-up todos. All data is mock, in-memory state; no capabilities,
// no hosts, Simplified Chinese copy throughout, dark theme, phone portrait.

// ---- state -------------------------------------------------------------
let screen = "inbox"          // inbox | read | write | todo
let current = 0               // index of the mail being read

let mails = [
    {who: "财务周报" mono: "财" hue: 0.09 imp: "高" time: "09:12" unread: true
     subject: "三季度营收复核——附件含汇报材料"
     preview: "财务确认第三季度达成计划的 104%。"
     body: "各位好:\n\n附上三季度营收复核材料。本季度营收达成计划的 104%,主要由企业级续约与两个新行业客户贡献。\n\n材料中标出了两项风险:其一,大客户集中度进一步上升;其二,回款周期较上季度延长 5 天。\n\n两项风险均需管理层在周五董事会前给出处置意见,详见材料第 4 页。"
     points: ["营收达成计划的 104%,企业续约为主要贡献", "大客户集中度上升,为第一风险项", "回款周期延长 5 天,需财务跟进", "两项风险需周五董事会前签署意见"]
     action: "建议行动:周五前审阅第 4 页风险处置页并签署意见。"}
    {who: "平台团队" mono: "平" hue: 0.58 imp: "普通" time: "08:47" unread: false
     subject: "发布窗口调整至 22:00"
     preview: "今晚的发布因数据库维护推迟两小时。"
     body: "团队:\n\n今晚的发布窗口因数据库主从切换维护,由 20:00 调整至 22:00。变更单已审批,值班表不变。\n\n除非你在值班,否则无需任何操作;次日早晨的冒烟测试照常进行。"
     points: ["发布窗口 20:00 → 22:00,推迟两小时", "原因是数据库主从切换维护", "值班安排不变,无需额外操作"]
     action: "建议行动:值班同学确认 22:00 在线即可。"}
    {who: "设计公会" mono: "设" hue: 0.78 imp: "低" time: "昨天" unread: false
     subject: "每周界面研究摘要"
     preview: "三篇锁屏排版文章与两个摘要式布局案例。"
     body: "本周精选:\n\n1. 锁屏排版字体的可读性研究(3 篇);\n2. 摘要式信息流布局的两个案例研究;\n3. 下周讨论主题:重要度色彩编码的语义一致性。"
     points: ["锁屏排版字体研究 3 篇", "摘要式信息流布局案例 2 个", "下周主题:重要度色彩语义"]
     action: "建议行动:有兴趣可标记下周讨论。"}
    {who: "IT 支持" mono: "I" hue: 0.68 imp: "高" time: "10:05" unread: true
     subject: "VPN 证书今晚轮换"
     preview: "旧证书 23:00 失效,请及时更新客户端。"
     body: "全体:\n\nVPN 根证书今晚 23:00 起轮换,旧证书将失效。请在此之前打开客户端完成自动更新;出差同事建议提前一小时操作。\n\n如遇握手失败,重新导入附件中的根证书即可。"
     points: ["VPN 根证书 23:00 轮换", "旧证书届时失效,客户端需更新", "出差同事建议提前一小时"]
     action: "建议行动:今晚 22:00 前更新客户端。"}
    {who: "客服中心" mono: "客" hue: 0.32 imp: "普通" time: "08:12" unread: false
     subject: "会员权益续期提醒"
     preview: "企业会员权益将于月底到期,续期享 9 折。"
     body: "您好:\n\n贵司企业会员权益将于本月 30 日到期。本周期内续期可享 9 折优惠,并保留历史工单优先通道。\n\n如需发票抬头变更,请在续期时一并备注。"
     points: ["会员权益本月 30 日到期", "续期享 9 折并保留优先通道", "发票变更需随续期备注"]
     action: "建议行动:本周内决定是否续期。"}
    {who: "市场部" mono: "市" hue: 0.02 imp: "低" time: "周一" unread: false
     subject: "品牌升级方案初稿"
     preview: "三套视觉方向初稿,附对比说明。"
     body: "团队:\n\n品牌升级初稿已完成三套视觉方向:稳健延续、锐意对比、柔和过渡。每套含主色、字阶与图标样式的对比说明。\n\n下周例会逐套评审,欢迎提前批注。"
     points: ["三套视觉方向初稿已完成", "每套含主色/字阶/图标对比", "下周例会逐套评审"]
     action: "建议行动:会前完成初步倾向标注。"}
]

let draft_input = ""          // what the user tells the AI to write
let draft_text = ""           // the generated draft
let tone = "正式"             // 正式 | 友好 | 简洁

let todos = [
    {done: true  when: "今天" text: "签署三季度风险处置意见" from: "三季度营收复核" due: "周五 18:00"}
    {done: false when: "今天" text: "确认 22:00 发布窗口值班" from: "发布窗口调整" due: "今天 21:00"}
    {done: false when: "今天" text: "回复设计公会下周议题" from: "每周界面研究摘要" due: "今天 17:00"}
    {done: false when: "明天" text: "审阅摘要式布局案例" from: "每周界面研究摘要" due: "明天 10:00"}
]

// ---- palette (dark) -----------------------------------------------------
let ground = #x16181d
let panel  = #x1f232b
let panel2 = #x262b34
let hair   = #x333a45
let ink    = #xf2f4f8
let dim    = #x9aa3b2
let faint  = #x6b7480
let amber  = #xf5b84f
let blue   = #x6fa8f5

fn imp_color(imp){
    if imp == "高" { return amber }
    if imp == "普通" { return dim }
    return faint
}

// The widget DSL has no ternary in property position (a `cond ? a : b`
// lowers the bool into the property and fails the type check), so these
// pickers are plain if/return functions, like imp_color.
fn pick(c, a, b){ if c { return a } return b }

// Sender monogram colours, precomputed hex (the script runtime has no
// hsv() — that belongs to the L0 kit's palette, not to a Splash program).
fn mono_color(m){
    if m.hue == 0.09 { return #xbf915c }
    if m.hue == 0.58 { return #x5c8fbf }
    return #x7c5cbf
}

// ---- navigation ---------------------------------------------------------
fn go(s){ screen = s; ui.body.render() }
fn open_mail(i){ current = i; screen = "read"; ui.body.render() }

// ---- screen 1: inbox ----------------------------------------------------
fn banner(){
    RoundedView{width: Fill height: Fit padding: Inset{top: 14 bottom: 14 left: 16 right: 16} draw_bg +: {color: panel border_radius: 14.0} flow: Down spacing: 6
        View{width: Fill height: Fit flow: Right spacing: 10 align: Align{y: 0.5}
            Image{width: 28 height: 28 src: http_resource("{{assets}}/assets/ai-logo.svg") fit: ImageFit.CropToFill}
            Label{width: Fill text: "已为你筛选 6/12 封 · 按重要度排序" draw_text.color: amber draw_text.text_style: theme.font_bold{font_size: 13}}
        }
        Label{width: Fill text: "今日概览:2 封高优先级需处理,2 封普通,2 封参考" draw_text.color: dim draw_text.text_style.font_size: 12}
    }
}

fn imp_tag(m){
    let c = imp_color(m.imp)
    RoundedView{width: Fit height: Fit padding: Inset{top: 2 bottom: 2 left: 8 right: 8} draw_bg +: {color: c border_radius: 8.0} align: Align{x: 0.5 y: 0.5}
        Label{text: m.imp draw_text.color: pick(m.imp == "高", #x2b2416, #xffffffff) draw_text.text_style.font_size: 10}
    }
}

fn mail_row(i){
    let m = mails[i]
    GestureView{width: Fill height: Fit padding: Inset{top: 10 bottom: 10} on_tap: |x, y| open_mail(i)
        View{width: Fill height: Fit flow: Right spacing: 12 align: Align{y: 0.5}
            RoundedView{width: 46 height: 46 draw_bg +: {color: mono_color(m) border_radius: 23.0} align: Align{x: 0.5 y: 0.5}
                Label{text: m.mono draw_text.color: #xffffffff draw_text.text_style: theme.font_bold{font_size: 17}}
            }
            View{width: Fill height: Fit flow: Down spacing: 3
                View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                if m.unread { RoundedView{width: 8 height: 8 draw_bg +: {color: blue border_radius: 4.0} } }
                    Label{text: m.who draw_text.color: ink draw_text.text_style.font_size: 14}
                    imp_tag(m)
                    Label{width: Fill text: m.time draw_text.color: pick(m.unread, ink, faint) draw_text.text_style.font_size: 11}
                }
                Label{width: Fill text: m.subject draw_text.color: pick(m.unread, ink, dim) draw_text.text_style: pick(m.unread, theme.font_bold{font_size: 13}, theme.font_regular{font_size: 13})}
                Label{width: Fill text: m.preview draw_text.color: dim draw_text.text_style.font_size: 12}
            }
        }
    }
}

// ---- screen 2: reading --------------------------------------------------
fn read_screen(m){
    View{width: Fill height: Fit flow: Down spacing: 14
        View{width: Fill height: Fit flow: Right spacing: 10 align: Align{y: 0.5}
            ButtonFlat{text: "‹ 返回" on_click: || go("inbox")
                draw_bg +: {color: panel color_hover: panel2 color_down: panel border_radius: 14.0 border_size: 0.0}
                draw_text +: {color: ink color_hover: ink color_down: ink}}
            Label{width: Fill text: "邮件阅读" draw_text.color: dim draw_text.text_style.font_size: 12}
        }
        View{width: Fill height: Fit flow: Right spacing: 12 align: Align{y: 0.5}
            RoundedView{width: 54 height: 54 draw_bg +: {color: mono_color(m) border_radius: 27.0} align: Align{x: 0.5 y: 0.5}
                Label{text: m.mono draw_text.color: #xffffffff draw_text.text_style.font_size: 21}
            }
            View{width: Fill height: Fit flow: Down spacing: 3
                Label{width: Fill text: m.who draw_text.color: ink draw_text.text_style.font_size: 18}
                Label{width: Fill text: m.subject draw_text.color: dim draw_text.text_style.font_size: 12}
                Label{width: Fill text: m.time draw_text.color: faint draw_text.text_style.font_size: 11}
            }
        }
        RoundedView{width: Fill height: Fit padding: Inset{top: 14 bottom: 14 left: 16 right: 16} draw_bg +: {color: panel border_radius: 14.0} flow: Down spacing: 10
            Label{width: Fill text: m.subject draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}}
            Label{width: Fill text: m.body draw_text.color: ink draw_text.text_style.font_size: 14}
        }
        ai_summary(m)
        View{width: Fill height: Fit flow: Right spacing: 8 padding: Inset{top: 4}
            ButtonFlat{width: Fill text: "回复" on_click: || go("write")
                draw_bg +: {color: blue color_hover: blue color_down: blue border_radius: 14.0 border_size: 0.0}
                draw_text +: {color: #xffffffff}}
            ButtonFlat{width: Fill text: "转发" on_click: || go("write")
                draw_bg +: {color: panel color_hover: panel2 color_down: panel border_radius: 14.0 border_size: 0.0}
                draw_text +: {color: ink}}
            ButtonFlat{width: Fill text: "归档" on_click: || go("inbox")
                draw_bg +: {color: panel color_hover: panel2 color_down: panel border_radius: 14.0 border_size: 0.0}
                draw_text +: {color: ink}}
        }
    }
}

fn ai_summary(m){
    RoundedView{width: Fill height: Fit padding: Inset{top: 12 bottom: 12 left: 14 right: 14} draw_bg +: {color: panel2 border_radius: 14.0} flow: Down spacing: 8
        Label{width: Fill text: "✦ AI 摘要 · 要点提炼" draw_text.color: amber draw_text.text_style.font_size: 13}
        for p in m.points {
            View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                Label{text: "·" draw_text.color: dim draw_text.text_style.font_size: 12}
                Label{width: Fill text: p draw_text.color: ink draw_text.text_style.font_size: 13}
            }
        }
        Hr{}
        Label{width: Fill text: m.action draw_text.color: dim draw_text.text_style.font_size: 12}
    }
}

// ---- screen 3: AI drafting ----------------------------------------------
fn set_tone(t){ tone = t; ui.body.render() }
fn regen(){
    let ask = draft_input
    if ask == "" { ask = "一封通用商务邮件" }
    draft_text = "(草稿 · " + tone + ")\n\n你好:\n\n关于「" + ask + "」,说明如下:本次沟通意在同步进展并确认下一步安排。如有疑问,欢迎随时回复讨论。\n\n顺祝商祺。"
    ui.body.render()
}
fn insert_draft(){
    if draft_text == "" { regen() }
    go("read")
}

fn write_screen(){
    View{width: Fill height: Fit flow: Down spacing: 14
        Label{width: Fill text: "AI 起草" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 22}}
        RoundedView{width: Fill height: Fit padding: Inset{top: 4 bottom: 4 left: 4 right: 4} draw_bg +: {color: panel border_radius: 14.0}
            TextInput{width: Fill height: 84 empty_text: "告诉 AI 你想写什么…" on_change: |t| draft_input = t
                draw_bg +: {color: panel color_hover: panel color_focus: panel2 color_empty: panel border_radius: 14.0}
                draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: dim color_empty_hover: dim}}
        }
        if draft_text != "" {
            RoundedView{width: Fill height: Fit padding: Inset{top: 12 bottom: 12 left: 14 right: 14} draw_bg +: {color: panel2 border_radius: 14.0} flow: Down spacing: 6
                Label{width: Fill text: "✦ 已生成草稿(可编辑)" draw_text.color: amber draw_text.text_style.font_size: 12}
                TextInput{width: Fill height: Fit text: draft_text on_change: |t| draft_text = t
                    draw_bg +: {color: #x00000000 color_hover: #x00000000 color_focus: #x00000000 border_radius: 8.0}
                    draw_text +: {color: ink color_hover: ink color_focus: ink}}
            }
        }
        Label{width: Fill text: "语气" draw_text.color: dim draw_text.text_style.font_size: 12}
        View{width: Fill height: Fit flow: Right spacing: 8
            for t in ["正式", "友好", "简洁"] {
                ButtonFlat{text: t on_click: || set_tone(t)
                    draw_bg +: {color: pick(t == tone, blue, panel) color_hover: panel2 color_down: panel border_radius: 16.0 border_size: 0.0}
                    draw_text +: {color: pick(t == tone, #xffffffff, ink)}}
            }
        }
        View{width: Fill height: Fit flow: Right spacing: 8
            ButtonFlat{width: Fill text: "✦ 重新生成" on_click: || regen()
                draw_bg +: {color: panel color_hover: panel2 color_down: panel border_radius: 14.0 border_size: 0.0}
                draw_text +: {color: ink}}
            ButtonFlat{width: Fill text: "插入草稿" on_click: || insert_draft()
                draw_bg +: {color: blue color_hover: blue color_down: blue border_radius: 14.0 border_size: 0.0}
                draw_text +: {color: #xffffffff}}
        }
    }
}

// ---- screen 4: todos ----------------------------------------------------
fn toggle(i){ todos[i].done = !todos[i].done; ui.body.render() }

fn todo_row(i){
    let t = todos[i]
    GestureView{width: Fill height: Fit padding: Inset{top: 10 bottom: 10} on_tap: |x, y| toggle(i)
        View{width: Fill height: Fit flow: Right spacing: 12 align: Align{y: 0.5}
            RoundedView{width: 24 height: 24 draw_bg +: {color: pick(t.done, blue, #x2a3038) border_radius: 12.0} align: Align{x: 0.5 y: 0.5}
                if t.done { Label{text: "✓" draw_text.color: #xffffffff draw_text.text_style.font_size: 12} }
            }
            View{width: Fill height: Fit flow: Down spacing: 3
                Label{width: Fill text: t.text draw_text.color: pick(t.done, faint, ink) draw_text.text_style.font_size: 13}
                Label{width: Fill text: "来自:" + t.from draw_text.color: faint draw_text.text_style.font_size: 11}
            }
            Label{text: t.due draw_text.color: dim draw_text.text_style.font_size: 11}
        }
    }
}

fn todo_screen(){
    let groups = ["今天", "明天"]
    View{width: Fill height: Fit flow: Down spacing: 10
        Label{width: Fill text: "跟进待办" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 22}}
        RoundedView{width: Fit height: Fit padding: Inset{top: 4 bottom: 4 left: 10 right: 10} draw_bg +: {color: panel border_radius: 12.0}
            Label{text: "今日 3 项 · 已完成 1" draw_text.color: blue draw_text.text_style.font_size: 12}
        }
        for g in groups {
            Label{width: Fill text: g draw_text.color: dim draw_text.text_style.font_size: 12}
            RoundedView{width: Fill height: Fit padding: Inset{top: 4 bottom: 4 left: 12 right: 12} draw_bg +: {color: panel border_radius: 14.0} flow: Down
                for i in todos.len() {
                    if todos[i].when == g {
                        todo_row(i)
                        if i < todos.len() - 1 { Hr{} }
                    }
                }
            }
        }
    }
}

// ---- bottom navigation --------------------------------------------------
// Tabs are an icon plus a label (the reference design); the SVG set is
// grey and the ACTIVE state is carried by the text colour, because one
// asset cannot retint.
fn nav_tab(label, icon, target){
    GestureView{width: Fill height: Fit padding: Inset{top: 6 bottom: 6} on_tap: |x, y| go(target)
        View{width: Fill height: Fit flow: Down spacing: 3 align: Align{x: 0.5}
            Image{width: 22 height: 22 src: http_resource("{{assets}}/assets/" + icon) fit: ImageFit.CropToFill}
            Label{text: label draw_text.color: pick(screen == target, ink, dim) draw_text.text_style.font_size: 12}
        }
    }
}

// ---- root ---------------------------------------------------------------
SolidView{width: Fill height: Fill flow: Down draw_bg.color: ground
    body := ScrollYView{width: Fill height: Fill flow: Down padding: Inset{top: 16 bottom: 8 left: 16 right: 16} spacing: 12 on_render: || {
        if screen == "inbox" {
            Label{width: Fill text: "智能邮件" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 22}}
            banner()
            for i in mails.len() {
                mail_row(i)
                if i < mails.len() - 1 { Hr{} }
            }
        }
        if screen == "read" {
            read_screen(mails[current])
        }
        if screen == "write" {
            write_screen()
        }
        if screen == "todo" {
            todo_screen()
        }
    }}
    View{width: Fill height: Fit flow: Right spacing: 4 padding: Inset{top: 6 bottom: 6 left: 8 right: 8}
        nav_tab("收件箱", "nav-inbox.svg", "inbox")
        nav_tab("写信", "nav-write.svg", "write")
        nav_tab("待办", "nav-todo.svg", "todo")
    }
}
