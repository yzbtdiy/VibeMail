                        RoundedView{width: 1 height: 14 draw_bg +: {color: line2 border_radius: 0.0}}
                        Label{text: "长度:适中" draw_text.color: ink55 draw_text.text_style.font_size: 10.5}
                        Label{text: "已引用原始邮件" draw_text.color: cyanT draw_text.text_style.font_size: 10}
                    }
                    RoundedView{width: Fill height: 1 draw_bg +: {color: line border_radius: 0.0}}
                    View{width: Fill height: Fit flow: Down spacing: 10 padding: Inset{top: 14 bottom: 14 left: 16 right: 16}
                        RoundedView{width: Fill height: Fit padding: Inset{top: 14 bottom: 12 left: 13 right: 13}
                            draw_bg +: {color: violetBg border_radius: 12.0 border_size: 1.0 border_color: violetBd} flow: Down spacing: 9
                            View{width: Fill height: Fit flow: Right spacing: 7 align: Align{y: 0.5}
                                RoundedView{width: Fit height: Fit padding: Inset{top: 2 bottom: 2 left: 8 right: 8}
                                    draw_bg +: {color: panel border_radius: 9.0 border_size: 1.0 border_color: violetBd}
                                    Label{text: "✦ AI 草稿 · 语气:" + tone draw_text.color: violetT draw_text.text_style.font_size: 9}}
                                View{width: Fill height: 1}
                                RoundedView{width: Fit height: Fit padding: Inset{top: 2 bottom: 2 left: 7 right: 7}
                                    draw_bg +: {color: violetBg border_radius: 9.0 border_size: 1.0 border_color: violetBd}
                                    Label{text: draft_pill_text() draw_text.color: violetT draw_text.text_style.font_size: 9}}
                            }
                            if draft_text == "" {
                                Label{width: Fill text: "在右侧描述你想表达的内容,点「生成草稿」由模型起草;无模型服务时回退本地模板。" draw_text.color: ink55 draw_text.text_style.font_size: 11}
                            }
                            RoundedView{width: Fill height: Fit draw_bg +: {color: panel2 border_radius: 10.0 border_size: 1.0 border_color: line}
                                TextInput{width: Fill height: 240 text: draft_text empty_text: "草稿会出现在这里…" on_change: |t| draft_text = t
                                    draw_bg +: {color: #x00000000 color_hover: #x00000000 color_focus: #x00000000 border_radius: 10.0}
                                    draw_text +: {color: inkHi color_hover: inkHi color_focus: inkHi color_empty: ink38 color_empty_hover: ink38}}
                            }
                            View{width: Fill height: Fit flow: Right spacing: 8
                                ButtonFlat{height: 28 text: "✓ 采用草稿" on_click: || insert_draft()
                                    draw_bg +: {color: violetBgHv color_hover: violetBd color_down: violetBgHv border_radius: 7.0 border_size: 1.0 border_color: violet}
                                    draw_text +: {color: violetT text_style.font_size: 10.5}}
                                ButtonFlat{height: 28 text: "↻ 重新生成" on_click: || regen()
                                    draw_bg +: {color: #x00000000 color_hover: white7 color_down: white7 border_radius: 7.0 border_size: 1.0 border_color: line2}
                                    draw_text +: {color: ink55 text_style.font_size: 10.5}}
                            }
                            if draft_status == "unavailable" {
                                Label{width: Fill text: "模型服务不可用,已回退本地模板:" + draft_error draw_text.color: redT draw_text.text_style.font_size: 9.5}
                            }
                        }
                    }
                    RoundedView{width: Fill height: 1 draw_bg +: {color: line border_radius: 0.0}}
                    View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5} padding: Inset{top: 10 bottom: 10 left: 16 right: 16}
                        ButtonFlat{height: 32 text: "发送 →" on_click: || insert_draft()
                            draw_bg +: {color: violet color_hover: violet color_down: accB border_radius: 9.0 border_size: 0.0}
                            draw_text +: {color: accInk text_style.font_size: 12}}
                        ButtonFlat{width: 32 height: 32 text: "✎" on_click: || regen()
                            draw_bg +: {color: #x00000000 color_hover: white7 color_down: white7 border_radius: 8.0 border_size: 1.0 border_color: line2}
                            draw_text +: {color: ink55 text_style.font_size: 12}}
                        Label{text: "草稿已自动保存 · 09:47" draw_text.color: ink45 draw_text.text_style.font_size: 9}
                        View{width: Fill height: 1}
                    }
                }
            }
        }
        }
        RoundedView{width: 1 height: Fill draw_bg +: {color: line border_radius: 0.0}}
        View{width: 340 height: Fill flow: Overlay
            RoundedView{width: Fill height: Fill draw_bg +: {color: panel border_radius: 0.0}}
            ScrollYView{width: Fill height: Fill flow: Down
        View{width: Fill height: Fit flow: Down
            View{width: Fill height: 50 flow: Right spacing: 8 align: Align{y: 0.5} padding: Inset{left: 16 right: 14}
                Label{text: "✦" draw_text.color: violetT draw_text.text_style.font_size: 12}
                Label{text: "COMPOSE WITH AI" draw_text.color: violetT draw_text.text_style.font_size: 10}
            }
            RoundedView{width: Fill height: 1 draw_bg +: {color: line border_radius: 0.0}}
            View{width: Fill height: Fit flow: Down spacing: 14 padding: Inset{top: 14 bottom: 20 left: 14 right: 14}
                section_label("描述你想表达的内容")
                RoundedView{width: Fill height: Fit padding: Inset{top: 13 bottom: 13 left: 14 right: 14}
                    draw_bg +: {color: panel2 border_radius: 14.0 border_size: 1.0 border_color: line} flow: Down spacing: 10
                    RoundedView{width: Fill height: Fit draw_bg +: {color: panel border_radius: 10.0 border_size: 1.0 border_color: line}
                        TextInput{width: Fill height: 46 empty_text: "告诉 AI 你想表达什么…" on_change: |t| draft_input = t
                            draw_bg +: {color: #x00000000 color_hover: #x00000000 color_focus: #x00000000 border_radius: 10.0}
                            draw_text +: {color: inkHi color_hover: inkHi color_focus: inkHi color_empty: ink38 color_empty_hover: ink38}}
                    }
                    View{width: Fill height: Fit flow: Right spacing: 8
                        ButtonFlat{width: Fill height: 30 text: "生成草稿" on_click: || regen()
                            draw_bg +: {color: violet color_hover: violet color_down: cyan border_radius: 8.0 border_size: 0.0}
                            draw_text +: {color: accInk text_style.font_size: 11.5}}
                        chip("GPT-Vibe 4", "violet")
                    }
                }
                section_label("试试这样开始")
                View{width: Fill height: Fit flow: Down spacing: 7
                    View{width: Fill height: Fit flow: Right spacing: 7
                        prompt_chip("跟进上周的报价")
                        prompt_chip("婉拒一个会议邀请")
                    }
                    View{width: Fill height: Fit flow: Right spacing: 7
                        prompt_chip("请求延期交付")
                        prompt_chip("约客户下周面谈")
                    }
                }
                RoundedView{width: Fill height: Fit padding: Inset{top: 13 bottom: 9 left: 14 right: 14}
                    draw_bg +: {color: panel2 border_radius: 14.0 border_size: 1.0 border_color: line} flow: Down spacing: 4
                    section_label("AI 上下文")
                    ctx_row("引用当前邮件线程", true)
                    ctx_row("参考历史沟通语气", true)
                    ctx_row("附加日历空闲状态", false)
                }
                View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                    Label{width: Fill text: "练习:模拟服务中断" draw_text.color: ink45 draw_text.text_style.font_size: 10.5}
                    ButtonFlat{height: 26 padding: Inset{left: 10 right: 10} text: pick(simulate_outage, "已开启", "已关闭") on_click: || toggle_outage()
                        draw_bg +: {color: pick(simulate_outage, redBg, panel2) border_radius: 8.0 border_size: 1.0 border_color: pick(simulate_outage, redBd, line2)}
                        draw_text +: {color: pick(simulate_outage, redT, ink66) text_style.font_size: 10.5}}
                }
                View{width: Fill height: 40}
            }
        }
        }
    }
    }
}

// ---- Agent 小队 ------------------------------------------------------------------
fn approve_act(i){ acts[i].handled = true; repaint() }
fn toggle_agent(i){ agents[i].on = !agents[i].on; repaint() }
fn agent_color(k){
    if k == "teal" { return cyan }
    if k == "ok" { return mint }
    if k == "amber" { return amber }
    return violet
}
fn agent_soft(k){
    if k == "teal" { return cyanBg }
    if k == "ok" { return mintBg }
    if k == "amber" { return amberBg }
    return violetBg
}
fn running_cnt(){
    let n = 0
    for i in agents.len() { if agents[i].on { n = n + 1 } }
    return n
}
fn pending_cnt(){
    let n = 0
    for i in acts.len() {
        if acts[i].status == "approval" { if !acts[i].handled { n = n + 1 } }
    }
    return n
}
fn stat_cell(glyph, label, value, color){
    RoundedView{width: Fill height: Fit padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
        draw_bg +: {color: panel2 border_radius: 14.0 border_size: 1.0 border_color: line} flow: Down spacing: 8
        View{width: Fill height: Fit flow: Right spacing: 6
            Label{text: glyph draw_text.color: color draw_text.text_style.font_size: 10}
            Label{text: label draw_text.color: ink45 draw_text.text_style.font_size: 9}
        }
        Label{text: value draw_text.color: color draw_text.text_style: theme.font_bold{font_size: 22}}
    }
}
fn agent_card(i){
    let a = agents[i]
    RoundedView{width: Fill height: Fit padding: Inset{top: 14 bottom: 12 left: 14 right: 14}
        draw_bg +: {color: panel2 border_radius: 16.0 border_size: 1.0 border_color: line} flow: Down spacing: 10
        View{width: Fill height: Fit flow: Right spacing: 10
            RoundedView{width: 40 height: 40
                draw_bg +: {color: agent_soft(a.color) border_radius: 12.0 border_size: 1.0 border_color: agent_color(a.color)} align: Align{x: 0.5 y: 0.5}
                Label{text: a.glyph draw_text.color: agent_color(a.color) draw_text.text_style.font_size: 16}}
            View{width: Fill height: Fit flow: Down spacing: 2
                View{width: Fill height: Fit flow: Right spacing: 6 align: Align{y: 0.5}
                    Label{text: a.name draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 12.5}}
                    if a.on {
                        live_dot()
                    }
                    Label{text: a.status draw_text.color: pick(a.on, mint, amber) draw_text.text_style.font_size: 9}
                }
                Label{text: a.en draw_text.color: ink45 draw_text.text_style.font_size: 8}
            }
            View{width: 1 height: Fill}
            GestureView{width: 30 height: 17 on_tap: |x, y| toggle_agent(i)
                RoundedView{width: 30 height: 17 draw_bg +: {color: pick(a.on, violet, line2) border_radius: 9.0} flow: Overlay
                    View{width: 30 height: 17 align: pick(a.on, Align{x: 1.0 y: 0.5}, Align{x: 0.0 y: 0.5})
                        View{width: 17 height: 17 align: Align{x: 0.5 y: 0.5}
                            RoundedView{width: 13 height: 13 draw_bg +: {color: panel border_radius: 7.0}}}
                    }
                }
            }
        }
        Label{width: Fill text: a.desc draw_text.color: ink66 draw_text.text_style.font_size: 10.5}
        RoundedView{width: Fill height: 1 draw_bg +: {color: line border_radius: 0.0}}
        View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
            Label{width: Fill text: a.stat draw_text.color: ink45 draw_text.text_style.font_size: 9.5}
            Label{text: a.today draw_text.color: agent_color(a.color) draw_text.text_style.font_size: 9.5}
        }
    }
}
fn act_row(i){
    let a = acts[i]
    View{width: Fill height: Fit flow: Down padding: Inset{top: 11 bottom: 11 left: 14 right: 14} spacing: 6
        View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
            Label{text: a.time draw_text.color: ink45 draw_text.text_style.font_size: 9.5}
            Label{text: a.agent draw_text.color: violetT draw_text.text_style.font_size: 9.5}
            View{width: Fill height: 1}
            if a.status == "running" {
                RoundedView{width: Fit height: Fit padding: Inset{top: 2 bottom: 2 left: 6 right: 6}
                    draw_bg +: {color: cyanBg border_radius: 6.0 border_size: 1.0 border_color: cyanBd}
                    Label{text: "RUNNING" draw_text.color: cyanT draw_text.text_style.font_size: 8.5}}
            } else {
                if a.status == "done" {
                    Label{text: "✓ DONE" draw_text.color: mint draw_text.text_style.font_size: 9}
                } else {
                    if a.handled {
                        Label{text: "已处理" draw_text.color: ink38 draw_text.text_style.font_size: 9}
                    } else {
                        Label{text: "需审批" draw_text.color: amberT draw_text.text_style.font_size: 9}
                    }
                }
            }
        }
        Label{width: Fill text: a.text draw_text.color: inkHi draw_text.text_style.font_size: 11}
        if a.status == "approval" {
            if !a.handled {
                View{width: Fill height: Fit flow: Right spacing: 7
                    ButtonFlat{height: 26 text: "✓ 批准" on_click: || approve_act(i)
                        draw_bg +: {color: mintBg color_hover: mintBd color_down: mintBg border_radius: 7.0 border_size: 1.0 border_color: mintBd}
                        draw_text +: {color: mintT text_style.font_size: 10}}
                    ButtonFlat{height: 26 text: "✕ 忽略" on_click: || approve_act(i)
                        draw_bg +: {color: #x00000000 color_hover: redBg color_down: redBg border_radius: 7.0 border_size: 1.0 border_color: line2}
                        draw_text +: {color: ink55 text_style.font_size: 10}}
                }
            }
        }
    }
}
fn agents_screen(){
    ScrollYView{width: Fill height: Fill flow: Down
    View{width: Fill height: Fit flow: Down padding: Inset{top: 20 bottom: 30 left: 28 right: 24} spacing: 16
        View{width: Fill height: Fit flow: Right spacing: 10
            stat_cell("✦", "运行中的 AGENT", "" + running_cnt(), violet)
            stat_cell("✓", "今日已完成任务", "12", mint)
            stat_cell("◑", "本周节省时间", "3.2h", cyan)
            stat_cell("✦", "待你审批", "" + pending_cnt(), amber)
        }
        View{width: Fill height: Fit flow: Right spacing: 16
            View{width: Fill height: Fit flow: Down spacing: 10
                View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                    Label{text: "我的 AGENT 小队" draw_text.color: ink45 draw_text.text_style.font_size: 9.5}
                    View{width: Fill height: 1}
                    Label{text: "SQUAD · 4 UNITS" draw_text.color: ink45 draw_text.text_style.font_size: 9}
                }
                View{width: Fill height: Fit flow: Right spacing: 10
                    agent_card(0)
                    agent_card(1)
                }
                View{width: Fill height: Fit flow: Right spacing: 10
                    agent_card(2)
                    agent_card(3)
                }
                RoundedView{width: Fill height: Fit padding: Inset{top: 14 bottom: 14 left: 16 right: 16}
                    draw_bg +: {color: panel2 border_radius: 16.0 border_size: 1.0 border_color: line} flow: Down spacing: 12
                    View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                        Label{text: "自动化程度" draw_text.color: ink45 draw_text.text_style.font_size: 9.5}
                        View{width: Fill height: 1}
                        Label{text: "SEMI-AUTO" draw_text.color: violetT draw_text.text_style.font_size: 9.5}
                    }
                    RoundedView{width: Fill height: 4 draw_bg +: {color: line border_radius: 2.0} flow: Overlay
                        RoundedView{width: 260 height: 4 draw_bg +: {color: violet border_radius: 2.0}}
                        View{width: 274 height: 4 align: Align{x: 0.0 y: 0.5}
                            View{width: 14 height: 14 align: Align{x: 0.5 y: 0.5}
                                RoundedView{width: 14 height: 14 draw_bg +: {color: panel border_radius: 7.0 border_size: 2.0 border_color: violet}}}
                        }
                    }
                    View{width: Fill height: Fit flow: Right spacing: 8
                        Label{text: "仅建议" draw_text.color: ink45 draw_text.text_style.font_size: 9}
                        View{width: Fill height: 1}
                        Label{text: "半自动 · 关键动作需审批" draw_text.color: violetT draw_text.text_style.font_size: 9}
                        View{width: Fill height: 1}
                        Label{text: "全自动" draw_text.color: ink45 draw_text.text_style.font_size: 9}
                    }
                }
            }
            View{width: 340 height: Fit flow: Down spacing: 10
                View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                    Label{text: "实时活动流" draw_text.color: ink45 draw_text.text_style.font_size: 9.5}
                    View{width: Fill height: 1}
                    live_dot()
                    Label{text: "LIVE" draw_text.color: mint draw_text.text_style.font_size: 9}
                }
                RoundedView{width: Fill height: Fit
                    draw_bg +: {color: panel2 border_radius: 16.0 border_size: 1.0 border_color: line} flow: Down
                    for i in acts.len() {
                        if i > 0 { RoundedView{width: Fill height: 1 draw_bg +: {color: line border_radius: 0.0}} }
                        act_row(i)
                    }
                }
            }
        }
    }
    }
}

// ---- root ---------------------------------------------------------------------
// No separate ground root: on_render-minted layers composite in a late extra
// pass regardless of tree order (probed), so an underlay root leaks ABOVE the
// UI. The page bg + ambient blobs are therefore the FIRST items minted inside
// body's own on_render — under every screen, repainted on theme switches.
SolidView{width: Fill height: Fill flow: Overlay draw_bg.color: #x161c1a
    View{width: Fill height: Fill flow: Right
        railc := View{width: Fit height: Fill flow: Right on_render: || {
            sidebar()
            RoundedView{width: 1 height: Fill draw_bg +: {color: sepC border_radius: 0.0}}
        }}
        View{width: Fill height: Fill flow: Down
            barc := View{width: Fill height: Fit flow: Down on_render: || {
                top_bar()
                RoundedView{width: Fill height: 1 draw_bg +: {color: sepC border_radius: 0.0}}
            }}
            // body is a FIXED viewport area; each pane scrolls itself (the
            // web design's overflow-y-auto columns) — one page scroll made
            // the columns push each other around. The page ground is the
            // first Overlay child here, under every screen.
            body := View{width: Fill height: Fill flow: Overlay on_render: || {
                RoundedView{width: Fill height: Fill draw_bg +: {color: space border_radius: 0.0}}
                if screen == "inbox" { inbox_screen() }
                if screen == "write" { write_screen() }
                if screen == "agents" { agents_screen() }
            }}
        }
    }
}
