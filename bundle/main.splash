     t2: "您好,确认参加本次黑客松评审。提交信息(应用 id、版本号、publisher key 指纹及 hub check 输出)将于 10 月 8 日前完整回复本邮件。"
     reply: "" reply_text: "" send_error: "" boxed: ""
     summary_src: "practice" ai_points: []}
]

// ---- compose state (tone slider + send lifecycle) -------------------------
let reply_idx = -1             // mail being replied to, -1 = fresh compose
let to_input = "mira@octomail.io"
let subject_input = "Re: 周末去海边吗?"
let tone = 2                   // 0 真诚 | 1 幽默 | 2 自然 | 3 专业 | 4 正式
let tone_src = "canned"        // canned | asking | ai | unavailable
let tone_note = ""
let live_preview = ""          // model-rewritten preview (live targets)
let send_state = "idle"        // idle | sending | sent | failed | cancelled
let send_error_msg = ""
let simulate_outage = false    // practice switch: next practice send fails
let digest_model = ""          // model-written mood line (0.7.6)
let digest_src = "template"    // template | asking | ai
let restored_note = ""         // transient settings feedback after a restore

// ---- palette (warm paper light / charcoal dark) ---------------------------
// Values mirror the reference tokens; hairlines and glass are the reference
// alphas pre-blended over each theme's ground (runtime has no alpha colour
// math). Vibe chip grounds stay literal per vibe per theme.
let paper   = #xeaeae3         // page ground
let paper2  = #xf6f5ee         // inset panels / preview box
let paper3  = #xffffff         // cards
let ink     = #x2a2a2a         // primary text
let inkSoft = #x75736b         // secondary text
let inkDim  = #x9a988f         // tertiary text
let line    = #xcfcfc9         // hairline
let line2   = #xb4b4af         // stronger hairline
let glass   = #xf3f2eb         // nav pill ground
let failT   = #xb33626
let failBg  = #xf7ded6
let sendIdleT = #x75736b       // sending… text
let chipBgFocus = #xff6a3d40
let chipBgJoy   = #xf6ff9140
let chipBgCalm  = #x7de88840
let chipBgSpark = #xff90ff40
let chipBgLink  = #x2a7dfa40
let chipFgFocus = #x2a2a2a
let chipFgJoy   = #x2a2a2a
let chipFgCalm  = #x2a2a2a
let chipFgSpark = #x2a2a2a
let chipFgLink  = #x2a2a2a
let dotJoy  = #xc9b300         // neon swap on light ground (contrast)

// ---- dual theme ------------------------------------------------------------
// Same machinery as 0.6.x: plain `let` bindings rebound by apply_theme, every
// widget minted inside the single on_render root that repaint() re-runs.
// themeMode system|light|dark persists to theme.json; a poller samples the
// host palette so a Shell appearance flip re-themes a running app within ~2s.
let themeLight = true
let themeMode = "system"

fn save_theme_mode(){
    fs.write("theme.json", "{\"mode\":\"" + themeMode + "\"}")
}
fn load_theme_mode(){
    if fs.exists("theme.json") {
        let v = fs.read("theme.json").parse_json()
        if v != nil {
            if v.mode == "light" { themeMode = "light" return }
            if v.mode == "dark" { themeMode = "dark" return }
            themeMode = "system"
        }
    }
}
fn system_prefers_dark(){
    let bg = mod.theme.color_bg_app
    if bg == nil { return nil }
    if bg == #xeff5f6 { return false }
    if bg == #x0b1220 { return true }
    return nil
}
fn resolve_theme(){
    if themeMode == "light" { return true }
    if themeMode == "dark" { return false }
    let d = system_prefers_dark()
    if d == nil { return true }
    return !d
}
fn apply_theme_mode(m){
    if nav_recent() { return }
    themeMode = m
    save_theme_mode()
    apply_theme(resolve_theme())
    repaint()
}
fn apply_theme(l){
    themeLight = l
    paper   = pick(l, #xeaeae3, #x151413)
    paper2  = pick(l, #xf6f5ee, #x1e1d1b)
    paper3  = pick(l, #xffffff, #x262524)
    ink     = pick(l, #x2a2a2a, #xf2f0e9)
    inkSoft = pick(l, #x75736b, #x98968d)
    inkDim  = pick(l, #x9a988f, #x6d6b63)
    line    = pick(l, #xcfcfc9, #x32312e)
    line2   = pick(l, #xb4b4af, #x4f4d49)
    glass   = pick(l, #xf3f2eb, #x1b1a19)
    failT   = pick(l, #xb33626, #xf08a75)
    failBg  = pick(l, #xf7ded6, #x3a2620)
    sendIdleT = pick(l, #x75736b, #x98968d)
    chipBgFocus = pick(l, #xff6a3d40, #xff6a3d2e)
    chipBgJoy   = pick(l, #xf6ff9140, #xf6ff912e)
    chipBgCalm  = pick(l, #x7de88840, #x7de8882e)
    chipBgSpark = pick(l, #xff90ff40, #xff90ff2e)
    chipBgLink  = pick(l, #x2a7dfa40, #x2a7dfa2e)
    chipFgFocus = pick(l, #x2a2a2a, #xff6a3d)
    chipFgJoy   = pick(l, #x2a2a2a, #xf6ff91)
    chipFgCalm  = pick(l, #x2a2a2a, #x7de888)
    chipFgSpark = pick(l, #x2a2a2a, #xff90ff)
    chipFgLink  = pick(l, #x2a2a2a, #x2a7dfa)
    dotJoy  = pick(l, #xc9b300, #xf6ff91)
}
fn toggle_theme(){
    if nav_recent() { return }
    apply_theme_mode(pick(themeLight, "dark", "light"))
}
// settings state word: what the three-mode row actually resolved to
fn theme_now_note(){
    if themeMode == "light" { return "当前:暖纸亮色" }
    if themeMode == "dark" { return "当前:炭黑暗色" }
    return "当前:跟随系统"
}
fn repaint(){
    ui.appc.render()
}
let ui_dirty = false
// async callbacks land here: in the Shell's isolate runner a repaint issued
// inside a host-reply callback never reaches the screen (0.7.7 finding — the
// first mail open stored its AI summary but drew nothing until the second
// tap), while the top-level poller's repaint does (theme following proves
// it). Callbacks set the flag; poll_step flushes it on the next 0.4s beat.
fn soft_repaint(){
    ui_dirty = true
}

// ---- helpers ---------------------------------------------------------------
fn pick(c, a, b){ if c { return a } return b }
fn chip_bg(v){
    if v == "focus" { return chipBgFocus }
    if v == "joy"   { return chipBgJoy }
    if v == "calm"  { return chipBgCalm }
    if v == "spark" { return chipBgSpark }
    return chipBgLink
}
fn chip_fg(v){
    if v == "focus" { return chipFgFocus }
    if v == "joy"   { return chipFgJoy }
    if v == "calm"  { return chipFgCalm }
    if v == "spark" { return chipFgSpark }
    return chipFgLink
}
// accent dot / bullet colour: neon swaps for contrast on light ground
fn dot_color(v){
    if v == "focus" { return coralC }
    if v == "joy"   { return dotJoy }
    if v == "calm"  { return mintC }
    if v == "spark" { return pinkC }
    return blueC
}
fn vibe_count(v){
    let n = 0
    for i in mails.len() {
        if mails[i].boxed == "" {
            if mails[i].vibe == v { n = n + 1 }
        }
    }
    return n
}
fn visible_count(){
    if filter == "all" {
        let n = 0
        for i in mails.len() {
            if mails[i].boxed == "" { n = n + 1 }
        }
        return n
    }
    return vibe_count(filter)
}
fn unread_cnt(){
    let n = 0
    for i in mails.len() {
        if mails[i].boxed == "" {
            if mails[i].unread { n = n + 1 }
        }
    }
    return n
}
fn archived_cnt(){
    let n = 0
    for i in mails.len() {
        if mails[i].boxed == "archive" { n = n + 1 }
    }
    return n
}
fn digest_line(){
    return "今天有 " + vibe_count("focus") + " 件需要你行动,"
         + vibe_count("joy") + " 封让人开心,还有 " + vibe_count("spark") + " 篇值得慢读。"
}
// the mood line the digest card shows: the model's sentence once it answers,
// the fixed count line until then (labelled honestly either way)
fn digest_shown(){
    if digest_src == "ai" {
        if digest_model != "" { return digest_model }
    }
    return digest_line()
}
fn digest_src_word(){
    if digest_src == "asking" { return "生成中…" }
    if digest_src == "ai" { return "模型生成" }
    if digest_src == "budget" { return "今日额度用完" }
    return "固定文案"
}
// ONE model.complete per list load does BOTH jobs (0.7.12 user call: let the
// model classify): per-mail vibe labels (the five moods, replacing the
// keyword-rule guesses for live mails) + the mood line. The payload is the
// visible list (subject + sender + current rule label, capped at 12), never
// bodies or addresses. Any failure lands back on keyword rules + the fixed
// line — same honest degrade as summaries. Issues from the poller queue
// only (want_insight), never nested in a gesture or another callback.
fn ask_insight(){
    if !host.has("model") { digest_src = "template"; return }
    if mails.len() == 0 { digest_src = "template"; return }
    let feed = []
    let live_i = []
    let n = 0
    while n < mails.len() {
        if mails[n].boxed == "" {
            feed.push({s: mails[n].subject f: mails[n].sender v: vibe_label(mails[n].vibe)})
            if mails[n].src == "live" { live_i.push(n) }
        }
        n = n + 1
    }
    if feed.len() == 0 { digest_src = "template"; return }
    digest_src = "asking"
    insight_inflight = true
    soft_repaint()
    host.request("model.complete", {
        task: "两件事。1)给每封邮件标注一个 vibe,只能是 focus/joy/calm/spark/link 之一(focus=需要你行动,joy=开心,calm=知道即可,spark=值得慢读,link=社交社群),按顺序输出,每封一个。2)用一句话(30 字内)概括今天收件箱的整体氛围,温暖口语,不要列清单。"
        input: {mails: feed}
        schema: {type: "object" required: ["vibes", "line"] additionalProperties: false
                 properties: {
                     vibes: {type: "array" items: {type: "string" enum: ["focus", "joy", "calm", "spark", "link"]}}
                     line: {type: "string" maxLength: 60}}}
        class: "fast"
    }, fn(r){
        insight_inflight = false
        if r.is_ok {
            let vs = r.data.output.vibes
            let j = 0
            while j < live_i.len() {
                if j < vs.len() {
                    let v = vs[j]
                    if v == "focus" { mails[live_i[j]].vibe = "focus" }
                    if v == "joy"   { mails[live_i[j]].vibe = "joy" }
                    if v == "calm"  { mails[live_i[j]].vibe = "calm" }
                    if v == "spark" { mails[live_i[j]].vibe = "spark" }
                    if v == "link"  { mails[live_i[j]].vibe = "link" }
                }
                j = j + 1
            }
            digest_model = r.data.output.line
            digest_src = "ai"
        } else {
            digest_src = "template"
            // same honest classification as summaries (0.7.25): the daily
            // budget refusal deserves its own word, not a bare 固定文案
            if r.error.search("for today") >= 0 { digest_src = "budget" }
        }
        soft_repaint()
    })
}
// active vibe filter indicator — appears only while a filter is on
fn filter_note(){
    if filter == "all" { return "" }
    return "已按 vibe 筛选:" + vibe_label(filter) + " · " + visible_count() + " 封"
}
fn banner_line(){
    if mail_link == "checking" { return "正在连接邮件服务…" }
    if mail_link == "live" {
        if syncing { return "已连接 " + account_addr + " · 正在同步邮箱(首次可能需要一分钟)…" }
        return "已连接 " + account_addr + " · " + live_total + " 封真实邮件"
    }
    if mail_link == "no_account" { return "未添加邮箱账号 · 在「我的」里添加" }
    if mail_link == "error" { return "邮箱连接失败:" + link_error }
    return "邮件服务不可用 · 当前为练习数据"
}
fn summary_state_word(m){
    if m.summary_src == "asking" { return "生成中" }
    if m.summary_src == "ai" { return "模型生成" }
    if m.summary_src == "budget" { return "今日额度用完" }
    if m.summary_src == "busy" { return "限速·重开重试" }
    if m.summary_src == "unavailable" { return "服务不可用" }
    if m.summary_src == "live-fallback" { return "正文截取" }
    return "练习摘要"
}
// the summary lines to draw: AI points once generated, else the dataset
// (0.7.25: ai_points also carries the snippet fallback set on refusals, for
// any state — the state word says why, the point says what)
fn summary_lines(m){
    if m.ai_points.len() > 0 { return m.ai_points }
    return m.summary
}

// ---- mail data layer (official host service) -----------------------------
// MARKER:ADAPTER — the dev overlay (scripts/dev_bundle.py) replaces the block
// between the two MARKER lines with dev/adapter-bridge.splash; both expose
// the same globals and function set. Three honest states: no service answers
// (card-host, practice data), no account yet (the host's own sheet adds one),
// or live mail through the platform's mail service — real IMAP/SMTP happens
// host-side; the app itself never holds credentials.
let mail_src = "practice"      // practice | live — where the list came from
let mail_link = "checking"     // checking | no_service | no_account | error | live
let link_error = ""
let account_id = ""
let account_addr = ""
let live_total = 0
let want_sync = false         // sync queued by the accounts callback
let syncing = false           // a mail.sync is in flight (banner progress)
let sync_tries = 0            // re-issue cap (IMAP is genuinely slow)
let want_list = false
let mail_dbg = "boot"          // TEMP probe: where mail_list dies in the shell
// 0.7.9: requests issued from a GESTURE handler get their replies pumped
// only by the next input event in the Shell (first mail open: no body, no
// summary for tens of seconds — the reopen tap pumps them). Requests issued
// from this poller deliver on its own beats, so gestures only RAISE these
// flags and poll_step issues the requests here.
let want_body = -1             // mail index awaiting mail.message
let want_summary = -1          // mail index awaiting gen_summary
let want_mark = -1             // mail index awaiting mark_read
let want_send = false          // live send queued by 写信
let want_insight = false       // vibe classify + mood line re-ask
let insight_inflight = false   // one insight request at a time
let poll_beat = 0              // poll_step counter (retry pacing)
let body_tries = 0             // mail.message re-issues for the open mail
let summary_wait = 0          // beats since the open mail's summary request
let mail_arm = false           // 断开邮箱 needs a second confirming tap

fn mail_check(){
    if !host.has("mail") {
        mail_link = "no_service"
        link_error = "此环境未提供邮件服务(card-host)"
        soft_repaint()
        return
    }
    host.request("mail.accounts", {}, fn(r){
        if !r.is_ok {
            mail_link = "no_service"
            link_error = r.error
            soft_repaint()
            return
        }
        if r.data.len() == 0 {
            mail_link = "no_account"
            soft_repaint()
            return
        }
        account_id = r.data[0].id
        account_addr = r.data[0].address
        mail_link = "live"
        want_sync = true
    })
}
fn mail_add_account(){
    if nav_recent() { return }
    // the service raises its own sign-in sheet; passwords never reach the app
    host.request("mail.add_account", {}, fn(r){
        if r.is_ok { mail_check() return }
        link_error = r.error
        soft_repaint()
    })
}
fn live_mail(m){
    // list replies carry headers only; body arrives with mail.message on open
    // DIRECT field access ONLY — the makepad VM the shell runs has no
    // mod.std.text/object helpers at all (0.7.21 probe: even object.keys
    // fails), and this exact shape loaded live mails in the shell at 0.7.11
    let v = classify_vibe(m.subject, m.address)
    return {src: "live" id: m.id sender: m.sender bname: m.sender handle: m.address
            subject: m.subject snippet: m.preview body: ""
            time: m.time vibe: v unread: m.unread
            starred: false
            imp: vibe_imp(v)
            summary: [] t0: "" th: "" t1: "" tp: "" t2: ""
            reply: "" reply_text: "" send_error: "" boxed: ""
            summary_src: "none" ai_points: []}
}
fn mail_load(){
    // sync FIRST (mail.list only reads the local cache; mail.sync fills it),
    // then the list goes out over TWO channels: nested here (card-host
    // honours it) and re-issued by the poller. 0.7.18: mail_load itself is
    // now only ever entered FROM the poller — the sync request issued inside
    // the accounts callback never got its reply pumped by the shell.
    // IMAP is genuinely slow and its reply waits for a later pump, so the
    // banner shows honest progress and the poller re-issues (capped).
    syncing = true
    host.request("mail.sync", {account: account_id}, fn(r){
        syncing = false
        if r.is_ok { live_total = r.data.total }
        want_list = true
        soft_repaint()
    })
}
fn mail_list(){
    mail_dbg = "issued"
    host.request("mail.list", {account: account_id limit: 20}, fn(r){
        mail_dbg = "cb-enter"
        if !r.is_ok {
            mail_link = "error"
            link_error = r.error
            mail_dbg = "cb-err"
            soft_repaint()
            return
        }
        mail_dbg = "cb-parsed"
        let out = []
        let i = 0
        while i < r.data.messages.len() {
            out.push(live_mail(r.data.messages[i]))
            i = i + 1
        }
        mail_dbg = "assign"
        mails = out
        mail_dbg = "done n=" + mails.len()
        mail_src = "live"
        live_total = r.data.total
        open_idx = -1
        want_insight = true
        soft_repaint()
    })
}
fn mail_refresh(){
    if nav_recent() { return }
    sync_tries = 0
    mail_link = "checking"
    repaint()
    mail_check()
}
fn mail_open_message(i){
    host.request("mail.message", {account: account_id message: mails[i].id}, fn(r){
        if r.is_ok {
            // raw as delivered: HTML-cleaning needs text tools the shell
            // runtime does not expose (0.7.13 finding) — marketing mails
            // will show their raw text, which is honest, visible content
            mails[i].body = r.data.body
        } else {
            // 解析异常 shows its reason instead of a silent blank
            mails[i].body = "(正文暂时无法获取:" + r.error + ")"
        }
        soft_repaint()
    })
}
fn mail_mark_read(i){
    host.request("mail.mark_read", {account: account_id message: mails[i].id}, fn(r){ })
}
fn mail_disconnect(){
    if nav_recent() { return }
    if mail_arm {
        host.request("mail.remove_account", {account: account_id}, fn(r){
            mail_arm = false
            mail_check()
        })
    } else {
        mail_arm = true
        soft_repaint()
    }
}
// live sends go out through the host's foreground review channel (0.7.28):
// since 10-04 mail.send only answers approval_required — mail.review_send
// opens the native sheet and this callback settles after physical approval
// OR cancellation, so 发送中/审阅中 honestly covers the whole review wait.
fn send_live(){
    let idx = reply_idx
    host.request("mail.review_send", {account: account_id to: to_input
                               subject: subject_input body: preview_text()}, fn(r){
        if r.is_ok && r.data.accepted == true {
            send_state = "sent"
            mark_sent(idx)
        } else {
            if !r.is_ok && r.error.search("Review cancelled") >= 0 {
                // a cancelled review sent nothing and failed nothing: the
                // draft stays, the mail keeps no failure mark, resend offered
                send_state = "cancelled"
                send_error_msg = "已取消审阅 · 未发送"
            } else {
                send_state = "failed"
                if r.is_ok {
                    send_error_msg = "服务未接受"
                } else {
                    let e = r.error
                    if e.search("unavailable on this platform") >= 0 {
                        send_error_msg = "宿主不支持前台审阅发送(仅 macOS/Android)"
                    } else {
                        if e.search("approval_required") >= 0 {
                            send_error_msg = "宿主要求前台审阅批准后才会发送"
                        } else {
                            send_error_msg = e
                        }
                    }
                }
                mark_failed(idx)
            }
        }
        soft_repaint()
    })
}
// MARKER:ADAPTER-END

// ---- AI generation (one-shot model.complete, schema-checked) ---------------
// The host picks the model from the person's own providers; the app never
// sees keys. In card-host nothing answers "model" — surfaces say so and keep
// the labelled practice content / honest fallbacks.
fn gen_summary(i){
    let m = mails[i]
    mails[i].summary_src = "asking"
    repaint()
    host.request("model.complete", {
        task: "阅读这封中文邮件,给出最多3条要点,简洁客观,不编造原文没有的事实。"
        input: {subject: m.subject sender: m.sender body: m.body}
        schema: {type: "object" required: ["points"] additionalProperties: false
                 properties: {points: {type: "array" maxItems: 3 items: {type: "string" maxLength: 60}}}}
        class: "fast"
    }, fn(r){
        if !r.is_ok {
            // classify the refusal honestly (0.7.25): the host's ledger says
            // "…for today." once the per-app daily budget is spent, and
            // "…a minute; …" when the rate limit trips. search() is the only
            // string tool the shell VM has.
            let st = "unavailable"
            if r.error.search("for today") >= 0 { st = "budget" } else {
                if r.error.search("a minute") >= 0 { st = "busy" }
            }
            mails[i].summary_src = st
            // content fallback when the real body already landed: the list's
            // snippet (180 chars, service-side) stands in as the one point.
            // NO string methods here — the shell VM has none (0.7.21).
            if mails[i].snippet != "" {
                mails[i].ai_points = [mails[i].snippet]
            }
            soft_repaint()
            return
        }
        mails[i].ai_points = r.data.output.points
        mails[i].summary_src = "ai"
        // NOTE no meta read: the shell's model service answers meta with
        // {class, requested, attempts, usage, budget} — NO model name.
        // Reading r.data.meta.model threw property-not-found (0.7.24 shell
        // log), which killed this callback BEFORE soft_repaint: the summary
        // arrived but the open detail never repainted — it only showed after
        // the second open's gesture repaint.
        soft_repaint()
    })
}
fn tone_label(){
    if tone == 0 { return "真诚随意" }
    if tone == 1 { return "轻松幽默" }
    if tone == 2 { return "自然友好" }
    if tone == 3 { return "简洁专业" }
    return "正式得体"
}
// rewrite the live reply preview at the current tone (practice targets use
// the canned dataset trio; the fallback keeps the previous text and says so)
fn gen_tone(){
    if reply_idx < 0 { return }
    if mails[reply_idx].src != "live" { return }
    tone_src = "asking"
    tone_note = ""
    repaint()
    let m = mails[reply_idx]
    let base = live_preview
    if base == "" { base = "主题:" + m.subject }
    host.request("model.complete", {
        task: "写一封「" + tone_label() + "」语气的中文回信,保留对方要点,简短(80字内),只输出正文。"
        input: {to: m.handle subject: m.subject reference: base}
        schema: {type: "object" required: ["text"] additionalProperties: false
                 properties: {text: {type: "string" maxLength: 400}}}
        class: "fast"
    }, fn(r){
        if !r.is_ok {
            tone_src = "unavailable"
            tone_note = "模型服务不可用,已保留原文"
            soft_repaint()
            return
        }
        live_preview = r.data.output.text
        tone_src = "ai"
        // same 0.7.24 finding as gen_summary: meta has no model field, and
        // any throw here skips the soft_repaint below (stale preview)
        soft_repaint()
    })
}
fn preview_text(){
    if reply_idx >= 0 {
        let m = mails[reply_idx]
        if m.src == "live" { return live_preview }
        if tone == 0 { return m.t0 }
        if tone == 1 { return m.th }
        if tone == 2 { return m.t1 }
        if tone == 3 { return m.tp }
        return m.t2
    }
    // fresh compose: the reference demo defaults (Mira thread)
    if tone == 0 { return mails[0].t0 }
    if tone == 1 { return mails[0].th }
    if tone == 2 { return mails[0].t1 }
    if tone == 3 { return mails[0].tp }
    return mails[0].t2
}
// 0.7.28: practice targets (canned dataset + fresh compose's demo defaults)
// show fixed copy, not model output — the preview tag 练习文案 and the slider
// header say so, mirroring the 练习摘要 label on the detail card
fn practice_target(){
    if reply_idx < 0 { return true }
    return mails[reply_idx].src != "live"
}

// ---- navigation & actions ---------------------------------------------------
// floating-pill guard: a tap reaches EVERY overlapping GestureView, so a
// nav tap also fires the handler of whatever card/button sits under the
// pill. go() stamps the drift clock; content handlers entered within 0.25s
// (same dispatch) are dropped. Either dispatch order converges on the nav
// switch: card-first leaves the flag unset and go() clears open_idx after.
fn nav_recent(){
    let d = anim_t - nav_gate_t
    if d < 0 { return false }
    return d < 0.25
}
fn go(s){
    nav_gate_t = anim_t
    screen = s
    open_idx = -1
    send_state = "idle"
    send_error_msg = ""
    repaint()
}
fn open_mail(i){
    if nav_recent() { return }
    open_idx = i
    let m = mails[i]
    if m.unread {
        mails[i].unread = false
        if m.src == "live" { want_mark = i }
    }
    if m.src == "live" {
        if m.body == "" { want_body = i }
        // "busy" (rate limit) and "unavailable" (transient) re-ask on the
        // next open — a natural, user-paced retry that costs one call;
        // "budget" does not (pointless until the UTC-day rollover)
        if m.summary_src == "none" || m.summary_src == "busy" || m.summary_src == "unavailable" {
            mails[i].summary_src = "asking"
            want_summary = i
        }
    }
    repaint()
}
fn close_detail(){
    open_idx = -1
    repaint()
}
fn set_filter(v){
    filter = v
    repaint()
}
fn toggle_star(i){
    if nav_recent() { return }
    mails[i].starred = !mails[i].starred
    repaint()
}
fn archive_mail(i){
    if nav_recent() { return }
    mails[i].boxed = "archive"
    open_idx = -1
    want_insight = true
    repaint()
}
fn restore_archived(){
    if nav_recent() { return }
    let n = archived_cnt()
    for i in mails.len() {
        if mails[i].boxed == "archive" { mails[i].boxed = "" }
    }
    if n > 0 { restored_note = "已恢复 " + n + " 封到收件箱" }
    want_insight = true
    repaint()
}
fn open_compose(idx){
    if nav_recent() { return }
    reply_idx = idx
    if idx >= 0 {
        to_input = mails[idx].handle
        subject_input = mails[idx].subject
        live_preview = ""
        if mails[idx].src == "live" {
            tone_src = "canned"
            tone_note = "拖动滑杆,由模型按语气生成;不可用时保留原文"
        } else {
            tone_src = "canned"
            tone_note = ""
        }
    } else {
        to_input = mails[0].handle
        subject_input = "Re: 周末去海边吗?"
        live_preview = ""
        tone_src = "canned"
        tone_note = ""
    }
    tone = 2
    send_state = "idle"
    send_error_msg = ""
    screen = "write"
    open_idx = -1
    repaint()
}
fn set_tone(t){
    if nav_recent() { return }
    tone = t
    if reply_idx >= 0 {
        if mails[reply_idx].src == "live" {
            gen_tone()
            return
        }
    }
    tone_src = "canned"
    tone_note = ""
    repaint()
}
// single-tap send (reference behaviour): sending -> sent | failed |
// cancelled (live review dismissed — nothing sent, draft kept); failed and
// cancelled both keep the draft on the mail and offer a retry
fn do_send(){
    if nav_recent() { return }
    send_state = "sending"
    send_error_msg = ""
    repaint()
    if mail_link == "live" {
        want_send = true
        return
    }
    let idx = reply_idx
    start_timeout(0.9, || finish_send(idx))
}
fn finish_send(idx){
    if simulate_outage {
        send_state = "failed"
        send_error_msg = "发送失败(练习场景)"
        mark_failed(idx)
    } else {
        send_state = "sent"
        mark_sent(idx)
    }
    repaint()
}
fn mark_sent(idx){
    if idx >= 0 {
        mails[idx].reply = "sent"
        mails[idx].reply_text = preview_text()
    }
}
fn mark_failed(idx){
    if idx >= 0 {
        mails[idx].reply = "failed"
        mails[idx].reply_text = preview_text()
        mails[idx].send_error = send_error_msg
    }
}
fn retry_send(){ do_send() }
fn toggle_outage(){
    if nav_recent() { return }
    simulate_outage = !simulate_outage
    repaint()
}

// ---- boot, poller, drift clock ----------------------------------------------
let mail_poll = nil
let anim_poll = nil
let sys_checks = 0
fn poll_step(){
    // flush repaints deferred by host-reply callbacks / timers (see
    // soft_repaint): the poller's own render reaches the screen in every
    // runner, the callbacks' does not
    if ui_dirty {
        ui_dirty = false
        repaint()
    }
    // requests are issued only from this top-level interval or gestures:
    // timers registered inside host-reply callbacks are dropped by the
    // shell's runner. In system mode the same poller samples the host
    // palette every ~2s and follows a Shell light/dark flip.
    //
    // 0.7.9: gesture-raised requests queue here and are issued on this
    // beat — a poller-issued request's reply arrives on later beats, so
    // first-open body/summary no longer wait for the next input event.
    if want_body >= 0 {
        let i = want_body
        want_body = -1
        body_tries = 1
        mail_open_message(i)
    }
    if want_summary >= 0 {
        let i = want_summary
        // 0.7.24: never summarize before the body landed — issuing the model
        // call on the same beat as mail.message sent body:"" and the model
        // answered 「邮件正文为空」 for mails that had one. The flag simply
        // waits (re-checked every beat); a failed fetch (its error-marker
        // body) cancels the ask honestly instead.
        let b = mails[i].body
        if b != "" {
            want_summary = -1
            if b.search("正文暂时无法获取") < 0 {
                summary_wait = 1
                gen_summary(i)
            } else {
                mails[i].summary_src = "unavailable"
                soft_repaint()
            }
        }
    }
    if want_mark >= 0 {
        let i = want_mark
        want_mark = -1
        mail_mark_read(i)
    }
    if want_send {
        want_send = false
        send_live()
    }
    if want_insight {
        if !insight_inflight {
            want_insight = false
            ask_insight()
        }
    }
    if want_sync {
        want_sync = false
        mail_load()
    }
    if syncing {
        if sync_tries < 3 {
            if poll_beat % 25 == 0 {
                sync_tries = sync_tries + 1
                mail_load()
            }
        } else {
            syncing = false
            soft_repaint()
        }
    }
    if want_list {
        want_list = false
        mail_list()
    }
    // paced re-issues while the open live mail is still pending (a reply
    // can be dropped by the shell's runner; ask again every ~2.4s, capped)
    poll_beat = poll_beat + 1
    if open_idx >= 0 {
        let m = mails[open_idx]
        if m.src == "live" {
            if m.body == "" {
                if body_tries > 0 {
                    if body_tries < 5 {
                        if poll_beat % 6 == 0 {
                            body_tries = body_tries + 1
                            mail_open_message(open_idx)
                        }
                    }
                }
            }
            if m.summary_src == "asking" {
                // PATIENCE ONLY — never re-request (0.7.25): every
                // model.complete is billed to the host's per-app budget
                // (default 100 calls / 6 a minute), and re-issuing every
                // 3.2 s while a slow provider was still thinking burned a
                // whole day's budget in one browsing session — every reply
                // then refused, all summaries fell back to 正文截取. One
                // call per open; if nothing lands in ~30 s say so honestly.
                if summary_wait > 0 {
                    summary_wait = summary_wait + 1
                    if summary_wait > 75 {
                        summary_wait = 0
                        mails[open_idx].summary_src = "unavailable"
                        soft_repaint()
                    }
                }
            }
        }
    }
    let g = greeting_for_now()
    if g != greeting_word {
        greeting_word = g
        if screen == "inbox" {
            if open_idx < 0 { repaint() }
        }
    }
    sys_checks = sys_checks + 1
    if themeMode == "system" {
        if sys_checks >= 5 {
            sys_checks = 0
            let want_light = resolve_theme()
            if want_light != themeLight {
                apply_theme(want_light)
                repaint()
            }
        }
    }
}
fn anim_step(){
    // the drift clock: only the star map repaints on the beat (its bubbles
    // are the one surface whose offsets derive from anim_t); other screens
    // repaint on state changes only. An inbox re-mint on the beat breaks an
    // in-flight scroll drag (0.7.1 route finding: routes 5/6 could not scroll
    // the list any more) — so the greeting aura stays static, unlike the
    // reference's drifting blur balls.
    anim_t = anim_t + 0.15
    if screen == "orbit" {
        if open_idx < 0 { repaint() }
    }
}
fn boot(){
    load_theme_mode()
    apply_theme(resolve_theme())
    greeting_word = greeting_for_now()
    repaint()
    want_insight = true
    mail_check()
    mail_poll = start_interval(0.4, || poll_step())
    anim_poll = start_interval(0.15, || anim_step())
}
start_timeout(0.05, || boot())

// ---- drawn icon family ---------------------------------------------------
// 0.7.2 redesign — one LINE-icon grammar instead of filled blobs: 2u capsule
// strokes on the 16px grid (u = size/16), outlines as iring rects, diagonals
// as unrolled chains of overlapping round cells, knobs/dots as icell. Same
// primitive set as 0.6.17 (runtime SVG rasterises blank; font dingbats are
// uncontrolled under CJK fallbacks), but every glyph now shares one stroke
// weight, one corner rounding and one optical padding.
// RUNTIME FINDING (0.7.2): a helper fn minting widgets when CALLED FROM a
// View literal keeps only its first/last roots (idiag drew 2 dots of 9, at
// any argument form — sums, lets and products all evaluate fine when the
// icell sits directly in the icon body, per a 7-cell probe). Every diagonal
// is therefore written out as literal size-fraction icell chains.
fn ipart(canvas, cx, cy, w, h, color, rad){
    View{width: canvas height: canvas align: Align{x: cx / canvas y: cy / canvas}
        RoundedView{width: w height: h draw_bg +: {color: color border_radius: rad}}}
}
fn iring(canvas, cx, cy, w, h, color, rad, bw){
    View{width: canvas height: canvas align: Align{x: cx / canvas y: cy / canvas}
        RoundedView{width: w height: h draw_bg +: {color: #x00000000 border_radius: rad border_size: bw border_color: color}}}
}
fn icell(canvas, cx, cy, s, color){
    View{width: canvas height: canvas align: Align{x: cx / canvas y: cy / canvas}
        RoundedView{width: s height: s draw_bg +: {color: color border_radius: s * 0.5}}}
}
// AI sparkle: lucide "sparkles" — big four-point star + small plus + dot
fn spark_icon(color, size){
    let u = size / 16.0
    View{width: size height: size flow: Overlay
        icell(size, size * 0.5, size * 0.5, size * 0.30, color)
        ipart(size, size * 0.5, size * 0.265, 2.1 * u, size * 0.27, color, 1.05 * u)
        ipart(size, size * 0.5, size * 0.735, 2.1 * u, size * 0.27, color, 1.05 * u)
        ipart(size, size * 0.265, size * 0.5, size * 0.27, 2.1 * u, color, 1.05 * u)
        ipart(size, size * 0.735, size * 0.5, size * 0.27, 2.1 * u, color, 1.05 * u)
        icell(size, size * 0.833, size * 0.125, 1.9 * u, color)
        icell(size, size * 0.833, size * 0.208, 1.9 * u, color)
        icell(size, size * 0.792, size * 0.167, 1.9 * u, color)
        icell(size, size * 0.875, size * 0.167, 1.9 * u, color)
        icell(size, size * 0.167, size * 0.833, 2.6 * u, color)
    }
}
// envelope: rounded-rect outline + V fold to centre
fn mail_icon(color, size, cut){
    let u = size / 16.0
    View{width: size height: size flow: Overlay
        iring(size, size * 0.5, size * 0.52, size * 0.80, size * 0.60, color, size * 0.12, 1.9 * u)
        icell(size, size * 0.2250, size * 0.3400, 1.9 * u, color)
        icell(size, size * 0.2594, size * 0.3694, 1.9 * u, color)
        icell(size, size * 0.2938, size * 0.3988, 1.9 * u, color)
        icell(size, size * 0.3281, size * 0.4281, 1.9 * u, color)
        icell(size, size * 0.3625, size * 0.4575, 1.9 * u, color)
        icell(size, size * 0.3969, size * 0.4869, 1.9 * u, color)
        icell(size, size * 0.4313, size * 0.5163, 1.9 * u, color)
        icell(size, size * 0.4656, size * 0.5456, 1.9 * u, color)
        icell(size, size * 0.5000, size * 0.5750, 1.9 * u, color)
        icell(size, size * 0.7750, size * 0.3400, 1.9 * u, color)
        icell(size, size * 0.7406, size * 0.3694, 1.9 * u, color)
        icell(size, size * 0.7063, size * 0.3988, 1.9 * u, color)
        icell(size, size * 0.6719, size * 0.4281, 1.9 * u, color)
        icell(size, size * 0.6375, size * 0.4575, 1.9 * u, color)
        icell(size, size * 0.6031, size * 0.4869, 1.9 * u, color)
        icell(size, size * 0.5688, size * 0.5163, 1.9 * u, color)
        icell(size, size * 0.5344, size * 0.5456, 1.9 * u, color)
        icell(size, size * 0.5000, size * 0.5750, 1.9 * u, color)
    }
}
// favourite star: lucide star — FILLED five-point silhouette, tiled with
// overlapping discs along each spike plus a pentagon core (a sparse dot
// cluster read as a blob, 0.7.2 finding; the tiling follows the real path
// vertices so the silhouette reads correctly even at 11px)
fn star_icon(color, size){
    let u = size / 16.0
    View{width: size height: size flow: Overlay
        // pentagon core
        icell(size, size * 0.500, size * 0.479, size * 0.24, color)
        icell(size, size * 0.500, size * 0.354, size * 0.20, color)
        icell(size, size * 0.617, size * 0.438, size * 0.20, color)
        icell(size, size * 0.571, size * 0.579, size * 0.20, color)
        icell(size, size * 0.429, size * 0.579, size * 0.20, color)
        icell(size, size * 0.383, size * 0.438, size * 0.20, color)
        // top spike
        icell(size, size * 0.500, size * 0.130, size * 0.17, color)
        icell(size, size * 0.500, size * 0.205, size * 0.19, color)
        icell(size, size * 0.500, size * 0.283, size * 0.21, color)
        // upper-right spike
        icell(size, size * 0.688, size * 0.350, size * 0.17, color)
        icell(size, size * 0.756, size * 0.362, size * 0.16, color)
        icell(size, size * 0.823, size * 0.374, size * 0.15, color)
        icell(size, size * 0.880, size * 0.383, size * 0.14, color)
        // upper-right edge descending
        icell(size, size * 0.846, size * 0.454, size * 0.16, color)
        icell(size, size * 0.779, size * 0.521, size * 0.17, color)
        // lower-right spike
        icell(size, size * 0.725, size * 0.616, size * 0.17, color)
        icell(size, size * 0.737, size * 0.690, size * 0.17, color)
        icell(size, size * 0.749, size * 0.763, size * 0.16, color)
        icell(size, size * 0.758, size * 0.836, size * 0.15, color)
        // bottom notch right + left
        icell(size, size * 0.668, size * 0.742, size * 0.16, color)
        icell(size, size * 0.584, size * 0.741, size * 0.17, color)
        icell(size, size * 0.416, size * 0.741, size * 0.17, color)
        icell(size, size * 0.332, size * 0.742, size * 0.16, color)
        // lower-left spike
        icell(size, size * 0.242, size * 0.836, size * 0.15, color)
        icell(size, size * 0.251, size * 0.763, size * 0.16, color)
        icell(size, size * 0.263, size * 0.690, size * 0.17, color)
        icell(size, size * 0.275, size * 0.616, size * 0.17, color)
        // upper-left edge
        icell(size, size * 0.221, size * 0.521, size * 0.17, color)
        icell(size, size * 0.154, size * 0.454, size * 0.16, color)
        // upper-left spike
        icell(size, size * 0.120, size * 0.383, size * 0.14, color)
        icell(size, size * 0.177, size * 0.374, size * 0.15, color)
        icell(size, size * 0.244, size * 0.362, size * 0.16, color)
        icell(size, size * 0.312, size * 0.350, size * 0.17, color)
    }
}
// check: lucide check — long diagonal + short return
fn check_icon(color, size){
    let u = size / 16.0
