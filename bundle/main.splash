// ---- deep-space palette (tokens from the web reference, alpha pre-blended
// on the #05070f ground) -----------------------------------------------------
let space    = #x05070f      // page ground
let panel    = #x0b1120      // card panel (approx 0.72 over ground)
let panel2   = #x0d1526      // raised panel
let glass    = #x080c19      // nav glass
let line     = #x141523      // hairline
let line2    = #x26263b      // stronger hairline
let ink      = #xe9e6df      // primary text
let ink66    = #x9b9a98
let ink55    = #x828281
let ink45    = #x6c6b6d
let ink38    = #x5c5c5e
let ink32    = #x4e4e52
let violet   = #x8642ff      // agent accent
let violetT  = #xb7a8ff      // violet text
let violetBg = #x170f31      // violet-tinted panel
let violetBd = #x353350      // violet-ish border
let violetHi = #xc4b0ff      // active nav text
let cyan     = #x22d3ee
let cyanT    = #x67e8f9
let cyanBg   = #x081b25
let mint     = #x34d399
let mintT    = #x6ee7b7
let mintBg   = #x0a1b1d
let amber    = #xfbbf24
let amberT   = #xfcd34d
let amberBg  = #x1e1911
let red      = #xf87171
let redT     = #xfca5a5
let redBg    = #x22141b
let white7   = #x161820      // track / hover base

// ---- helpers --------------------------------------------------------------
fn pick(c, a, b){ if c { return a } return b }
fn first_line(s){ let ls = s.split("\n") return ls[0] }
fn domain_of(a){
    let parts = a.split("@")
    if parts.len() > 1 { return parts[1] }
    return a
}
// tone -> chip colors (label chips everywhere read these)
fn chip_fg(tone){
    if tone == "violet" { return violetT }
    if tone == "cyan" { return cyanT }
    if tone == "amber" { return amberT }
    if tone == "red" { return redT }
    return mintT
}
fn chip_bg(tone){
    if tone == "violet" { return #x140e2c }
    if tone == "cyan" { return cyanBg }
    if tone == "amber" { return amberBg }
    if tone == "red" { return redBg }
    return mintBg
}
// priority -> score color (>=85 red, >=65 amber, >=45 cyan, else violet-2)
fn pri_color(p){
    if p >= 85 { return red }
    if p >= 65 { return amber }
    if p >= 45 { return cyan }
    return #x9a92d9
}
fn pri_w(p){
    if p >= 95 { return 34 }
    if p >= 85 { return 31 }
    if p >= 65 { return 24 }
    if p >= 45 { return 17 }
    if p >= 25 { return 10 }
    return 5
}
fn has_label(m, t){
    for l in m.labels { if l.text == t { return true } }
    return false
}
fn pass_filter(i){
    if filter == "urgent" { return mails[i].priority >= 85 }
    if filter == "reply" { return has_label(mails[i], "需回复") }
    if filter == "later" {
        if mails[i].priority >= 85 { return false }
        if has_label(mails[i], "需回复") { return false }
        return true
    }
    return true
}
fn cnt(kind){
    let n = 0
    for i in mails.len() {
        if kind == "all" { n = n + 1 }
        if kind == "urgent" { if mails[i].priority >= 85 { n = n + 1 } }
        if kind == "reply" { if has_label(mails[i], "需回复") { n = n + 1 } }
        if kind == "later" {
            if mails[i].priority < 85 {
                if !has_label(mails[i], "需回复") { n = n + 1 }
            }
        }
    }
    return n
}

// ---- mail data layer (official host service) -----------------------------
// MARKER:ADAPTER — the dev overlay (scripts/dev_bundle.py) replaces the block
// between the two MARKER lines with dev/adapter-bridge.splash; both expose
// the same function set. Three honest states: no service answers (card-host,
// practice data), no account yet (the host's own sheet adds one), or live
// mail through the platform's mail service — where real IMAP/SMTP happens;
// the app itself never holds credentials.
let mail_src = "practice"      // practice | live  — where the list came from
let mail_link = "checking"     // checking | no_service | no_account | error | live
let link_error = ""
let account_id = ""
let account_addr = ""
let live_total = 0

fn mail_check(){
    if !host.has("mail") {
        mail_link = "no_service"
        link_error = "此环境未提供邮件服务(card-host)"
        ui.body.render()
        return
    }
    host.request("mail.accounts", {}, fn(r){
        if !r.is_ok {
            mail_link = "no_service"
            link_error = r.error
            ui.body.render()
            return
        }
        if r.data.len() == 0 {
            mail_link = "no_account"
            ui.body.render()
            return
        }
        account_id = r.data[0].id
        account_addr = r.data[0].address
        mail_link = "live"
        mail_load()
    })
}
fn mail_add_account(){
    // the service raises its own sign-in sheet; passwords never reach the app
    host.request("mail.add_account", {}, fn(r){
        if r.is_ok { mail_check() return }
        link_error = r.error
        ui.body.render()
    })
}
fn live_mail(m){
    return {src: "live" id: m.id init: "✉" sender: m.sender address: m.address
            subject: m.subject snippet: m.preview body: m.body
            time: m.time unread: m.unread priority: 50 cluster: "工作"
            av1: #x8642ff av2: #x4c1d95
            labels: [{text: domain_of(m.address) tone: "cyan"}]
            summary: [] actions: []
            sent_label: "" sent_tone: "mint" sent_note: ""
            replies: [] meeting_title: "" meeting_time: "" meeting_loc: ""
            generating: false
            reply: "" reply_text: "" send_error: ""
            summary_src: "practice" ai_points: [] ai_action: ""}
}
fn mail_load(){
    host.request("mail.list", {account: account_id limit: 20}, fn(r){
        if !r.is_ok {
            mail_link = "error"
            link_error = r.error
            ui.body.render()
            return
        }
        let out = []
        for i in r.data.messages.len() {
            out.push(live_mail(r.data.messages[i]))
        }
        mails = out
        mail_src = "live"
        live_total = r.data.total
        current = 0
        ui.body.render()
    })
}
fn mail_open_message(i){
    // the list carries previews; the full body comes with the message itself
    host.request("mail.message", {account: account_id message: mails[i].id}, fn(r){
        if r.is_ok {
            mails[i].body = r.data.body
            ui.body.render()
        }
    })
}
fn mail_mark_read(i){
    host.request("mail.mark_read", {account: account_id message: mails[i].id}, fn(r){ })
}
fn mail_send_live(i){
    let m = mails[i]
    host.request("mail.send", {account: account_id to: m.address
                               subject: "回复:" + m.subject body: m.reply_text}, fn(r){
        if r.is_ok && r.data.accepted == true {
            mails[i].reply = "sent"
        } else {
            mails[i].reply = "failed"
            if !r.is_ok { mails[i].send_error = r.error } else { mails[i].send_error = "服务未接受" }
        }
        ui.body.render()
    })
}
// MARKER:ADAPTER-END

// ---- navigation -----------------------------------------------------------
// ui is injected only after the body evaluates, so the first frame draws an
// empty body; a boot timeout re-renders it once ui exists (README pattern).
fn boot(){ ui.body.render(); mail_check() }
start_timeout(0.05, || boot())

fn go(s){ screen = s; ui.body.render() }
fn open_mail(i){
    // desktop master-detail: selecting a mail fills the reader pane in place
    current = i
    selected = true
    ui.body.render()
    if mails[i].src == "live" {
        mail_open_message(i)
        mail_mark_read(i)
    }
}
fn set_filter(f){ filter = f; ui.body.render() }

// ---- reply lifecycle: draft -> confirm -> sending -> sent / failed --------
// ---- AI generation via the host's one-shot model service ------------------
// One-shot, schema-checked model.complete (OctoSense#95, merged 2026-09-28):
// the host picks the model from the person's own AI providers; the app never
// sees providers or keys. In card-host nothing answers "model" — the UI says
// so and keeps the local practice content.
fn summary_pill_text(src){
    if src == "asking" { return "生成中…" }
    if src == "ai" { return "模型生成" }
    if src == "unavailable" { return "服务不可用" }
    return "练习数据"
}
fn gen_summary(i){
    let m = mails[i]
    mails[i].summary_src = "asking"
    summary_error = ""
    ui.body.render()
    host.request("model.complete", {
        task: "阅读这封中文邮件,给出最多3条要点,简洁客观,不编造原文没有的事实。"
        input: {subject: m.subject sender: m.sender body: m.body}
        schema: {type: "object" required: ["points"] additionalProperties: false
                 properties: {points: {type: "array" maxItems: 3 items: {type: "string" maxLength: 60}}}}
        class: "fast"
    }, fn(r){
        if !r.is_ok {
            mails[i].summary_src = "unavailable"
            summary_error = r.error
            ui.body.render()
            return
        }
        mails[i].ai_points = r.data.output.points
        mails[i].summary_src = "ai"
        ui.body.render()
    })
}

fn open_reply(){ compose_mode = "reply"; go("write") }
fn open_forward(){ compose_mode = "forward"; go("write") }
fn edit_draft(i){ draft_text = mails[i].reply_text; go("write") }
fn ask_send(i){ mails[i].reply = "confirm"; ui.body.render() }
fn cancel_send(i){ mails[i].reply = "pending"; ui.body.render() }
fn do_send(i){
    mails[i].reply = "sending"
    ui.body.render()
    if mails[i].src == "live" { mail_send_live(i) return }
    let idx = i
    start_timeout(0.9, || finish_send(idx))
}
fn finish_send(i){
    if simulate_outage { mails[i].reply = "failed" } else { mails[i].reply = "sent" }
    ui.body.render()
}
fn retry_send(i){ do_send(i) }
fn keep_draft(i){ mails[i].reply = "pending"; ui.body.render() }
fn toggle_outage(){ simulate_outage = !simulate_outage; ui.body.render() }
fn compose_target(){
    let m = mails[current]
    if compose_mode == "forward" { return "转发给: " + m.sender }
    return "回复给: " + m.sender
}
// The practice subjects already carry "Re: " — never stack a second prefix
// (no string slicing in this language, so a reply quotes the subject as-is
// and only a forward gets a prefix).
fn compose_subject(){
    let m = mails[current]
    if compose_mode == "forward" { return "转发: " + m.subject }
    return m.subject
}
// A smart-reply chip attaches a one-tap draft to the mail; it still goes
// through the same pending -> confirm -> send lifecycle, never sending itself.
fn quick_reply(i, q){
    let m = mails[i]
    draft_text = "你好:\n\n关于「" + m.subject + "」:" + q + "。\n\n(智能回复草稿,可编辑后发送)"
    mails[i].reply_text = draft_text
    mails[i].reply = "pending"
    ui.body.render()
}

// ---- shared bits -----------------------------------------------------------
fn chip(text, tone){
    RoundedView{width: Fit height: Fit padding: Inset{top: 2 bottom: 2 left: 6 right: 6}
        draw_bg +: {color: chip_bg(tone) border_radius: 6.0 border_size: 1.0 border_color: chip_fg(tone)}
        Label{text: text draw_text.color: chip_fg(tone) draw_text.text_style.font_size: 9}}
}
fn label_row(m){
    View{width: Fill height: Fit flow: Right spacing: 4
        for l in m.labels { chip(l.text, l.tone) }
    }
}
// AI priority meter: track + gradient fill + mono score
fn priority_meter(m){
    View{width: Fit height: Fit flow: Right spacing: 5 align: Align{y: 0.5}
        RoundedView{width: 36 height: 3 draw_bg +: {color: white7 border_radius: 2.0} flow: Overlay
            RoundedView{width: pri_w(m.priority) height: 3 draw_bg +: {g1: violet g2: pri_color(m.priority) border_radius: 2.0}}
        }
        Label{text: "" + m.priority draw_text.color: pri_color(m.priority) draw_text.text_style.font_size: 9}
    }
}
fn avatar(m, size){
    RoundedView{width: size height: size draw_bg +: {g1: m.av1 g2: m.av2 border_radius: size / 2.0} align: Align{x: 0.5 y: 0.5}
        Label{text: m.init draw_text.color: #xffffffff draw_text.text_style: theme.font_bold{font_size: size * 0.4}}
    }
}
// Reply state outranks the static labels: once a draft exists every surface
// shows the live pill instead of the stale triage tags.
fn state_pill(m){
    if m.reply == "sent" {
        RoundedView{width: Fit height: Fit padding: Inset{top: 2 bottom: 2 left: 6 right: 6}
            draw_bg +: {color: mintBg border_radius: 6.0 border_size: 1.0 border_color: mintT}
            Label{text: "已回复" draw_text.color: mintT draw_text.text_style.font_size: 9}}
    } else {
        if m.reply == "pending" {
            RoundedView{width: Fit height: Fit padding: Inset{top: 2 bottom: 2 left: 6 right: 6}
                draw_bg +: {color: #x140e2c border_radius: 6.0 border_size: 1.0 border_color: violetT}
                Label{text: "待发送" draw_text.color: violetT draw_text.text_style.font_size: 9}}
        } else {
            if m.reply == "failed" {
                RoundedView{width: Fit height: Fit padding: Inset{top: 2 bottom: 2 left: 6 right: 6}
                    draw_bg +: {color: redBg border_radius: 6.0 border_size: 1.0 border_color: redT}
                    Label{text: "发送失败" draw_text.color: redT draw_text.text_style.font_size: 9}}
            } else {
                RoundedView{width: 0 height: 0}
            }
        }
    }
}
// VibeMark: violet->cyan rounded square with a V and a cyan dot
fn vibe_mark(size){
    RoundedView{width: size height: size draw_bg +: {g1: violet g2: cyan border_radius: 10.0} align: Align{x: 0.5 y: 0.5}
        Label{text: "V" draw_text.color: #xffffffff draw_text.text_style: theme.font_bold{font_size: size * 0.55}}
    }
}
// The mint status pill: a live agent is watching the inbox
fn agent_pill(){
    RoundedView{width: Fit height: Fit padding: Inset{top: 4 bottom: 4 left: 10 right: 10}
        draw_bg +: {color: mintBg border_radius: 12.0 border_size: 1.0 border_color: #x113a32}
        View{width: Fit height: Fit flow: Right spacing: 6 align: Align{y: 0.5}
            RoundedView{width: 5 height: 5 draw_bg +: {color: mint border_radius: 3.0}}
            Label{text: "VIBE AGENT · 运行中" draw_text.color: mintT draw_text.text_style.font_size: 9}
        }
    }
}
fn title_pair(){
    let zh = "智能收件箱"
    let en = "SMART INBOX"
    if screen == "write" { zh = "AI 写信" en = "AI COMPOSE" }
    if screen == "agents" { zh = "Agent 小队" en = "AGENT SQUAD" }
    View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
        vibe_mark(26)
        View{width: Fill height: Fit flow: Down spacing: 1
            Label{text: zh draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
            Label{text: en draw_text.color: ink32 draw_text.text_style.font_size: 8}
        }
    }
}
fn top_bar(){
    View{width: Fill height: Fit flow: Right spacing: 10 align: Align{y: 0.5}
        title_pair()
        agent_pill()
    }
}

// ---- view 1: 智能收件箱 ------------------------------------------------------
// The triage banner doubles as the mail-service state line: practice counts,
// or the honest live / no-account / no-service status the demo relies on.
fn banner_line(){
    if mail_link == "checking" { return "正在连接邮件服务…" }
    if mail_link == "live" { return "已连接 " + account_addr + " · " + live_total + " 封真实邮件" }
    if mail_link == "no_account" { return "未添加邮箱账号 · 点右侧按钮,由宿主登录面板添加" }
    if mail_link == "error" { return "邮箱连接失败:" + link_error }
    return "邮件服务不可用 · 当前为练习数据(" + link_error + ")"
}
fn filter_chip(key, label, count, active_fg){
    ButtonFlat{height: 30 padding: Inset{left: 10 right: 10} text: label + " " + count on_click: || set_filter(key)
        draw_bg +: {color: pick(filter == key, violetBg, #x00000000) color_hover: white7 color_down: white7
                    border_radius: 8.0 border_size: 1.0 border_color: pick(filter == key, violet, line2)}
        draw_text +: {color: pick(filter == key, active_fg, ink45)}}
}
fn triage_banner(){
    RoundedView{width: Fill height: Fit padding: Inset{top: 12 bottom: 12 left: 12 right: 12}
        draw_bg +: {color: panel border_radius: 14.0 border_size: 1.0 border_color: line}
        GestureView{width: Fill height: Fit on_tap: |x, y| mail_check()
            View{width: Fill height: Fit flow: Down spacing: 10
                View{width: Fill height: Fit flow: Right spacing: 9 align: Align{y: 0.5}
                    RoundedView{width: 24 height: 24 draw_bg +: {color: violetBg border_radius: 8.0} align: Align{x: 0.5 y: 0.5}
                        Label{text: "✦" draw_text.color: violetT draw_text.text_style.font_size: 12}
                    }
                    Label{width: Fill text: "Vibe Agent 已分诊今日 " + cnt("all") + " 封邮件 — " + cnt("urgent") + " 封紧急 · " + cnt("reply") + " 封需回复 · " + cnt("later") + " 封可稍后"
                          draw_text.color: ink66 draw_text.text_style.font_size: 11}
                }
                View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                    Label{width: Fill text: banner_line() draw_text.color: ink45 draw_text.text_style.font_size: 10}
                    if mail_link == "no_account" {
                        ButtonFlat{text: "添加账号" on_click: || mail_add_account()
                            draw_bg +: {g1: violet g2: #x6a35e8 color_hover: violet color_down: #x6a35e8 border_radius: 10.0 border_size: 0.0}
                            draw_text +: {color: #xffffffff}}
                    }
                }
                View{width: Fill height: Fit flow: Right spacing: 5
                    filter_chip("all", "全部", cnt("all"), ink)
                    filter_chip("urgent", "紧急", cnt("urgent"), redT)
                    filter_chip("reply", "需回复", cnt("reply"), amberT)
                    filter_chip("later", "可稍后", cnt("later"), #x9a92d9)
                }
            }
        }
    }
}
// `sel` highlights the open mail — the read view's list column keeps state
// visible while the reader pane carries the content.
// NOTE: the GestureView must be the minted child itself. Wrapping it in a
// plain `View{width: Fill height: Fit}` (flow unset) breaks hit-testing on
// this stack — taps fall through the wrapper entirely.
fn mail_row(i, sel){
    let m = mails[i]
    RoundedView{width: Fill height: Fit padding: Inset{top: 11 bottom: 11 left: 12 right: 12}
        draw_bg +: {color: pick(sel, #x170f31, panel) border_radius: 13.0 border_size: 1.0 border_color: pick(sel, violet, line)}
        GestureView{width: Fill height: Fit on_tap: |x, y| open_mail(i)
            View{width: Fill height: Fit flow: Right spacing: 11
                View{width: Fit height: Fit flow: Overlay
                    avatar(m, 38)
                    if m.unread {
                        View{width: Fill height: Fill align: Align{x: 1.0 y: 0.0}
                            RoundedView{width: 9 height: 9 draw_bg +: {color: violet border_radius: 5.0}}
                        }
                    }
                }
                View{width: Fill height: Fit flow: Down spacing: 3
                    View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                        Label{width: Fill text: m.sender
                              draw_text.color: pick(m.unread, ink, #xb0aeab)
                              draw_text.text_style: theme.font_bold{font_size: 12}}
                        // fixed width: a Fit-width trailing label after a
                        // Fill sibling gets squeezed to slivers on narrow rows
                        Label{width: 44 text: m.time draw_text.color: ink38 draw_text.text_style.font_size: 9}
                    }
                    Label{width: Fill text: m.subject draw_text.color: pick(m.unread, #xcecbc6, #x9b9a98) draw_text.text_style.font_size: 12}
                    Label{width: Fill text: m.snippet draw_text.color: ink45 draw_text.text_style.font_size: 10}
                    View{width: Fill height: Fit flow: Right spacing: 4
                        if m.generating {
                            RoundedView{width: Fit height: Fit padding: Inset{top: 2 bottom: 2 left: 6 right: 6}
                                draw_bg +: {color: #x140e2c border_radius: 6.0 border_size: 1.0 border_color: violet}
                                Label{text: "AI 摘要生成中…" draw_text.color: violetT draw_text.text_style.font_size: 9}}
                        } else {
                            // two labels max in the row: the full set lives on
                            // the read view, the meter needs the width here
                            if m.labels.len() > 0 { chip(m.labels[0].text, m.labels[0].tone) }
                            if m.labels.len() > 1 { chip(m.labels[1].text, m.labels[1].tone) }
                        }
                        state_pill(m)
                        priority_meter(m)
                        View{width: Fill height: 1}
                    }
                }
            }
        }
    }
}
// ---- desktop horizontal layout ----------------------------------------------
// 0.3.0 drops the portrait UI entirely: a left rail navigates, and the inbox
// is a permanent master-detail — a fixed-width list of mail CARDS beside a
// Fill reader pane that fills in place when a card is selected (no screen
// push). The [Fill margin][fixed column][Fill margin] centring is kept for
// the compose/agents columns; it is harmless at desktop widths.
fn preview_pane(){
    View{width: Fill height: Fit padding: Inset{top: 60 bottom: 12 left: 18 right: 10} flow: Down
        RoundedView{width: Fill height: Fit padding: Inset{top: 56 bottom: 56 left: 34 right: 34}
            draw_bg +: {color: panel border_radius: 18.0 border_size: 1.0 border_color: line}
            flow: Down spacing: 14 align: Align{x: 0.5}
            RoundedView{width: 56 height: 56 draw_bg +: {g1: violet g2: cyan border_radius: 18.0} align: Align{x: 0.5 y: 0.5}
                Label{text: "✦" draw_text.color: #xffffffff draw_text.text_style.font_size: 24}}
            Label{text: "选择一封邮件开始阅读" draw_text.color: ink66 draw_text.text_style: theme.font_bold{font_size: 15}}
            Label{width: Fill text: "Vibe Agent 已为 " + cnt("all") + " 封邮件生成摘要、优先级与建议动作。点击左侧任意邮件卡片,AI 摘要、会议识别与快速回复会出现在这里。" draw_text.color: ink45 draw_text.text_style.font_size: 11}
        }
    }
}
fn inbox_screen(){
    View{width: Fill height: Fit flow: Right spacing: 14
        View{width: 470 height: Fit flow: Down spacing: 12
            top_bar()
            triage_banner()
            View{width: Fill height: Fit flow: Down spacing: 8
                for i in mails.len() {
                    if pass_filter(i) { mail_row(i, selected && i == current) }
                }
            }
            Label{width: Fill text: "AI 优先级为练习数据评分,真实邮件接入后由模型服务生成。" draw_text.color: ink32 draw_text.text_style.font_size: 9}
        }
        reader_pane()
    }
}

// ---- view 2: 邮件阅读 + AI 摘要 ----------------------------------------------
// The summary card always labels its source: the shipped practice points, or
// output of the host's model service (regenerated on demand). Unavailable is
// shown as a normal state, never silently swapped.
fn ai_summary_card(i){
    let m = mails[i]
    let pts = m.summary
    if m.summary_src == "ai" { pts = m.ai_points }
    RoundedView{width: Fill height: Fit padding: Inset{top: 14 bottom: 14 left: 14 right: 14}
        draw_bg +: {color: panel border_radius: 14.0 border_size: 1.0 border_color: violetBd}
        View{width: Fill height: Fit flow: Down spacing: 9
            View{width: Fill height: Fit flow: Right spacing: 7 align: Align{y: 0.5}
                Label{text: "✦" draw_text.color: violetT draw_text.text_style.font_size: 11}
                Label{text: "AI 摘要" draw_text.color: violetT draw_text.text_style: theme.font_bold{font_size: 12}}
                RoundedView{width: Fit height: Fit padding: Inset{top: 2 bottom: 2 left: 7 right: 7}
                    draw_bg +: {color: #x140e2c border_radius: 9.0 border_size: 1.0 border_color: violetBd}
                    Label{text: summary_pill_text(m.summary_src) draw_text.color: violetT draw_text.text_style.font_size: 9}}
                ButtonFlat{width: 64 height: 26 text: "AI 生成" on_click: || gen_summary(i)
                    draw_bg +: {g1: violet g2: #x6a35e8 color_hover: violet color_down: #x6a35e8 border_radius: 10.0 border_size: 0.0}
                    draw_text +: {color: #xffffffff}}
                View{width: Fill height: 1}
            }
            if m.summary_src == "practice" && m.summary.len() == 0 {
                Label{width: Fill text: "这封真实邮件还没有摘要 — 点「AI 生成」由模型总结。" draw_text.color: ink55 draw_text.text_style.font_size: 11}
            }
            for p in pts {
                View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                    RoundedView{width: 5 height: 5 draw_bg +: {g1: violet g2: cyan border_radius: 3.0}}
                    Label{width: Fill text: p draw_text.color: #xb7b5b1 draw_text.text_style.font_size: 11}
                }
            }
            if m.actions.len() > 0 {
                View{width: Fill height: Fit flow: Right spacing: 5
                    View{width: Fill height: 1 draw_bg.color: line}
                }
                View{width: Fill height: Fit flow: Down spacing: 6
                    for a in m.actions {
                        RoundedView{width: Fit height: Fit padding: Inset{top: 3 bottom: 3 left: 8 right: 8}
                            draw_bg +: {color: amberBg border_radius: 7.0 border_size: 1.0 border_color: amber}
                            Label{text: a.text + pick(a.due == "", "", " · ⏱ " + a.due) draw_text.color: amberT draw_text.text_style.font_size: 10}
                        }
                    }
                }
            }
            if m.sent_label != "" {
                View{width: Fill height: Fit flow: Right spacing: 6 align: Align{y: 0.5}
                    chip(m.sent_label, m.sent_tone)
                    Label{width: Fill text: m.sent_note draw_text.color: ink55 draw_text.text_style.font_size: 9}
                }
            }
            if m.summary_src == "unavailable" {
                Label{width: Fill text: "模型服务不可用,当前展示练习数据:" + summary_error draw_text.color: redT draw_text.text_style.font_size: 9}
            }
        }
    }
}
fn meeting_card(m){
    if m.meeting_title != "" {
        RoundedView{width: Fill height: Fit padding: Inset{top: 13 bottom: 13 left: 14 right: 14}
            draw_bg +: {color: panel border_radius: 14.0 border_size: 1.0 border_color: cyanBg}
            View{width: Fill height: Fit flow: Down spacing: 8
                View{width: Fill height: Fit flow: Right spacing: 7 align: Align{y: 0.5}
                    Label{text: "✦" draw_text.color: cyanT draw_text.text_style.font_size: 11}
                    Label{width: Fill text: "AI 识别到会议意向" draw_text.color: cyanT draw_text.text_style.font_size: 10}
                }
                Label{width: Fill text: m.meeting_title draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 13}}
                View{width: Fill height: Fit flow: Right spacing: 12
                    Label{text: m.meeting_time draw_text.color: ink55 draw_text.text_style.font_size: 10}
                    Label{text: m.meeting_loc draw_text.color: ink55 draw_text.text_style.font_size: 10}
                }
                View{width: Fill height: Fit flow: Right spacing: 8
                    ButtonFlat{height: 30 text: "加入日历" on_click: || go("agents")
                        draw_bg +: {g1: violet g2: #x6a35e8 color_hover: violet color_down: #x6a35e8 border_radius: 8.0 border_size: 0.0}
                        draw_text +: {color: #xffffffff}}
                    ButtonFlat{height: 30 text: "协商改期" on_click: || open_reply()
                        draw_bg +: {color: #x00000000 color_hover: white7 color_down: white7 border_radius: 8.0 border_size: 1.0 border_color: line2}
                        draw_text +: {color: ink55}}
                }
            }
        }
    }
}
// NOTE: the reply chip is minted through a fn so `q` binds at CALL time —
// an on_click closure written directly inside `for q in m.replies` resolves
// the loop variable at CLICK time (late binding) and silently no-ops.
fn reply_chip(i, q){
    ButtonFlat{height: 34 padding: Inset{left: 12 right: 12} text: "✦ " + q on_click: || quick_reply(i, q)
        draw_bg +: {color: #x140e2c color_hover: #x1c1440 color_down: #x140e2c border_radius: 17.0 border_size: 1.0 border_color: violetBd}
        draw_text +: {color: #xd6c8ff text_style.font_size: 11}}
}
fn smart_replies(i, m){
    if m.replies.len() > 0 {
        // one chip per row: three in a row squeeze the third out of a
        // narrow reader pane (the Fit-after-Fit overflow squeeze class)
        View{width: Fill height: Fit flow: Down spacing: 6
            for j in m.replies.len() {
                reply_chip(i, m.replies[j])
            }
        }
    }
}
// The strip the reply state machine renders into the read view. Sending is
// an explicit two-step act (发送 opens the confirm card, 确认发送 executes);
// a failed send keeps the draft and offers retry, never silently dropping it.
fn reply_strip(i){
    let m = mails[i]
    if m.reply == "pending" {
        RoundedView{width: Fill height: Fit padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
            draw_bg +: {color: panel border_radius: 14.0 border_size: 1.0 border_color: violetBd} flow: Down spacing: 7
            Label{width: Fill text: "回复草稿 · 待发送" draw_text.color: violetT draw_text.text_style: theme.font_bold{font_size: 12}}
            Label{width: Fill text: first_line(m.reply_text) draw_text.color: ink55 draw_text.text_style.font_size: 11}
            View{width: Fill height: Fit flow: Right spacing: 8
                ButtonFlat{width: Fill text: "发送" on_click: || ask_send(i)
                    draw_bg +: {g1: violet g2: #x6a35e8 color_hover: violet color_down: #x6a35e8 border_radius: 10.0 border_size: 0.0}
                    draw_text +: {color: #xffffffff}}
                ButtonFlat{width: Fill text: "继续编辑" on_click: || edit_draft(i)
                    draw_bg +: {color: #x00000000 color_hover: white7 color_down: white7 border_radius: 10.0 border_size: 1.0 border_color: line2}
                    draw_text +: {color: ink55}}
            }
        }
    }
    if m.reply == "confirm" {
        RoundedView{width: Fill height: Fit padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
            draw_bg +: {color: amberBg border_radius: 14.0 border_size: 1.0 border_color: amber} flow: Down spacing: 7
            Label{width: Fill text: "确认发送给 " + m.sender + "?" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 12}}
            Label{width: Fill text: "发送后写入会话,不可自动撤回(练习数据)。" draw_text.color: ink55 draw_text.text_style.font_size: 10}
            View{width: Fill height: Fit flow: Right spacing: 8
                ButtonFlat{width: Fill text: "确认发送" on_click: || do_send(i)
                    draw_bg +: {g1: violet g2: #x6a35e8 color_hover: violet color_down: #x6a35e8 border_radius: 10.0 border_size: 0.0}
                    draw_text +: {color: #xffffffff}}
                ButtonFlat{width: Fill text: "取消" on_click: || cancel_send(i)
                    draw_bg +: {color: #x00000000 color_hover: white7 color_down: white7 border_radius: 10.0 border_size: 1.0 border_color: line2}
                    draw_text +: {color: ink55}}
            }
        }
    }
    if m.reply == "sending" {
        RoundedView{width: Fill height: Fit padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
            draw_bg +: {color: panel border_radius: 14.0 border_size: 1.0 border_color: line}
            Label{width: Fill text: "发送中…" draw_text.color: ink55 draw_text.text_style.font_size: 12}
        }
    }
    if m.reply == "sent" {
        RoundedView{width: Fill height: Fit padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
            draw_bg +: {color: mintBg border_radius: 14.0 border_size: 1.0 border_color: #x113a32} flow: Down spacing: 5
            Label{width: Fill text: "已回复 · 刚刚发送,已写入会话" draw_text.color: mintT draw_text.text_style: theme.font_bold{font_size: 12}}
            Label{width: Fill text: first_line(m.reply_text) draw_text.color: ink55 draw_text.text_style.font_size: 11}
        }
    }
    if m.reply == "failed" {
        RoundedView{width: Fill height: Fit padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
            draw_bg +: {color: redBg border_radius: 14.0 border_size: 1.0 border_color: red} flow: Down spacing: 7
            Label{width: Fill text: "发送失败 · 邮件服务无响应" draw_text.color: redT draw_text.text_style: theme.font_bold{font_size: 12}}
            Label{width: Fill text: pick(m.src == "live", "发送失败:" + m.send_error + "。草稿已保留,可重试。", "练习场景:模拟服务中断。草稿已保留,可重试或暂存。") draw_text.color: ink55 draw_text.text_style.font_size: 10}
            View{width: Fill height: Fit flow: Right spacing: 8
                ButtonFlat{width: Fill text: "重试发送" on_click: || retry_send(i)
                    draw_bg +: {g1: violet g2: #x6a35e8 color_hover: violet color_down: #x6a35e8 border_radius: 10.0 border_size: 0.0}
                    draw_text +: {color: #xffffffff}}
                ButtonFlat{width: Fill text: "保留草稿" on_click: || keep_draft(i)
                    draw_bg +: {color: #x00000000 color_hover: white7 color_down: white7 border_radius: 10.0 border_size: 1.0 border_color: line2}
                    draw_text +: {color: ink55}}
            }
        }
    }
}

// The inbox's reader pane: the selected mail fills in place — desktop
// master-detail, no screen push. Nothing selected -> the placeholder.
fn reader_pane(){
    if selected {
        let m = mails[current]
        View{width: Fill height: Fit flow: Down spacing: 12 padding: Inset{top: 12 left: 18 right: 12 bottom: 12}
            View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                Label{width: Fill text: m.cluster + " · " + m.time draw_text.color: ink38 draw_text.text_style.font_size: 9}
                Label{text: "···" draw_text.color: ink38 draw_text.text_style.font_size: 14}
            }
            Label{width: Fill text: m.subject draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}}
            label_row(m)
            View{width: Fill height: Fit flow: Right spacing: 11 align: Align{y: 0.5}
                avatar(m, 42)
                View{width: Fill height: Fit flow: Down spacing: 2
                    Label{width: Fill text: m.sender draw_text.color: ink draw_text.text_style.font_size: 13}
                    Label{width: Fill text: m.address + " → 发给我" draw_text.color: ink38 draw_text.text_style.font_size: 10}
                }
                Label{width: 44 text: m.time draw_text.color: ink38 draw_text.text_style.font_size: 9}
            }
            ai_summary_card(current)
            View{width: Fill height: Fit flow: Down spacing: 8
                for p in m.body.split("\n\n") {
                    if p != "" {
                        Label{width: Fill text: p draw_text.color: #xc0beba draw_text.text_style.font_size: 13}
                    }
                }
            }
            smart_replies(current, m)
            meeting_card(m)
                // the reply-state strip is inlined here — minting it through a
                    // helper fn killed everything minted after it on this stack
                    if m.reply == "pending" {
                        RoundedView{width: Fill height: Fit padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                            draw_bg +: {color: panel border_radius: 14.0 border_size: 1.0 border_color: violetBd} flow: Down spacing: 7
                            Label{width: Fill text: "回复草稿 · 待发送" draw_text.color: violetT draw_text.text_style: theme.font_bold{font_size: 12}}
                            Label{width: Fill text: first_line(m.reply_text) draw_text.color: ink55 draw_text.text_style.font_size: 11}
                            View{width: Fill height: Fit flow: Right spacing: 8
                                ButtonFlat{width: Fill text: "发送" on_click: || ask_send(current)
                                    draw_bg +: {g1: violet g2: #x6a35e8 color_hover: violet color_down: #x6a35e8 border_radius: 10.0 border_size: 0.0}
                                    draw_text +: {color: #xffffffff}}
                                ButtonFlat{width: Fill text: "继续编辑" on_click: || edit_draft(current)
                                    draw_bg +: {color: #x00000000 color_hover: white7 color_down: white7 border_radius: 10.0 border_size: 1.0 border_color: line2}
                                    draw_text +: {color: ink55}}
                            }
                        }
                    }
                    if m.reply == "confirm" {
                        RoundedView{width: Fill height: Fit padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                            draw_bg +: {color: amberBg border_radius: 14.0 border_size: 1.0 border_color: amber} flow: Down spacing: 7
                            Label{width: Fill text: "确认发送给 " + m.sender + "?" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 12}}
                            Label{width: Fill text: "发送后写入会话,不可自动撤回(练习数据)。" draw_text.color: ink55 draw_text.text_style.font_size: 10}
                            View{width: Fill height: Fit flow: Right spacing: 8
                                ButtonFlat{width: Fill text: "确认发送" on_click: || do_send(current)
                                    draw_bg +: {g1: violet g2: #x6a35e8 color_hover: violet color_down: #x6a35e8 border_radius: 10.0 border_size: 0.0}
                                    draw_text +: {color: #xffffffff}}
                                ButtonFlat{width: Fill text: "取消" on_click: || cancel_send(current)
                                    draw_bg +: {color: #x00000000 color_hover: white7 color_down: white7 border_radius: 10.0 border_size: 1.0 border_color: line2}
                                    draw_text +: {color: ink55}}
                            }
                        }
                    }
                    if m.reply == "sending" {
                        RoundedView{width: Fill height: Fit padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                            draw_bg +: {color: panel border_radius: 14.0 border_size: 1.0 border_color: line}
                            Label{width: Fill text: "发送中…" draw_text.color: ink55 draw_text.text_style.font_size: 12}
                        }
                    }
                    if m.reply == "sent" {
                        RoundedView{width: Fill height: Fit padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                            draw_bg +: {color: mintBg border_radius: 14.0 border_size: 1.0 border_color: #x113a32} flow: Down spacing: 5
                            Label{width: Fill text: "已回复 · 刚刚发送,已写入会话" draw_text.color: mintT draw_text.text_style: theme.font_bold{font_size: 12}}
                            Label{width: Fill text: first_line(m.reply_text) draw_text.color: ink55 draw_text.text_style.font_size: 11}
                        }
                    }
                    if m.reply == "failed" {
                        RoundedView{width: Fill height: Fit padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                            draw_bg +: {color: redBg border_radius: 14.0 border_size: 1.0 border_color: red} flow: Down spacing: 7
                            Label{width: Fill text: "发送失败 · 邮件服务无响应" draw_text.color: redT draw_text.text_style: theme.font_bold{font_size: 12}}
                            Label{width: Fill text: pick(m.src == "live", "发送失败:" + m.send_error + "。草稿已保留,可重试。", "练习场景:模拟服务中断。草稿已保留,可重试或暂存。") draw_text.color: ink55 draw_text.text_style.font_size: 10}
                            View{width: Fill height: Fit flow: Right spacing: 8
                                ButtonFlat{width: Fill text: "重试发送" on_click: || retry_send(current)
                                    draw_bg +: {g1: violet g2: #x6a35e8 color_hover: violet color_down: #x6a35e8 border_radius: 10.0 border_size: 0.0}
                                    draw_text +: {color: #xffffffff}}
                                ButtonFlat{width: Fill text: "保留草稿" on_click: || keep_draft(current)
                                    draw_bg +: {color: #x00000000 color_hover: white7 color_down: white7 border_radius: 10.0 border_size: 1.0 border_color: line2}
                                    draw_text +: {color: ink55}}
                            }
                        }
                    }
    
            View{width: Fill height: Fit flow: Right spacing: 8
                ButtonFlat{width: Fill text: "回复" on_click: || open_reply()
                    draw_bg +: {g1: violet g2: #x6a35e8 color_hover: violet color_down: #x6a35e8 border_radius: 9.0 border_size: 0.0}
                    draw_text +: {color: #xffffffff}}
                ButtonFlat{width: Fill text: "✦ AI 帮我回" on_click: || open_reply()
                    draw_bg +: {color: #x00000000 color_hover: white7 color_down: white7 border_radius: 9.0 border_size: 1.0 border_color: line2}
                    draw_text +: {color: violetT}}
                ButtonFlat{text: "转发" on_click: || open_forward()
                    draw_bg +: {color: #x00000000 color_hover: white7 color_down: white7 border_radius: 9.0 border_size: 1.0 border_color: line2}
                    draw_text +: {color: ink55}}
            }
        }
    } else {
        preview_pane()
    }
}

// ---- view 3: AI 写信 ----------------------------------------------------------
fn set_tone(t){ tone = t; ui.body.render() }
// The local template keeps the app fully usable when no model answers.
fn local_draft(){
    let ask = draft_input
    if ask == "" { ask = "一封通用商务邮件" }
    draft_text = "(草稿 · " + tone + ")\n\n你好:\n\n关于「" + ask + "」,说明如下:本次沟通意在同步进展并确认下一步安排。如有疑问,欢迎随时回复讨论。\n\n顺祝商祺。"
}
fn regen(){
    let ask = draft_input
    if ask == "" { ask = "一封通用商务邮件" }
    draft_status = "asking"
    draft_error = ""
    ui.body.render()
    host.request("model.complete", {
        task: "按给定语气为一封中文邮件起草简短回复,只输出邮件正文,不编造事实。"
        input: {subject: mails[current].subject sender: mails[current].sender ask: ask tone: tone}
        schema: {type: "object" required: ["body"] additionalProperties: false
                 properties: {body: {type: "string" maxLength: 400}}}
        class: "fast"
    }, fn(r){
        if !r.is_ok {
            draft_status = "unavailable"
            draft_error = r.error
            local_draft()
            ui.body.render()
            return
        }
        draft_text = r.data.output.body
        draft_status = "ai"
        ui.body.render()
    })
}
fn insert_draft(){
    if draft_text == "" { regen() }
    mails[current].reply_text = draft_text
    mails[current].reply = "pending"
    go("read")
}
fn draft_pill_text(){
    if draft_status == "asking" { return "生成中…" }
    if draft_status == "ai" { return "模型生成" }
    if draft_status == "unavailable" { return "本地模板·服务不可用" }
    return "本地模板"
}
fn tone_chip(t){
    ButtonFlat{height: 28 padding: Inset{left: 10 right: 10} text: t on_click: || set_tone(t)
        draw_bg +: {color: pick(t == tone, #x1c1440, #x00000000) color_hover: white7 color_down: white7 border_radius: 7.0 border_size: 1.0 border_color: pick(t == tone, violet, #x00000000)}
        draw_text +: {color: pick(t == tone, #xd6c8ff, ink45)}}
}
fn write_screen(){
    View{width: Fill height: Fit flow: Right
        View{width: Fill height: 1}
        View{width: 720 height: Fit flow: Down spacing: 12
        top_bar()
        Label{width: Fill text: compose_target() draw_text.color: ink45 draw_text.text_style.font_size: 11}
        RoundedView{width: Fill height: Fit draw_bg +: {color: panel border_radius: 16.0 border_size: 1.0 border_color: line}
            View{width: Fill height: Fit flow: Down
                View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5} padding: Inset{top: 10 bottom: 10 left: 14 right: 14}
                    Label{width: 40 text: "收件人" draw_text.color: ink38 draw_text.text_style.font_size: 10}
                    RoundedView{width: Fit height: Fit padding: Inset{top: 3 bottom: 3 left: 6 right: 10}
                        draw_bg +: {color: #x140e2c border_radius: 11.0 border_size: 1.0 border_color: violetBd}
                        View{width: Fit height: Fit flow: Right spacing: 6 align: Align{y: 0.5}
                            avatar(mails[current], 18)
                            Label{text: mails[current].sender draw_text.color: ink draw_text.text_style.font_size: 11}
                        }
                    }
                }
                View{width: Fill height: 1 draw_bg.color: line}
                View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5} padding: Inset{top: 10 bottom: 10 left: 14 right: 14}
                    Label{width: 40 text: "主题" draw_text.color: ink38 draw_text.text_style.font_size: 10}
                    Label{width: Fill text: compose_subject() draw_text.color: #xcecbc6 draw_text.text_style.font_size: 12}
                }
                View{width: Fill height: 1 draw_bg.color: line}
                View{width: Fill height: Fit flow: Right spacing: 5 padding: Inset{top: 8 bottom: 8 left: 14 right: 14}
                    Label{text: "✦" draw_text.color: violetT draw_text.text_style.font_size: 10}
                    tone_chip("专业")
                    tone_chip("友好")
                    tone_chip("简洁")
                    tone_chip("有说服力")
                    Label{text: "已引用原始邮件" draw_text.color: cyanT draw_text.text_style.font_size: 9}
                    View{width: Fill height: 1}
                }
                View{width: Fill height: 1 draw_bg.color: line}
                View{width: Fill height: Fit flow: Down spacing: 10 padding: Inset{top: 16 bottom: 12 left: 14 right: 14}
                    RoundedView{width: Fill height: Fit padding: Inset{top: 14 bottom: 12 left: 12 right: 12}
                        draw_bg +: {color: #x0f0c22 border_radius: 12.0 border_size: 1.0 border_color: violetBd} flow: Down spacing: 9
                        View{width: Fill height: Fit flow: Right spacing: 7 align: Align{y: 0.5}
                            Label{text: "✦" draw_text.color: violetT draw_text.text_style.font_size: 10}
                            Label{text: "AI 草稿 · 语气:" + tone draw_text.color: violetT draw_text.text_style.font_size: 10}
                            RoundedView{width: Fit height: Fit padding: Inset{top: 2 bottom: 2 left: 7 right: 7}
                                draw_bg +: {color: #x140e2c border_radius: 9.0 border_size: 1.0 border_color: violetBd}
                                Label{text: draft_pill_text() draw_text.color: violetT draw_text.text_style.font_size: 9}}
                            View{width: Fill height: 1}
                        }
                        if draft_text == "" {
                            Label{width: Fill text: "在下方描述你想表达的内容,点「生成草稿」让模型起草。" draw_text.color: ink45 draw_text.text_style.font_size: 11}
                        }
                        RoundedView{width: Fill height: Fit draw_bg +: {color: panel2 border_radius: 10.0 border_size: 1.0 border_color: line}
                            TextInput{width: Fill height: 110 text: draft_text empty_text: "草稿会出现在这里…" on_change: |t| draft_text = t
                                draw_bg +: {color: #x00000000 color_hover: #x00000000 color_focus: #x00000000 border_radius: 10.0}
                                draw_text +: {color: #xcecbc6 color_hover: #xcecbc6 color_focus: #xcecbc6 color_empty: ink38 color_empty_hover: ink38}}
                        }
                        View{width: Fill height: Fit flow: Right spacing: 8
                            ButtonFlat{height: 28 text: "✓ 采用草稿" on_click: || insert_draft()
                                draw_bg +: {color: #x1c1440 color_hover: #x251a52 color_down: #x1c1440 border_radius: 7.0 border_size: 1.0 border_color: violet}
                                draw_text +: {color: #xd6c8ff text_style.font_size: 10}}
                            ButtonFlat{height: 28 text: "↻ 重新生成" on_click: || regen()
                                draw_bg +: {color: #x00000000 color_hover: white7 color_down: white7 border_radius: 7.0 border_size: 1.0 border_color: line2}
                                draw_text +: {color: ink55 text_style.font_size: 10}}
                        }
                        if draft_status == "unavailable" {
                            Label{width: Fill text: "模型服务不可用,已回退本地模板:" + draft_error draw_text.color: redT draw_text.text_style.font_size: 9}
                        }
                    }
                }
                View{width: Fill height: 1 draw_bg.color: line}
                View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5} padding: Inset{top: 10 bottom: 10 left: 14 right: 14}
                    ButtonFlat{height: 34 text: "发送 →" on_click: || insert_draft()
                        draw_bg +: {g1: violet g2: #x6a35e8 color_hover: violet color_down: #x6a35e8 border_radius: 9.0 border_size: 0.0}
                        draw_text +: {color: #xffffffff}}
                    ButtonFlat{height: 34 text: "附件" on_click: || regen()
                        draw_bg +: {color: #x00000000 color_hover: white7 color_down: white7 border_radius: 9.0 border_size: 1.0 border_color: line2}
                        draw_text +: {color: ink38 text_style.font_size: 10}}
                    Label{text: "草稿已自动保存 · 09:47" draw_text.color: ink32 draw_text.text_style.font_size: 9}
                    View{width: Fill height: 1}
                }
            }
        }
        RoundedView{width: Fill height: Fit padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
            draw_bg +: {color: panel border_radius: 14.0 border_size: 1.0 border_color: line} flow: Down spacing: 9
            Label{width: Fill text: "描述你想表达的内容" draw_text.color: ink32 draw_text.text_style.font_size: 9}
            RoundedView{width: Fill height: Fit draw_bg +: {color: panel2 border_radius: 10.0 border_size: 1.0 border_color: line}
                TextInput{width: Fill height: 44 empty_text: "告诉 AI 你想表达什么…" on_change: |t| draft_input = t
                    draw_bg +: {color: #x00000000 color_hover: #x00000000 color_focus: #x00000000 border_radius: 10.0}
                    draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: ink38 color_empty_hover: ink38}}
            }
            View{width: Fill height: Fit flow: Right spacing: 8
                chip("GPT-VIBE 4", "violet")
                ButtonFlat{width: Fill height: 34 text: "生成草稿" on_click: || regen()
                    draw_bg +: {g1: violet g2: cyan color_hover: violet color_down: cyan border_radius: 8.0 border_size: 0.0}
                    draw_text +: {color: #xffffffff}}
            }
            Label{width: Fill text: "试试这样开始:跟进上周的报价 · 婉拒一个会议邀请 · 请求延期交付" draw_text.color: ink45 draw_text.text_style.font_size: 10}
        }
        if mail_src == "practice" {
            View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                ButtonFlat{height: 24 text: pick(simulate_outage, "已开启", "已关闭") on_click: || toggle_outage()
                    draw_bg +: {color: pick(simulate_outage, violet, white7) color_hover: white7 color_down: white7 border_radius: 12.0 border_size: 0.0}
                    draw_text +: {color: pick(simulate_outage, #xffffffff, ink55) text_style.font_size: 9}}
                Label{width: Fill text: "练习场景 · 模拟邮件服务中断(发送将失败,可重试)" draw_text.color: ink45 draw_text.text_style.font_size: 10}
            }
        }
        }
        View{width: Fill height: 1}
    }
}

// ---- view 4: Agent 小队 --------------------------------------------------------
fn approve_act(i){ acts[i].handled = true; ui.body.render() }
fn stat_cell(label, value, color){
    RoundedView{width: Fill height: Fit padding: Inset{top: 12 bottom: 12 left: 12 right: 12}
        draw_bg +: {color: panel border_radius: 14.0 border_size: 1.0 border_color: line} flow: Down spacing: 7
        Label{width: Fill text: label draw_text.color: ink32 draw_text.text_style.font_size: 8}
        Label{text: value draw_text.color: color draw_text.text_style: theme.font_bold{font_size: 24}}
    }
}
fn agent_card(i){
    let a = agents[i]
    RoundedView{width: Fill height: Fit padding: Inset{top: 13 bottom: 13 left: 13 right: 13}
        draw_bg +: {color: panel border_radius: 16.0 border_size: 1.0 border_color: line} flow: Down spacing: 8
        View{width: Fill height: Fit flow: Right spacing: 10 align: Align{y: 0.5}
            RoundedView{width: 36 height: 36 draw_bg +: {color: panel2 border_radius: 12.0 border_size: 1.0 border_color: a.color} align: Align{x: 0.5 y: 0.5}
                Label{text: a.glyph draw_text.color: a.color draw_text.text_style.font_size: 15}
            }
            View{width: Fill height: Fit flow: Down spacing: 1
                View{width: Fill height: Fit flow: Right spacing: 6 align: Align{y: 0.5}
                    Label{width: Fill text: a.name draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 13}}
                    Label{width: 30 text: a.status draw_text.color: pick(a.status == "运行中", mintT, amberT) draw_text.text_style.font_size: 8}
                }
                Label{width: Fill text: a.en draw_text.color: ink32 draw_text.text_style.font_size: 8}
            }
            RoundedView{width: 30 height: 16 draw_bg +: {color: pick(a.on, violet, white7) border_radius: 8.0} align: Align{x: pick(a.on, 1.0, 0.25) y: 0.5}
                RoundedView{width: 12 height: 12 draw_bg +: {color: #xffffffff border_radius: 6.0}}
            }
        }
        Label{width: Fill text: a.desc draw_text.color: ink55 draw_text.text_style.font_size: 10}
        View{width: Fill height: 1 draw_bg.color: line}
        View{width: Fill height: Fit flow: Right spacing: 8
            Label{text: a.stat draw_text.color: ink38 draw_text.text_style.font_size: 9}
            Label{text: a.today draw_text.color: a.color draw_text.text_style.font_size: 9}
            View{width: Fill height: 1}
        }
    }
}
fn act_row(i){
    let a = acts[i]
    View{width: Fill height: Fit
        View{width: Fill height: Fit flow: Down spacing: 5 padding: Inset{top: 11 bottom: 11 left: 14 right: 14}
            View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                Label{width: 36 text: a.time draw_text.color: ink38 draw_text.text_style.font_size: 9}
                Label{width: Fill text: a.agent draw_text.color: violetT draw_text.text_style.font_size: 9}
                if a.status == "running" {
                    RoundedView{width: 58 height: Fit padding: Inset{top: 1 bottom: 1 left: 5 right: 5}
                        draw_bg +: {color: cyanBg border_radius: 5.0 border_size: 1.0 border_color: cyan}
                        Label{text: "RUNNING" draw_text.color: cyanT draw_text.text_style.font_size: 8}}
                }
                if a.status == "done" {
                    Label{width: 44 text: "✓ DONE" draw_text.color: mintT draw_text.text_style.font_size: 8}
                }
                if a.status == "approval" {
                    if a.handled {
                        Label{width: 36 text: "已处理" draw_text.color: mintT draw_text.text_style.font_size: 8}
                    } else {
                        Label{width: 36 text: "需审批" draw_text.color: amberT draw_text.text_style.font_size: 8}
                    }
                }
            }
            Label{width: Fill text: a.text draw_text.color: #xb7b5b1 draw_text.text_style.font_size: 11}
            if a.status == "approval" {
                if !a.handled {
                    View{width: Fill height: Fit flow: Right spacing: 6
                        ButtonFlat{height: 26 text: "✓ 批准" on_click: || approve_act(i)
                            draw_bg +: {color: mintBg color_hover: #x0d2521 color_down: mintBg border_radius: 7.0 border_size: 1.0 border_color: mint}
                            draw_text +: {color: mintT text_style.font_size: 10}}
                        ButtonFlat{height: 26 text: "✕ 忽略" on_click: || approve_act(i)
                            draw_bg +: {color: #x00000000 color_hover: redBg color_down: redBg border_radius: 7.0 border_size: 1.0 border_color: line2}
                            draw_text +: {color: ink45 text_style.font_size: 10}}
                    }
                }
            }
        }
        View{width: Fill height: 1 draw_bg.color: line}
    }
}
fn agents_screen(){
    View{width: Fill height: Fit flow: Right
        View{width: Fill height: 1}
        View{width: 800 height: Fit flow: Down spacing: 10
        top_bar()
        View{width: Fill height: Fit flow: Right spacing: 8
            stat_cell("运行中的 AGENT", "4", violetT)
            stat_cell("今日已完成任务", "12", mintT)
        }
        View{width: Fill height: Fit flow: Right spacing: 8
            stat_cell("本周节省时间", "3.2h", cyanT)
            stat_cell("待你审批", "2", amberT)
        }
        View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5} padding: Inset{left: 2 right: 2}
            Label{text: "我的 AGENT 小队" draw_text.color: ink32 draw_text.text_style.font_size: 9}
            Label{text: "SQUAD · 4 UNITS" draw_text.color: ink32 draw_text.text_style.font_size: 8}
            View{width: Fill height: 1}
        }
        for i in agents.len() { agent_card(i) }
        RoundedView{width: Fill height: Fit padding: Inset{top: 13 bottom: 13 left: 14 right: 14}
            draw_bg +: {color: panel border_radius: 16.0 border_size: 1.0 border_color: line} flow: Down spacing: 10
            View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                Label{text: "自动化程度" draw_text.color: ink32 draw_text.text_style.font_size: 9}
                Label{text: "SEMI-AUTO" draw_text.color: violetT draw_text.text_style.font_size: 8}
                View{width: Fill height: 1}
            }
            View{width: Fill height: Fit flow: Overlay
                RoundedView{width: Fill height: 4 draw_bg +: {color: white7 border_radius: 2.0}}
                RoundedView{width: 200 height: 4 draw_bg +: {g1: violet g2: cyan border_radius: 2.0}}
                View{width: Fill height: 4 align: Align{x: 0.58 y: 0.5}
                    RoundedView{width: 14 height: 14 draw_bg +: {color: #xffffffff border_radius: 7.0}}
                }
            }
            View{width: Fill height: Fit flow: Right spacing: 6
                // adjacent labels + trailing spacer, sized to fit the 412px
                // column (40+16+168+16+32 + spacing fits 328 with room)
                Label{width: 40 text: "仅建议" draw_text.color: ink32 draw_text.text_style.font_size: 8}
                View{width: 16 height: 1}
                Label{width: 168 text: "半自动 · 关键动作需审批" draw_text.color: violetT draw_text.text_style.font_size: 8}
                View{width: 16 height: 1}
                Label{width: 32 text: "全自动" draw_text.color: ink32 draw_text.text_style.font_size: 8}
                View{width: Fill height: 1}
            }
        }
        View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5} padding: Inset{left: 2 right: 2}
            Label{text: "实时活动流" draw_text.color: ink32 draw_text.text_style.font_size: 9}
            Label{text: "● LIVE" draw_text.color: mintT draw_text.text_style.font_size: 8}
            View{width: Fill height: 1}
        }
        RoundedView{width: Fill height: Fit draw_bg +: {color: panel border_radius: 16.0 border_size: 1.0 border_color: line}
            View{width: Fill height: Fit flow: Down
                for i in acts.len() { act_row(i) }
            }
        }
        RoundedView{width: Fill height: Fit padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
            draw_bg +: {color: panel border_radius: 14.0 border_size: 1.0 border_color: line} flow: Down spacing: 5
            Label{width: Fill text: "概念演示" draw_text.color: redT draw_text.text_style: theme.font_bold{font_size: 12}}
            Label{width: Fill text: "数据口径:真实邮件经平台 mail 宿主服务收发(账号由宿主登录面板添加,凭据存宿主侧,不经过应用);无该服务的环境(如 card-host)如实显示不可用并回退练习数据。AI 摘要与起草调用 model 一次性模型服务,不可用回退本地模板。Agent 小队与活动流为练习数据。" draw_text.color: ink45 draw_text.text_style.font_size: 10}
        }
        }
        View{width: Fill height: 1}
    }
}

// ---- left rail -------------------------------------------------------------
// Desktop navigation: a fixed glass rail (logo, glyph tiles with badges,
// live-agent dot at the bottom). Glyph tiles are native widgets — runtime
// SVG rasterises blank in this stack, CJK glyphs never do.
fn rail_tab(label, glyph, target, badge){
    GestureView{width: Fill height: 64 on_tap: |x, y| go(target)
        View{width: Fill height: Fill flow: Overlay
            RoundedView{width: Fill height: Fill draw_bg +: {color: pick(screen == target, #x120b26, #x00000000) border_radius: 15.0 border_size: 1.0 border_color: pick(screen == target, #x241640, #x00000000)}
                View{width: Fill height: Fill flow: Down spacing: 4 align: Align{x: 0.5 y: 0.5}
                    View{width: Fit height: Fit flow: Overlay
                        RoundedView{width: 40 height: 40 draw_bg +: {color: pick(screen == target, violetBg, #x0e1322) border_radius: 13.0 border_size: 1.0 border_color: pick(screen == target, violet, line2)} align: Align{x: 0.5 y: 0.5}
                            Label{text: glyph draw_text.color: pick(screen == target, violetHi, ink55) draw_text.text_style.font_size: 15}}
                        if badge != "" {
                            View{width: Fill height: Fill align: Align{x: 1.0 y: 0.0}
                                RoundedView{width: 16 height: 16 draw_bg +: {color: cyan border_radius: 8.0 border_size: 2.0 border_color: glass} align: Align{x: 0.5 y: 0.5}
                                    Label{text: badge draw_text.color: #x052027 draw_text.text_style: theme.font_bold{font_size: 8}}
                                }
                            }
                        }
                    }
                    Label{text: label draw_text.color: pick(screen == target, violetHi, ink66) draw_text.text_style.font_size: 8}
                }
            }
        }
    }
}
fn rail(){
    View{width: 78 height: Fill flow: Down spacing: 6 align: Align{x: 0.5} padding: Inset{top: 16 bottom: 16 left: 9 right: 9} draw_bg.color: glass
        vibe_mark(34)
        View{width: 26 height: 22 draw_bg.color: #x1d1d33}
        rail_tab("收件箱", "收", "inbox", "" + cnt("all"))
        rail_tab("写信", "写", "write", "")
        rail_tab("Agent", "队", "agents", "" + agents.len())
        View{width: 1 height: Fill}
        View{width: Fit height: Fit flow: Overlay
            RoundedView{width: 34 height: 34 draw_bg +: {g1: violet g2: cyan border_radius: 17.0} align: Align{x: 0.5 y: 0.5}
                Label{text: "林" draw_text.color: #xffffffff draw_text.text_style: theme.font_bold{font_size: 14}}}
            View{width: Fill height: Fill align: Align{x: 1.0 y: 1.0}
                RoundedView{width: 11 height: 11 draw_bg +: {color: mint border_radius: 6.0 border_size: 2.0 border_color: glass} align: Align{x: 0.5 y: 0.5}}
            }
        }
        Label{text: "在线" draw_text.color: mintT draw_text.text_style.font_size: 8}
    }
}

// ---- root ------------------------------------------------------------------
SolidView{width: Fill height: Fill flow: Overlay draw_bg.color: space
    View{width: Fill height: Fill flow: Down
        View{width: Fill height: Fit flow: Right spacing: 0
            RoundedView{width: 240 height: 240 draw_bg +: {color: #x1a0f38 border_radius: 120.0}}
            View{width: Fill height: 1}
            RoundedView{width: 160 height: 160 draw_bg +: {color: #x141132 border_radius: 80.0}}
        }
        View{width: Fill height: Fill flow: Right align: Align{y: 1.0}
            View{width: Fill height: 1}
            RoundedView{width: 260 height: 200 draw_bg +: {color: #x0a1c26 border_radius: 100.0}}
        }
    }
    View{width: Fill height: Fill flow: Right
        rail()
        View{width: 1 height: Fill draw_bg.color: #x1c1e33}
        body := ScrollYView{width: Fill height: Fill flow: Down padding: Inset{top: 14 bottom: 16 left: 16 right: 16} spacing: 0 on_render: || {
            if screen == "inbox" { inbox_screen() }
            if screen == "write" { write_screen() }
            if screen == "agents" { agents_screen() }
        }}
    }
}
