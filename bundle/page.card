# ledger agentic-mail@0.1.0
# level:   L0
# profile: ui/l0
#
# Agentic Mail — an agent-summarised inbox digest card. All data is
# host-resolved mock data (page.data.json); the card is presentation only
# and declares no capabilities. The source carries no query selector, so
# the lowering keeps the seeded literals the offline checked VM can
# evaluate. Per Addendum #3 every user-visible string is Simplified
# Chinese: the vocabulary entries fill BOTH locale slots with the same
# Chinese text, so the card renders Chinese regardless of host locale.

source digest sys.news_digest(count: 3,
                               fields: [id, title, summary, publisher, published_at])

copy brand    { class: vocabulary, en: "智能邮件", zh: "智能邮件" }
copy masthead { class: vocabulary, en: "收件箱摘要", zh: "收件箱摘要" }
copy ai_note  { class: vocabulary, en: "由智能助手摘要生成", zh: "由智能助手摘要生成" }

view root Surface(pad: .page) {
  header
  list
  footnote
}

view header Col(gap: 4) {
  TextEyebrow(text: copy.brand)
  TextTitle(text: copy.masthead)
}

view list Col(gap: 4) {
  Panel {
    for m in digest key m.id {
      Card {
        TextRow(text: m.title, width: .fill)
        TextCaption(text: m.publisher)
        TextBody(text: m.summary, width: .fill)
        TextCaption(text: m.published_at)
      }
    }
  }
}

view footnote Row(gap: 6) {
  TextCaption(text: copy.ai_note)
}
