{
  "schema_version": 1,
  "app": "vibemail",
  "runner": "python scripts/run_routes.py <port>",
  "notes": [
    "Declarative click-through routes over the Makepad remote bridge, in the",
    "spirit of the OctoScript-App-Design-Flow examples' route_test.json: the",
    "routes name WHAT must happen, the runner owns HOW (scroll reachability,",
    "dropped-click retries, frame settle).",
    "Routes run sequentially against ONE running instance (412x860 phone",
    "layout); later routes build on earlier state. Every step's texts were",
    "proven against the shipped bundle (scripts/dbg_walk.py, dbg_flow.py).",
    "card-host registers the reference mail service but has no account, so",
    "boot asserts the honest no-account banner; no model service answers, so",
    "practice summaries stay labelled 练习摘要."
  ],
  "boot": {
    "wait_for": "未读邮件",
    "asserts": ["全部", "专注"],
    "practice_banner_any": ["未添加邮箱账号", "邮件服务不可用"]
  },
  "routes": [
    {
      "name": "vibe-filter-and-detail",
      "desc": "vibe chips 是真实筛选;详情卡有 AI 三行摘要与光环;星标可切换",
      "steps": [
        {
          "tap": "专注",
          "exact": true,
          "expect": "已按 vibe 筛选:专注",
          "absent": ["周末去海边"]
        },
        { "tap": "全部", "exact": true, "expect": "周末去海边" },
        {
          "tap": "周末去海边",
          "expect": "mira@octomail.io",
          "asserts": ["AI 三行摘要", "练习摘要", "需要你回复选择哪一班火车"]
        },
        { "tap": "星标", "exact": true, "expect": "已星标" },
        { "tap": "收件箱", "exact": true, "expect": "未读邮件" }
      ]
    },
    {
      "name": "orbit-open-and-theme",
      "desc": "星轨气泡点按直达详情;设置页三态主题与能力声明",
      "steps": [
        { "tap": "星轨", "exact": true, "expect": "气泡大小" },
        { "tap": "外婆", "expect": "院子里的桂花开了", "asserts": ["grandma@family.mail"] },
        { "tap": "收件箱", "exact": true, "expect": "未读邮件" },
        { "tap": "我的", "exact": true, "expect": "外观主题" },
        { "tap": "暗色", "exact": true, "expect": "当前:炭黑暗色" },
        { "tap": "亮色", "exact": true, "expect": "当前:暖纸亮色" },
        { "tap": "收件箱", "exact": true, "expect": "未读邮件" }
      ]
    },
    {
      "name": "tone-slider-rewrite",
      "desc": "语气滑杆三档实时改写回信预览(练习数据内置三种语气)",
      "steps": [
        { "tap": "写信", "exact": true, "expect": "语气滑杆" },
        { "tap": "正式", "exact": true, "expect": "正式得体", "asserts": ["Mira 你好,感谢安排"] },
        { "tap": "真诚", "exact": true, "expect": "真诚随意", "asserts": ["玻璃小屋也太棒了吧"] },
        { "tap": "友好", "exact": true, "expect": "自然友好" }
      ]
    },
    {
      "name": "send-happy-single-tap",
      "desc": "详情回复预填写信;单击发送 -> 已随波寄出;收件箱出现已回复胶囊",
      "steps": [
        { "tap": "收件箱", "exact": true, "expect": "未读邮件" },
        { "tap": "周末去海边", "expect": "mira@octomail.io" },
        { "tap": "回复", "exact": true, "expect": "语气滑杆" },
        { "tap": "发送", "exact": true, "expect": "已随波寄出" },
        { "tap": "收件箱", "exact": true, "expect": "未读邮件" },
        { "asserts": ["已回复"] }
      ]
    },
    {
      "name": "outage-fail-keep-draft-retry",
      "desc": "练习开关模拟发送失败:失败态可重试仍失败;关闭开关后重发成功",
      "steps": [
        { "tap": "我的", "exact": true, "expect": "外观主题" },
        { "tap": "已关闭", "exact": true, "expect": "已开启" },
        { "tap": "收件箱", "exact": true, "expect": "未读邮件" },
        { "tap": "院子里的桂花开了", "expect": "grandma@family.mail" },
        { "tap": "回复", "exact": true, "expect": "语气滑杆" },
        { "tap": "发送", "exact": true, "expect": "发送失败 · 点按重试" },
        { "tap": "我的", "exact": true, "expect": "外观主题" },
        { "tap": "已开启", "exact": true, "expect": "已关闭" },
        { "tap": "收件箱", "exact": true, "expect": "未读邮件" },
        { "asserts": ["发送失败"] },
        { "tap": "院子里的桂花开了", "expect": "grandma@family.mail" },
        { "tap": "回复", "exact": true, "expect": "语气滑杆" },
        { "tap": "发送", "exact": true, "expect": "已随波寄出" }
      ]
    },
    {
      "name": "archive-and-restore",
      "desc": "归档移出列表与星轨;设置里一键恢复",
      "steps": [
        { "tap": "收件箱", "exact": true, "expect": "未读邮件" },
        { "tap": "你关注的仓库本周有 14 个更新", "expect": "noreply@github.com" },
        { "tap": "归档", "exact": true, "expect": "未读邮件", "absent": ["你关注的仓库"] },
        { "tap": "星轨", "exact": true, "expect": "气泡大小", "absent": ["GitHub"] },
        { "tap": "我的", "exact": true, "expect": "外观主题" },
        { "tap": "恢复归档", "expect": "已恢复" },
        { "tap": "收件箱", "exact": true, "expect": "你关注的仓库本周有 14 个更新" }
      ]
    }
  ]
}
